// Reinforcements

reinforce_leet1
reinforce_leet2
reinforce_leet3
{
	spawn
	{
		#if g_ee_skinEliteGuard <= 0
		trigger self* start
		#endif
		
		#if g_ee_skinEliteGuard == 1
		trigger self* skin
		#endif
		
		#if g_ee_skinEliteGuard >= 2
		accum 0 random 2
		trigger self* skin_yes
		trigger self* skin_no
		#endif
	}
		
	trigger skin
	{
		changeaiskin eliteguard/desert1
		
		trigger self* start
	}
		
	trigger skin_yes
	{
		accum 0 abort_if_not_equal 1
		
		trigger self* skin
	}
		
	trigger skin_no
	{
		accum 0 abort_if_not_equal 0
		
		// spawn
		trigger self* start
	}
		
	trigger start
	{
		takeweapon all
		giveweaponfull weapon_mp34 weapon_mp40
		statetype alert
	}

	death
	{
	}
}

