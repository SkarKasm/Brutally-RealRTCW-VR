// Nazi guarding Helga Entrance Hall (Entry after a Zombie dies)

nazi1c
{
	attributes
	{
		fov 120			// Default: 240 Range 1 ? 360
		aim_skill 0.3 		// Default: 0.5 Range: 0.0 ? 1.0 (specific targets)
		aim_accuracy 0.4	// Default: 0.5 Range: 0.0 ? 1.0 (accuracy)
		attack_skill 0.5	// Default: 0.75 Range: 0.0 ? 1.0 (weaponry tactics)
		reaction_time 0.5	// Default: 0.5 Range: 0.0 ? 1.0 (seconds)
		attack_crouch 0.2	// Default: 0.4 Range: 0.0 ? 1.0 (frequency)
		idle_crouch 0.0		// Default: 0.0 Range: 0.0 ? 1.0 (frequency)
		aggression 0.8		// Default: 0.5 Range: 0.0 ? 1.0 (charging)
		tactical 0.2		// Default: 0.8 Range: 0.0 ? 1.0 (protection)
		camper 0.0		// Default: 0.0 Range: 0.0 ? 1.0 (camping abilities)

		alertness 12000		// Default: 16000 Range: 0 ? 999999
		starting_health 35	// Default: 100 Range: 0 ? 99999 (spawn health)
		hearing_scale 1.0	// Default: 1.0 Range: 0.0 ? 10 (hearing)

		inner_detection_radius 512 // Default: 512 (detection of things units)
	}

	spawn
	{
		accum 0 set 0 // has spoken
		accum 1 set 0 // has gone

		setammo ammo_9mm 999
		setammo ammo_grenades 0
		selectweapon weapon_mp40

		statetype alert
	}

	trigger go
	{
		accum 1 abort_if_not_equal 0
		accum 1 set 1

		runtomarker nazi1a_spot1 nostop
		trigger nazi1c speak
		facetargetangles nazi1a_spot2
		runtomarker nazi1a_spot2
		resetscript
	}

	trigger speak
	{
		accum 0 abort_if_not_equal 0
		accum 0 set 1

		playsound MiscGoingOn
	}

	trigger attack
	{
		clearanim
		resetscript
	}

	enemysight
	{
		trigger nazi1c attack
		trigger nazi1a speak
		trigger nazi1a cover
	}

	inspectfriendlycombatstart
	{
		deny
	}

	bulletimpact
	{
		deny
	}

	inspectsoundstart
	{
		deny
	}

	inspectsoundend
	{
		deny
	}

	inspectbodystart
	{
		deny
	}

	inspectbodyend
	{
		deny
	}

	// This will be called when BJ kills me by stabbing me in the back with a knife!
	stealthkill
	{
		dropitem item_health_small
		
		trigger player stealth_achievement
	}

	death
	{
	}
}

