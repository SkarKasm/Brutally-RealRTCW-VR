// Zombie in tunnel

zombie2a
{
	attributes
	{
		fov 240
		starting_health 50
		aggression 1.0
		hearing_scale 1.0
	}

	spawn
	{
		#if g_ee_skinZombie <= 0
		trigger self* start
		#endif
		
		#if g_ee_skinZombie == 1
		trigger self* skin
		#endif
		
		#if g_ee_skinZombie >= 2
		accum 0 random 2
		trigger self* skin_yes
		trigger self* skin_no
		#endif
	}
		
	trigger skin
	{
		changeaiskin zombie/mummy1
		changeaihead mummy1
		
		trigger self* start
	}
		
	trigger skin_yes
	{
		accum 0 abort_if_not_equal 1
		
		trigger self* skin
	}
		
	trigger skin_no
	{
		accum 0 abort_if_not_equal 0
		
		// spawn
		trigger self* start
	}
		
	trigger start
	{
		takeweapon MonsterAttack2
		wait forever 0
	}

	bulletimpact
	{
		deny
	}

	inspectsoundstart
	{
		deny
	}

	inspectsoundend
	{
		deny
	}

	inspectbodystart
	{
		deny
	}

	inspectbodyend
	{
		deny
	}

	trigger 180
	{
		facetargetangles zombie2a_180
		resetscript
	}

	trigger 360
	{
		facetargetangles zombie2a_360
		// cause player would have to be close enough to see or sense
		resetscript
	}

	death
	{
		trigger player z2a_check
	}

	enemysight
	{
		resetscript
	}
}

