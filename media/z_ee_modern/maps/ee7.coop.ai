		trigger self* skin_no
		#endif
	}
		
	trigger skin
	{
		changeaiskin eliteguard/desert1
		changeaihead desert4
		
		trigger self* start
	}
		
	trigger skin_yes
	{
		accum 0 abort_if_not_equal 1
		
		trigger self* skin
	}
		
	trigger skin_no
	{
		accum 0 abort_if_not_equal 0
		
		// spawn
		trigger self* start
	}
		
	trigger start
	{
		nosight 99999
		godmode on
		knockback off
		trigger leet2 run
	}

	// This will be called when BJ kills me by stabbing me in the back with a knife!
	stealthkill
	{
		dropitem ammo_9mm_small
		
		trigger player stealth_achievement
	}

	trigger run
	{
		wait 100
		nosight 9999
		gotomarker leet2_spot1 nostop
		gotomarker leet2_spot1b nostop
		trigger player closeport
		gotomarker leet2_spot2 nostop
		gotomarker leet2_spot3 nostop
	}
}

