//
//AI Scripting
//Map: ee7
//Last edited by: Scan (2003), William Faure (2026)
// [DONE] - Don't add/change without notice (except cinematics)

// Added a 2sec delay to 'kill_leet' entity in the script. This should allow them to get off camera befor dissapearing -Ren

player
{
	// COOP: level start, run once from game_manager's spawn (maps/ee7.coop.script). It holds what
	// RealRTCW runs for its single player in "spawn", "playerstart" and "trigger playgame".
	trigger coopstart
	{
		globalaccum 0 set 0 // Zombie2a, dead == 1
		globalaccum 1 set 0 // Zombie2b, dead == 1
		globalaccum 2 set 0 // makes sure zombies aren't alerted twice
		globalaccum 3 set 0 // rumble only on first time door opens
		globalaccum 4 bitreset 0 // coffin secret found
		globalaccum 4 bitreset 1 // trap secret found
		globalaccum 5 set 0 // elite guard death count
		globalaccum 6 set 0 // can close gate
		globalaccum 7 set 0 // objectives

		cvar g_episode 1
		objectivesneeded 3
		
		numsecrets 4 // COOP: the PS2 map has a 4th secret ("trap secret"), the co-op authors' vanilla version had 3
		
		//
		
		// Reset movers

		wait 100
		trigger crusher reset2
		wait 5
		trigger lockdown reset
		trigger lift reset

		trigger gate1 fast_up
		trigger gate2 fast_up
		
		//
		
		// set portcullis to open
		trigger portcullis1 fast_up
		
		//

		abort_if_loadgame
		// COOP: no briefing screen, the level music starts at once
		// (SP: l_briefing_1 / l_theme in spawn, then "mu_fade 0 1000" + "mu_queue sound/music/c_chant" in playerstart)
		mu_start sound/music/c_chant
		
		//

		// start player with spookey ambience
		trigger player spawnsounds
	}

	// COOP: every player, on each (re)spawn: RealRTCW's "applyloadout ee7"
	// (loadouts/loadouts_campaign.loadout) written with co-op actions ("setclip ... full" -> max clip)
	spawn
	{
		giveweapon weapon_knife
		
		giveweapon weapon_colt
		setclip weapon_colt 8
		#if g_vanilla_guns <= 0 setammo ammo_45cal 31 #endif
		#if g_vanilla_guns >= 1 setammo ammo_45cal 32 #endif
		
		#if g_newInventory <= 0
		giveweapon weapon_luger
		setclip weapon_luger 8
		giveweapon weapon_mauserrifle
		setclip weapon_mauserrifle 10
		setammo ammo_792mm 8
		#endif
		
		giveweapon weapon_mp40
		setclip weapon_mp40 32
		setammo ammo_9mm 128
		
		setammo ammo_grenades 2
		
		selectweapon weapon_mp40
		
		giveinventory key_binocs
	}

	// COOP: in co-op this runs on every client spawn; the level start is "trigger coopstart"
	playerstart
	{
	}

	// This trigger will be called when the player actually hits the changelevel trigger,
	// AND he has found all the secrets.  Give him a cookie!
	trigger endmap_bonus
	{
		// COOP-OFF (endmap_bonus is never called in co-op): printbonus ee7
	}
	
	trigger checkpoint // Gate
	{
		// COOP-OFF (SP save/bonus): savecheckpoint
		
		#if g_reinforce >= 2 alertentity reinforce_leet2 #endif
	}

///////////////////////////////////////////////////
// Achievements
	
//	trigger achievement1
//	{
//		achievement_eeZombie // Crush the first zombie into the spikes in the Lower Tombs
//	}
	
	trigger achievement2
	{
		// COOP-OFF (SP achievement): achievement_eeLeet // Reach the pyramid room and the Elite Guards having opened only one gate across the level in the Lower Tombs
	}
	
	trigger secrets_achievement
	{
		// COOP-OFF (SP achievement): if fs_ee_ps2_maps <= 0 globalaccum 0 abort_if_not_equal 21 endif
		// COOP-OFF (SP achievement): if fs_ee_ps2_maps >= 1 globalaccum 0 abort_if_not_equal 22 endif
		// COOP-OFF (SP achievement): achievement_eeSecrets // Find all secret areas in the campaign in a single playthrough
	}
	
	trigger game_achievement
	{
		// COOP-OFF (SP achievement): globalaccum 1 abort_if_not_equal 7
		// COOP-OFF (SP achievement): achievement_eeGame // Complete the campaign on any difficulty
	}
	
	trigger skill_achievement
	{
		// COOP-OFF (SP achievement): globalaccum 2 abort_if_not_equal 7
		// COOP-OFF (SP achievement): achievement_eeSkill // Complete the campaign on Death Incarnate or Realism difficulty
	}
	
	trigger stealth_achievement
	{
		// COOP-OFF (SP achievement): globalaccum 3 abort_if_greater_than 5
		// COOP-OFF (SP achievement): globalaccum 3 inc 1
		// COOP-OFF (SP achievement): globalaccum 3 abort_if_not_equal 5
		// COOP-OFF (SP achievement): achievement_eeStealth // Perform 5 rewarded stealth kills in a single playthrough
	}

///////////////////////////////////////////////////
// Secrets

	trigger coffin_secret
	{
		globalaccum 4 abort_if_bitset 0 // globalaccum 4 abort_if_not_equal 0
		globalaccum 4 bitset 0 // globalaccum 4 set 1

		trigger coffin up
	}

	trigger secret_a
	{
		trigger block1 a
	}

	trigger secret_b
	{
		trigger block1 b
	}

	trigger secret_c
	{
		trigger block1 c
	}

	trigger secret_d
	{
		trigger block1 d
	}

	trigger secret1_go
	{
		trigger partwall open
	}

	trigger trap_set
	{
		alertentity fireon
	}

	trigger nrv_secret1
	{
		foundsecret
		
		// COOP-OFF (SP achievement): globalaccum 0 inc 1
		
		trigger player allsecrets
	}

	trigger secret1_go
	{
		wait 5
		trigger partwall open
	}

	trigger secret1
	{
		foundsecret
		
		// COOP-OFF (SP achievement): globalaccum 0 inc 1
		
		trigger player allsecrets
	}

	trigger secret2
	{
		foundsecret
		
		// COOP-OFF (SP achievement): globalaccum 0 inc 1
		
		trigger player allsecrets
	}

//	trigger secret3 // PS2, 'nrv_secret1' on Xbox
//	{
//		#if fs_ee_ps2_maps >= 1 foundsecret #endif
//		
//		globalaccum 0 inc 1
//		
//		trigger player allsecrets
//	}

	trigger secret4 // PS2
	{
		globalaccum 4 abort_if_bitset 1 // globalaccum 7 abort_if_bitset 0
		globalaccum 4 bitset 1 // globalaccum 7 bitset 0
		foundsecret
		
		// COOP-OFF (SP achievement): globalaccum 0 inc 1
		
		trigger player allsecrets
	}

	trigger allsecrets
	{
		trigger player secrets_achievement // Find all secret areas in the campaign in a single playthrough
	}

///////////////////////////////////////////////////
// Traps

	trigger crush_trap
	{
		trigger crusher down
	}

	trigger spring_trap // PS2
	{
		trigger gate1 trap
	}

///////////////////////////////////////////////////
// Ojectives

	// past gate, pursued helga

	trigger obj_1
	{
		objectivemet 1
		
		#if fs_ee_wolf2_sound >= 1 mu_play sound/ui/objective_new4.wav #endif
		
		globalaccum 7 inc 1
		
		trigger game_manager objective1
	}

	trigger obj_2
	{
		objectivemet 2
		
		#if fs_ee_wolf2_sound >= 1 mu_play sound/ui/objective_new4.wav #endif
		
		globalaccum 7 inc 1
		
		trigger game_manager objective2
		
		mu_stop 3000
		wait 1500
		mu_fade 0 500
		mu_queue sound/music/m_drums // PS2-like, edit by William Faure
	}

	trigger obj_2_check
	{
		globalaccum 5 inc 1
		#if g_reinforce <= 0 globalaccum 5 abort_if_not_equal 3 #endif
		#if g_reinforce >= 1 globalaccum 5 abort_if_not_equal 4 #endif

			globalaccum 5 set 0
			trigger player obj_2
	}

	trigger obj_3
	{
		objectivemet 3
		
		#if fs_ee_wolf2_sound >= 1 mu_play sound/ui/objective_new4.wav #endif
		
		globalaccum 7 inc 1
		
		trigger game_manager objective3
	}

/////////////////////////////////////////////
// SECTION 1 - Entrance + Atrium
/////////////////////////////////////////////


// Spawning Ambience

	trigger spawnsounds
	{
		alertentity speak1
		wait 1000
		alertentity speak2
	}

// Zombie in entrance hallway

	trigger action1a
	{
		alertentity zombie1a
		alertentity speak3
	}

// Yelling... from old map area

	trigger zombie_misc_yell
	{
		alertentity zombie_sound_ee6
	}

// Entering Main Atrium, queue Helga exit scenario

	trigger action1b
	{
		alertentity helga_call
		trigger ast helga_call
		wait 100
		alertentity leet1
		alertentity leet2
	//	alertentity zombie1b	// console error fix by William Faure
	//	alertentity zombie1bb	// console error fix by William Faure
		alertentity nazi1c
	}

	trigger closeport
	{
		globalaccum 6 inc 1
		globalaccum 6 abort_if_not_equal 2
		//	wait 50
			trigger portcullis1 toggle
	}

// Portcullis Goes Down

// remed out for a test
	trigger port
	{
	//	trigger portcullis1 toggle
	}

// Event, heading down Helga Entrance hall

	trigger action1c
	{
		alertentity zombie_sound_scare
		wait 5
		alertentity nazi1a
	}

/////////////////////////////////////////////
// SECTION 2 - Second Gate Room
/////////////////////////////////////////////

	trigger toggle_lift
	{
		#if g_realism == 0 wait 50 #endif
		#if g_realism == 1 wait 500 #endif
		trigger lift toggle
	}

	trigger action2_presetup
	{
		// moved back to remove weapon click noise...
		// looks like it not working (must figure out why so loud). ;o
		alertentity nazi1b
		alertentity nazi1bb

		// forget the nonsense and just spawn em, they are culled in the pvs anyway and dont move ;]
		alertentity zombie2a
		alertentity zombie2b
		alertentity zombie2c
		
		#if g_reinforce >= 2 alertentity reinforce_leet1 #endif
	}

	trigger action2_setup
	{
		#if g_reinforce >= 2 alertentity reinforce_bg1 #endif
		
		trigger counter1 conversation1
	}
	trigger action2_madesound
	{
		trigger nazi1b what
	}

	trigger z2a_check
	{
		globalaccum 0 set 1
	}

	trigger z2b_check
	{
		globalaccum 1 set 1
	}

	// Spawn zombies of not already spawned
	trigger action2
	{

	}

	// Spawn zombies of not already spawned
	trigger action2c
	{
		// zombie scare sound
		alertentity speak4
		
		#if g_reinforce >= 2 alertentity reinforce_v1 #endif
	}

	trigger port2rumble
	{
		globalaccum 3 abort_if_not_equal 0
		globalaccum 3 set 1

		alertentity zombie_rumble
		
		trigger game_manager achievement2_fail // Reach the pyramid room and the Elite Guards having opened only one gate across the level in the Lower Tombs
	}


	// Passage a is north (make zombie face your direction)
	trigger action2a
	{
		globalaccum 0 abort_if_not_equal 0
		trigger zombie2a 180
	}

	// Passage b is east (make zombie face your direction)
	trigger action2b
	{
		globalaccum 1 abort_if_not_equal 0
		trigger zombie2b 270
	}

	// Passage a is north:exit side (make zombie face your direction)
	trigger action2aa
	{
		globalaccum 0 abort_if_not_equal 0
		trigger zombie2a 360
	}
	// Passage b is east:exit side (make zombie face your direction)
	trigger action2bb
	{
		globalaccum 1 abort_if_not_equal 0
		trigger zombie2b 90
	}

	// Event after portcullis hall exit

	trigger action2d
	{
		alertentity nazi2a
	}

