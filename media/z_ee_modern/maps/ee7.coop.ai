reinforce_zombie1
reinforce_zombie2
{
	attributes
	{
		fov 240
		starting_health 400 // 65
		aggression 1.0
		aim_accuracy 1.0
		hearing_scale 1.0
		tactical 0.0
	}

	spawn
	{
		#if g_ee_skinZombie <= 0
		trigger self* start
		#endif
		
		#if g_ee_skinZombie == 1
		trigger self* skin
		#endif
		
		#if g_ee_skinZombie >= 2
		accum 0 random 2
		trigger self* skin_yes
		trigger self* skin_no
		#endif
	}
		
	trigger skin_yes
	{
		accum 0 abort_if_not_equal 1
		
		trigger self* skin
	}
		
	trigger skin_no
	{
		accum 0 abort_if_not_equal 0
		
		// spawn
		trigger self* start
	}
	
	trigger skin
	{
		changeaihead mummy1
		
		accum 0 random 2
		trigger self* skin1
		trigger self* skin2
	}
	
	trigger skin1
	{
		accum 0 abort_if_not_equal 0
		
		changeaiskin zombie/mummy1
		
		trigger self* start
	}
		
	trigger skin2
	{
		accum 0 abort_if_not_equal 1
		
		changeaiskin zombie/mummy2
		
		trigger self* start
	}
	
	trigger start
	{
		takeweapon MonsterAttack2
		giveweapon MonsterAttack1
	}
	
	death
	{
	}
}

