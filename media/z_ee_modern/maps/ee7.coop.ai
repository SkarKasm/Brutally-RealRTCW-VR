/////////////////////////////////////////////
// SECTION 4 - Entrance Atrium
/////////////////////////////////////////////

	trigger action4
	{
		alertentity nazi4y
		alertentity nazi4z
		alertentity nazi6a
	}

	trigger action4a
	{
	// dont remove this crap!
		alertentity nazi4a
		alertentity zombie4aa

		// pursued helga
		trigger player obj_1
		
		#if g_reinforce >= 2 alertentity reinforce_leet3 #endif
	}

	trigger action4b
	{
		alertentity nazi4bb
		
		globalaccum 2 random 2
		trigger player action4b_xbox
		trigger player action4b_ps2
	}
	
	trigger action4b_xbox
	{
		globalaccum 2 abort_if_not_equal 0
		alertentity nazi4b
	}
	
	trigger action4b_ps2
	{
		globalaccum 2 abort_if_not_equal 1
		alertentity nazi4b_ps2
		trigger nazi4b_ps2 merc
	}

	trigger action4c
	{
	// these guys are out now :O
		#if g_reinforce >= 1
		alertentity zombie4a
		alertentity zombie4c
		#endif

		alertentity nazi4c
		alertentity nazi4d

		wait 350

		alertentity fem_alert
		
		#if g_reinforce >= 2 alertentity reinforce_priest1 #endif
	}

	trigger action4d
	{
		trigger nazi4c go
		trigger nazi4d go
		wait 2600
		
	}

/////////////////////////////////////////////
// SECTION 5 - Last Hallway Out
/////////////////////////////////////////////

	trigger action5a
	{
		alertentity nazi5a
	// taken out
		#if g_reinforce >= 1 alertentity nazi5b #endif
	}

	trigger endmap
	{
		trigger game_manager checkexit // COOP: game_manager (ee7.coop.script) checks objectives 1-3 (SP: "globalaccum 7 abort_if_not_equal 3")
	}

	// COOP: the end of the campaign. RealRTCW: endmap -> game_manager endmap (achievements) -> player mapstop
	// (changelevel / transitiontomod main, then the ending videos). Co-op plays the ending videos for
	// everyone (cin_play waits for every player), then starts the campaign again like the co-op authors' version.
	trigger exitlevel
	{
		globalaccum 7 set 0
		
		// COOP-OFF (SP achievement): globalaccum 1 inc 1
		
		// COOP-OFF (SP achievement): if g_gameskill >= 3 globalaccum 2 inc 1 endif
		
		#if g_ee_progress == 6 cvar g_ee_progress 7 #endif
		
		#if cg_drawSubtitles <= 0 cin_play ee7_1.webm #endif
		#if cg_drawSubtitles >= 1 cin_play ee7_1_sub.webm #endif
		wait 1
		#if cg_drawSubtitles <= 0 cin_play ee7_2.webm #endif
		#if cg_drawSubtitles >= 1 cin_play ee7_2_sub.webm #endif
		wait 1
		#if cg_drawSubtitles <= 0 cin_play ee7_3.webm #endif
		#if cg_drawSubtitles >= 1 cin_play ee7_3_sub.webm #endif
		wait 1
		cin_play credits.webm
		
		changelevel ee1
	}

	// RealRTCW's end of the campaign (SP only, not called in co-op)
	trigger mapstop
	{
		// COOP-OFF (SP end of campaign): if g_ee_endgameSwitch <= 0
		// COOP-OFF (SP end of campaign): changelevel
		// COOP-OFF (SP end of campaign): wait 8849 // 8799 // max, remove 50 with each added video
		// COOP-OFF (SP end of campaign): endif
		// COOP-OFF (SP end of campaign): if g_ee_endgameSwitch >= 1
		// COOP-OFF (SP end of campaign): cvar model player/default // model is carried over and 'bj3' does not exist in 'main'
		// COOP-OFF (SP end of campaign): transitiontomod main cutscene1 // escape1
		// COOP-OFF (SP end of campaign): wait 8899 // max, remove 50 with each added video
		// COOP-OFF (SP end of campaign): endif
		// COOP-OFF (SP end of campaign): (ee7_1, ee7_2, ee7_3 and credits videos: played in "trigger exitlevel")
	}

	trigger lock_down
	{
		mu_stop 3000
		mu_fade 0 500
		mu_queue sound/music/x_action // PS2-like, edit by William Faure
		
		//trigger lockdown close // COOP: commented out by the co-op authors (would lock other players out)
		//alertentity lockdown_rumble
		
		trigger game_manager achievement2 // Reach the pyramid room with the Elite Guards having opened only one gate across the level in the Lower Tombs
	}

/////////////////////////////////////////////
// Doors + Movers
/////////////////////////////////////////////

   // Primary Gate

	trigger port1_toggle
	{
		trigger portcullis1 toggle
		trigger kill_portcullis1_hint	//CGC- 030217
		
		#if g_reinforce >= 2 alertentity reinforce_zombie1 #endif
		#if g_reinforce >= 2 alertentity reinforce_zombie2 #endif
	}

   // Dungeon Passage Gate

	trigger port2_toggle
	{
		trigger portcullis2 toggle
	}


   // Spiketrap A

	trigger spiketrap_engage
	{
		trigger spikes1 go
	}

   // Stairs trigger

	trigger stairs_activate
	{
		trigger button_9a open

		//wait 4000

		//trigger lockdown open

	}

}

/////////////////////////////////////////////
// SECTION 1 - Entrance + Atrium
/////////////////////////////////////////////

// Untouchables in Helga exit scenario

leet1
{
	attributes
	{
		accuracy 0.8
		starting_health 1337
		fov 20
		camper 0.0
		tactical 1.0
	}

	spawn
	{
		#if g_ee_skinEliteGuard <= 0
		trigger self* start
		#endif
		
		#if g_ee_skinEliteGuard == 1
		trigger self* skin
		#endif
		
		#if g_ee_skinEliteGuard >= 2
		accum 0 random 2
		trigger self* skin_yes
		trigger self* skin_no
		#endif
	}
		
	trigger skin
	{
		changeaiskin eliteguard/desert1
		changeaihead desert2
		
		trigger self* start
	}
		
	trigger skin_yes
	{
		accum 0 abort_if_not_equal 1
		
		trigger self* skin
	}
		
	trigger skin_no
	{
		accum 0 abort_if_not_equal 0
		
		// spawn
		trigger self* start
	}
		
	trigger start
	{
		nosight 99999
		godmode on
		knockback off
		trigger leet1 run
	}

	// This will be called when BJ kills me by stabbing me in the back with a knife!
	stealthkill
	{
		dropitem ammo_9mm_small
		
		trigger player stealth_achievement
	}

	trigger run
	{
		nosight 9999
		wait 20
		gotomarker leet1_spot1 nostop
		trigger player closeport
	//	trigger portcullis1 toggle
		wait 400
		gotomarker leet1_spot2 nostop
		gotomarker leet1_spot3 nostop
		wait 2000 //Added a 2 second delay
		alertentity kill_leet
	}
}

