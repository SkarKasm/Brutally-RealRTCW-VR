/////////////////////////////////////////////
// Barrel Move Down Stairs
/////////////////////////////////////////////

bar1
{
	spawn
	{

	}

	trigger fall
	{
		wait 25

		gotomarker bar1_spot1 250 

		gotomarker bar1_spot1a 250 
		faceangles -30 0 0 gototime
		gotomarker bar1_spot1b 250 
		faceangles -60 0 0 gototime
		gotomarker bar1_spot2 250 
		faceangles -90 0 0 gototime
		playsound sound/movers/doors/door4_locked.wav
		
		gotomarker bar1_spot2a 300 
		faceangles -120 0 0 gototime
		gotomarker bar1_spot2b 300 
		faceangles -150 0 0 gototime
		gotomarker bar1_spot2c 300 
		faceangles -180 0 0 gototime
		gotomarker bar1_spot3 300 
		faceangles -200 0 0 gototime
		playsound sound/movers/doors/door4_locked.wav

		gotomarker bar1_spot3a 350 
		faceangles -220 0 0 gototime
		gotomarker bar1_spot3b 350 
		faceangles -240 0 0 gototime
		gotomarker bar1_spot3c 350 
		faceangles -260 0 0 gototime
		gotomarker bar1_spot3d 350 
		faceangles -280 0 0 gototime
		gotomarker bar1_spot3e 350 
		faceangles -300 0 0 gototime
		gotomarker bar1_spot3f 350 
		faceangles -320 0 0 gototime
		gotomarker bar1_spot4 350 
		faceangles -340 0 0 gototime
		playsound sound/movers/doors/door4_locked.wav

		alertentity bar1_func
		alertentity bar1_func_explode
		alertentity kill_bar1
	}
}