// Enter from Exit #2

nazi5c
{
	attributes
	{
		fov 200	 		// Default: 240 Range 1 ? 360

		aim_skill 0.5 		// Default: 0.5 Range: 0.0 ? 1.0 (specific targets)
		aim_accuracy 0.5 	// Default: 0.5 Range: 0.0 ? 1.0 (accuracy)
		attack_skill 0.5	// Default: 0.75 Range: 0.0 ? 1.0 (weaponry tactics 'grenades VS. machine gun' etc.)

		reaction_time 0.3	// Default: 0.5 Range: 0.0 ? 1.0 (seconds)

		attack_crouch 0.2	// Default: 0.4 Range: 0.0 ? 1.0 (frequency)
		idle_crouch 0.0		// Default: 0.0 Range: 0.0 ? 1.0 (frequency)

		aggression 0.8		// Default: 0.5 Range: 0.0 ? 1.0 (charging)
		tactical 0.2		// Default: 0.8 Range: 0.0 ? 1.0 (using enviroment for protection)
		camper 0.2		// Default: 0.0 Range: 0.0 ? 1.0 (camping abilities)

		alertness 16500		// Default: 16000 Range: 0 ? 999999 (sight distance in pixel units)
		starting_health 35	// Default: 100 Range: 0 ? 99999 (spawn health)

		hearing_scale 0.5	// Default: 1.0 Range: 0.0 ? 10 (hearing)

		inner_detection_radius 256
	}

	spawn
	{
		accum 0 bitreset 0 // debug
		accum 0 bitreset 1 // spotted
		accum 0 bitreset 2 // speak

		takeweapon all

		giveweapon weapon_mauserRifle
		setammo ammo_792mm 999
		selectweapon weapon_mauserRifle

		statetype alert

		trigger nazi5c go
	}

	trigger go
	{
		accum 0 abort_if_bitset 1
		accum 0 bitset 1


		clearanim
		nosight 10000
		runtomarker nazi5b_spot1 nostop
		runtomarker nazi5b_spot2 nostop
		sight
		runtomarker nazi5c_spot1 nostop
		facetargetangles nazi5c_fire
		trigger nazi5c shoot
	}

	trigger shoot
	{
		wait forever 0
		resetscript
	}

	trigger speak
	{
		accum 0 abort_if_bitset 2
		accum 0 bitset 2

		playsound sound/player/infantryss/orders/swine.wav
	}

	enemysight
	{
		trigger player musicmoving
		trigger nazi5c speak
		resetscript
	}

	statechange alert combat
	{

	}
	statechange relaxed alert
	{

	}
	statechange relaxed combat
	{

	}
	statechange query alert
	{

	}
