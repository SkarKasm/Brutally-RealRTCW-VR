		trigger player musicmoving

		giveweapon weapon_mp40
		selectweapon weapon_mp40
		statetype alert
	}

	trigger spotted
	{
		accum 0 abort_if_bitset 3
		accum 0 bitset 3


		trigger nazi1a stoptalk
		trigger nazi1b stoptalk
		wait 10

		accum 0 bitreset 1
		trigger nazi1b clear
		wait 15
		trigger nazi1b gun
		wait 5

		resetscript
	}

	trigger walk
	{
		accum 0 abort_if_bitset 4
		accum 0 bitset 4


		trigger nazi1a stoptalk
		trigger nazi1b stoptalk
		wait 10

		accum 0 bitset 3

		trigger nazi1b clear
		wait 15
		trigger nazi1b gun
		wait 5

		gotomarker nazi1a_spot1
		gotomarker nazi1a_spot2 nostop
		gotomarker nazi1a_spot3 nostop
		wait 5
		attack player
		resetscript

	}

	// if player and bot collide at door and bot is running out.

	trigger fallback
	{
		accum 0 abort_if_not_bitset 4

		clearanim
	//	runtomarker nazi1a_spot1
		facetargetangles nazi1a_spot2
		resetscript
		attack player
	}

	enemysight
	{
		trigger nazi1b spotted
	}
	statechange alert combat
	{
		trigger nazi1b spotted
	}
	statechange relaxed alert
	{
		trigger nazi1b spotted
	}
	statechange relaxed combat
	{
		trigger nazi1b spotted
	}
	statechange query alert
	{
		trigger nazi1b spotted
	}
	statechange query combat
	{
		trigger nazi1b spotted
	}
	bulletimpact
	{
		trigger nazi1b spotted
	}
	bulletimpactsound
	{
		trigger nazi1b spotted
	}
	inspectsoundstart
	{
		trigger nazi1b spotted
	}
