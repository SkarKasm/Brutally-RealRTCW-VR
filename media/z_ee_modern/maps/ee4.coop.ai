		fireattarget nazi4aa_fire 1300
		wait 50
		clearanim
		runtomarker nazi4aa_spot2
		facetargetangles nazi4aa_spot1
		resetscript
	}
	enemysight
	{
		accum 0 abort_if_not_equal 0
		accum 0 set 1
		playsound MiscKillHim
	}
