	trigger spotted1
	{
		accum 0 abort_if_bitset 3
		accum 0 bitset 3

		trigger player musicmoving
		trigger dsound nazi2d_live

		playsound MiscHalt

		attrib fov 240
		attrib alertness 12000

		clearanim
		giveweapon weapon_mp40
		selectweapon weapon_mp40
		wait 5

		statetype alert

		// wait 50 player

		accum 0 bitset 2
		resetscript
	}

