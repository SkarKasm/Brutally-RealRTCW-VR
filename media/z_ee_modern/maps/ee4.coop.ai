//
//AI Scripting
//Map: ee4
// Last edited by: Scan (2003), William Faure (2026)
//
// DONT TOUCH, FIXING UP
// Scan has now taken over script. :[] no touching anyone

player
{
	// COOP: level start, run once from game_manager's spawn (maps/ee4.coop.script). It holds what
	// RealRTCW runs for its single player in "spawn", "playerstart" and "trigger playgame".
	trigger coopstart
	{
		globalaccum 0 set 0 // For a grenade shooter in action4

		globalaccum 1 bitreset 0 // Has action1a'd
		globalaccum 1 bitreset 1 // Has action1c'd
		globalaccum 1 bitreset 2 // Has action1downstairs'd
		globalaccum 1 bitreset 3 // Has action1upstairs'd
		globalaccum 1 bitreset 4 // Has action'd nazi2d
		globalaccum 1 bitreset 5 // Ambush

		globalaccum 2 set 0 // Music

		globalaccum 3 set 0 // Cine Interrupt; objectives (RealRTCW)

		globalaccum 4 bitreset 0 // nazi1c dead for radiouse

		// secret checks
		globalaccum 5 set 0
		globalaccum 6 set 0

		globalaccum 7 set 0 // agent1 fight scene kill count

		cvar g_episode 1
		objectivesneeded 1
		
		numsecrets 2
		
		//
		
		globalaccum 2 set 4
		
		//trigger player crypt_cine1		//CGC- no cine!
		trigger counter1 cleanup		//CGC- cleanup from the cine added
		
		//

		abort_if_loadgame
		// COOP: no briefing screen, the level music starts at once
		// (SP: l_briefing_1 / l_theme in spawn, then "mu_fade 0 1500" + "mu_queue sound/music/m_grave" in playerstart)
		mu_start sound/music/m_grave
		
		trigger player playbink_ps2
	}

	// COOP: every player, on each (re)spawn: RealRTCW's "applyloadout ee4"
	// (loadouts/loadouts_campaign.loadout) written with co-op actions ("setclip ... full" -> max clip)
	spawn
	{
		giveweapon weapon_knife
		
		giveweapon weapon_colt
		setclip weapon_colt 8
		#if g_vanilla_guns <= 0 setammo ammo_45cal 31 #endif
		#if g_vanilla_guns >= 1 setammo ammo_45cal 32 #endif
		
		#if g_newInventory <= 0
		giveweapon weapon_luger
		setclip weapon_luger 8
		giveweapon weapon_mauserrifle
		setclip weapon_mauserrifle 10
		setammo ammo_792mm 8
		#endif
		
		giveweapon weapon_mp40
		setclip weapon_mp40 32
		setammo ammo_9mm 128
		
		setammo ammo_grenades 2
		
		selectweapon weapon_mp40
		
		giveinventory key_binocs
	}

	// COOP: in co-op this runs on every client spawn; the level start is "trigger coopstart"
	playerstart
	{
	}

	trigger playbink
	{
		#if cg_drawSubtitles <= 0 cin_play ee4.webm #endif
		#if cg_drawSubtitles >= 1 cin_play ee4_sub.webm #endif
	}

	trigger playbink_ps2
	{
		#if cg_drawSubtitles <= 0 cin_play ee4_ps2.webm #endif
		#if cg_drawSubtitles >= 1 cin_play ee4_ps2_sub.webm #endif
	}

	// This trigger will be called when the player actually hits the changelevel trigger,
	// AND he has found all the secrets.  Give him a cookie!
	trigger endmap_bonus
	{
		// COOP-OFF (endmap_bonus is never called in co-op): printbonus ee4
		// COOP-OFF (endmap_bonus is never called in co-op): givearmor Armored Helmet // givearmor item_armor_head   // == "Armored Helmet"
	}
	
	trigger checkpoint // Entrance
	{
		// COOP-OFF (SP save/bonus): savecheckpoint
	}

///////////////////////////////////////////////////
// Achievements
	
	trigger achievement1
	{
		// COOP-OFF (SP achievement): achievement_eeGren // Dodge a grenade in the Ruins
	}
	
	trigger stealth_achievement
	{
		// COOP-OFF (SP achievement): globalaccum 3 abort_if_greater_than 5
		// COOP-OFF (SP achievement): globalaccum 3 inc 1
		// COOP-OFF (SP achievement): globalaccum 3 abort_if_not_equal 5
		// COOP-OFF (SP achievement): achievement_eeStealth // Perform 5 rewarded stealth kills in a single playthrough
	}

///////////////////////////
// Objectives

	// Contact Agent One by radio
	trigger obj_1
	{
	//	objectivemet 1
		
	//	#if fs_ee_wolf2_sound >= 1 mu_play sound/ui/objective_new4.wav #endif
		
	//	globalaccum 3 inc 1
	}

	// Investigate the ruins area.
	trigger obj_2
	{
		objectivemet 1
		
		#if fs_ee_wolf2_sound >= 1 mu_play sound/ui/objective_new4.wav #endif
		
		globalaccum 3 inc 1
		
		trigger game_manager objective1
	}

///////////////////////////
// Secrets

	// bustable wall in ruins hall path

	trigger secret1
	{
		globalaccum 5 abort_if_not_equal 0
		globalaccum 5 set 1
		foundsecret 1
		
		// COOP-OFF (SP achievement): globalaccum 0 inc 1
	}

	// blowing up gas can

	trigger secret2
	{
		globalaccum 6 abort_if_not_equal 0
		globalaccum 6 set 1
		foundsecret 2
		
		// COOP-OFF (SP achievement): globalaccum 0 inc 1
	}
///////////////////////////
// Misc

	trigger endmap
	{
		trigger game_manager checkexit // COOP: game_manager (ee4.coop.script) checks objective 1
	}

	trigger exitlevel
	{
		// COOP-OFF (SP achievement): globalaccum 1 inc 1
		
		// COOP-OFF (SP achievement): if g_gameskill >= 3 globalaccum 2 inc 1 endif
		
		#if g_ee_progress == 3 cvar g_ee_progress 4 #endif
		
		cvar g_level_was_selected 0
		
		changelevel ee5 persistent
	}

///////////////////////////
// Music

	// Upbeat - Moving (rolling)
	trigger musicmoving
	{
		globalaccum 2 abort_if_equal 7
		globalaccum 2 set 7
		mu_stop 3000
		mu_fade 0 500
		mu_queue sound/music/m_moving
	}
	// Calm - Sneaky (lower  slower pace)
	trigger musicstealth
	{
		globalaccum 2 abort_if_equal 5
		globalaccum 2 set 5
		mu_stop 3000
		wait 1500
		mu_fade 0 500
		mu_queue sound/music/m_stealth
	}
	// Calm - After Battle (after action is over sorta)
	trigger musicgrave
	{
		globalaccum 2 abort_if_equal 4
		globalaccum 2 set 4
		mu_stop 3000
		wait 1500
		mu_fade 0 500
		mu_queue sound/music/m_grave
	}
	// Moderate - Anticipation (flat with no action)
	trigger musicmission
	{
		globalaccum 2 abort_if_equal 1
		globalaccum 2 set 1
		mu_stop 3000
		wait 1500
		mu_fade 0 500
		mu_queue sound/music/m_mission
	}
	// Moderate -  Uneasyness (throbbing and bumpy)
	trigger musictension
	{
		globalaccum 2 abort_if_equal 2
		globalaccum 2 set 2
		mu_stop 3000
		mu_fade 0 500
		mu_queue sound/music/m_tension
	}
	// Moderate - Drum Rolls
	trigger musicdrums
	{
		globalaccum 2 abort_if_equal 3
		globalaccum 2 set 3
		mu_stop 3000
		wait 1500
		mu_fade 0 500
		mu_queue sound/music/m_drums
	}
	// Upbeat - Action (duh duh duh duh)
	trigger musicaction
	{
		globalaccum 2 abort_if_equal 6
		globalaccum 2 set 6
		mu_stop 3000
		mu_fade 0 500
		mu_queue sound/music/m_action
	}
	// Upbeat - Military (drums, tromping around)
	trigger musicsituation
	{
		globalaccum 2 abort_if_equal 8
		globalaccum 2 set 8
		mu_stop 3000
		mu_fade 0 500
		mu_queue sound/music/m_situation
	}


///////////////////////////
// Cinematic

	trigger crypt_cine1
	{
		trigger player lockon
		wait 5
		trigger counter1 cine1
	}

	trigger lockoff
	{
		lockplayer off
	}

	trigger lockon
	{
		lockplayer on
	}


	trigger alert_actors
	{
		alertentity agent1
	//	alertentity fakebj
	}

	trigger camerainterrupt
	{
		// globalaccum 3 set 1
		stopcam
		trigger counter1 cleanup
		wait 3000
	}

	trigger stop
	{
		stopcam
	}

///////////////////////////
// Section 1 - Truck Area

// Start

	trigger start
	{
//		teleport radio_back

		// activate the guards
		alertentity nazi1a
		alertentity nazi1b
	}

	trigger action0
	{
		#if g_reinforce >= 2 alertentity reinforce_bg1 #endif
		#if g_reinforce >= 2 alertentity reinforce_bg2 #endif
		#if g_reinforce >= 2 alertentity reinforce_dog1 #endif
	
		alertentity nazi1d

		// Why have we been stationed in this God forsaken place?
		trigger nazi1a sound1

		wait 3500

		// Yes, there are no Allies here, and the heat is unbearable!
		trigger nazi1b sound1

		wait 3700

		// Why would Himmler send us out into the desert to dig in the sand?
		trigger nazi1a sound2

		wait 3900

		// There is plenty of sand back in Germany
		trigger nazi1b sound2
	}

// Mid point

	trigger action1a
	{
		globalaccum 1 abort_if_bitset 0
		globalaccum 1 bitset 0

		trigger player musicmoving

		trigger nazi1d walk
		alertentity nazi1c
		alertentity nazi1e
	}

	trigger action1a_door
	{
		trigger nazi1b fallback
	}

// Second Work shack door

	trigger action1b
	{
		#if g_reinforce >= 2 alertentity reinforce_leet1 #endif
		#if g_reinforce >= 2 alertentity reinforce_leet2 #endif
	}

// Near exit rise

	trigger action1c
	{
		globalaccum 1 abort_if_bitset 1
		globalaccum 1 bitset 1

		alertentity nazi1f
		wait 2000

		#if g_reinforce >= 1 alertentity nazi1g #endif
		
		#if g_reinforce >= 2 alertentity reinforce_bg3 #endif
		#if g_reinforce >= 2 alertentity reinforce_leet3 #endif
	}

	trigger radioguydead
	{
		globalaccum 4 bitset 1
	}

	trigger radio_conversation
	{
		globalaccum 4 abort_if_not_bitset 1
		globalaccum 3 abort_if_equal 1

		teleport radio_away
		alertentity fakebj
		startcam ee4_radio_cam

		lockplayer on
		wait 500

		alertentity radio1_talk1
		wait 1500

		globalaccum 3 abort_if_equal 1
		alertentity radio1_talk2
		wait 1000

		alertentity radio1_talk3
		wait 14000

		globalaccum 3 abort_if_equal 1
		alertentity radio1_talk4

		alertentity kill_fakebj
		teleport radio_back
		wait 5
		stopcam
		wait 500
		lockplayer off

		// trigger player obj_1

	//	globalaccum 3 set 1
		globalaccum 4 bitset 1
	}

///////////////////////////
// Section 2 - Ruins Courtyard

	trigger action2a
	{
		alertentity nazi2a
		alertentity nazi2b
		alertentity nazi2c
		alertentity nazi2e
		alertentity nazi2f
		
		#if g_reinforce >= 2 alertentity reinforce_v1 #endif
	}

	trigger killcounter
	{

		globalaccum 7 inc 1

		globalaccum 7 abort_if_less_than 2
			trigger nazi2e go

		globalaccum 7 abort_if_less_than 3
			trigger nazi2f go
	}
	trigger killcounter2
	{

	}

// Entering offshoot room under ledge

	trigger action2b
	{
		globalaccum 1 abort_if_bitset 4
		globalaccum 1 bitset 4

		alertentity nazi2d
		trigger nazi2e spotted
		
		#if g_reinforce >= 2 alertentity reinforce_leet4 #endif
	}

// When bomb goes off, blow out wall too secret area and alert outside guard towards area

	trigger boom_alert
	{
		trigger counter1 nrv_shake
	}

// Entering Path to upper ledge

	trigger action2c
	{
		#if g_reinforce >= 2 alertentity reinforce_bg4 #endif
		
		alertentity nazi3a
		alertentity nazi3b
		alertentity nazi3c

		trigger agent1 more_enemies2

		wait 200

		wait 2000 // new - casey
		trigger nazi3a speak

//		wait 1200

//		trigger nazi3b speak

//		wait 1500

//		trigger nazi3a speak2

//		wait 1200

//		trigger nazi3b speak2

//		wait 1000

//		trigger nazi3c speak
	}

	trigger action2c_spot
	{
		trigger nazi2f spotted
	}

///////////////////////////
// Section 3 - Ruins Passage

	trigger action3a
	{
		trigger nazi3a spotted
		wait 5
		trigger nazi3b spotted
		wait 5
		trigger nazi3c spotted

		trigger player musicaction
	}

	trigger action3b
	{
		alertentity nazi3d
		alertentity nazi3e
	}

	trigger action3c
	{
		trigger nazi3d go
		
		#if g_reinforce >= 2 alertentity reinforce_bg5 #endif
	}

	trigger action3d
	{
		alertentity nazi4c
		
		#if g_reinforce >= 2 alertentity reinforce_leet5 #endif
	}

///////////////////////////
// Section 4 - Ruins Passage - Reinforcements

// Heading back from offshoot down the stairs

	trigger action4_shooter
	{
		// Don't let it go off until the player has gone all the way down


		globalaccum 0 abort_if_not_equal 1
		globalaccum 0 set 0

		alertentity gren_ambush
		trigger ast gren_ambush

		trigger dsound nazi4aa_live
		trigger dsound nazi4bb_live
		trigger player musicmoving

		wait 1000
		alertentity gren_shooter

	}

	// if player goes down, spawn reinforcements

	trigger action4_downstairs
	{
		// abort if player has already been downstairs
		globalaccum 1 abort_if_bitset 2

		// abort if player was upstairs and killed re-inforcements already
		globalaccum 1 abort_if_bitset 3

		// flag has been downstairs
		globalaccum 1 bitset 2

		// flag ambush trigger go
		globalaccum 1 bitset 5

		// shooter can go off, backup spawned
		globalaccum 0 set 1


		// backup spawns
		alertentity nazi4aa
		alertentity nazi4bb
	}

	// if player goes up, spawn reinforcements high, so it would make sense
	// if you overted the basement offshoot

	trigger action4_upstairs
	{
		// abort if player has been downstairs
		globalaccum 1 abort_if_bitset 2

		// abort if player has already been upstairs
		globalaccum 1 abort_if_bitset 3

		// flag has been upstairs
		globalaccum 1 bitset 3


		trigger player musicmoving

		// backup spawns

		alertentity nazi4a
		wait 500
		alertentity nazi4b
	}

	trigger action4_ambush
	{
		// abort if player hasn't been downstairs
		globalaccum 1 abort_if_not_bitset 5
		globalaccum 1 bitreset 5

		trigger nazi4aa go
	}

///////////////////////////
// Section 5 - Clearance

	trigger action5a
	{
		alertentity nazi5a
		
		#if g_reinforce >= 2 alertentity reinforce_bg6 #endif
	}
	trigger action5b
	{
		trigger player musicmoving

		alertentity nazi5b
		wait 1500
		alertentity nazi5c

		globalaccum 1 abort_if_bitset 4
		globalaccum 1 bitset 4

		alertentity nazi2d
	}

	trigger open
	{
		trigger player obj_2
	}
}


/////////////////////////////////////////////
// SECTION 1 - Truck Yard
/////////////////////////////////////////////

// Nazi looking out window

nazi1a
{
	attributes
	{
		fov 100	 		// Default: 240 Range 1 ? 360

		aim_skill 0.4 		// Default: 0.5 Range: 0.0 ? 1.0 (specific targets)
		aim_accuracy 0.3 	// Default: 0.5 Range: 0.0 ? 1.0 (accuracy)
		attack_skill 0.5	// Default: 0.75 Range: 0.0 ? 1.0 (weaponry tactics 'grenades VS. machine gun' etc.)

		reaction_time 0.5	// Default: 0.5 Range: 0.0 ? 1.0 (seconds)

		attack_crouch 0.2	// Default: 0.4 Range: 0.0 ? 1.0 (frequency)
		idle_crouch 0.0		// Default: 0.0 Range: 0.0 ? 1.0 (frequency)

		aggression 0.7		// Default: 0.5 Range: 0.0 ? 1.0 (charging)
		tactical 0.3		// Default: 0.8 Range: 0.0 ? 1.0 (using enviroment for protection)
		camper 0.2		// Default: 0.0 Range: 0.0 ? 1.0 (camping abilities)

		alertness 3500		// Default: 16000 Range: 0 ? 999999 (sight distance in pixel units)
		starting_health 35	// Default: 100 Range: 0 ? 99999 (spawn health)

		hearing_scale 0.5	// Default: 1.0 Range: 0.0 ? 10 (hearing)

		inner_detection_radius 512
	}

	spawn
	{
		accum 0 bitreset 0 // debug
		accum 0 bitreset 1 // cleared
		accum 0 bitreset 2 // gun
		accum 0 bitreset 3 // spotted
		accum 0 bitreset 4 // walking
		accum 0 bitreset 5 // talking

		takeweapon all

		setammo ammo_grenades 0
		setammo ammo_9mm 999
	}

	trigger sound1
	{
		accum 0 abort_if_bitset 5
		clearanim
		playsound nazi_ee4_1a
	}

	trigger sound2
	{
		accum 0 abort_if_bitset 5
		clearanim
		playsound nazi_ee4_1c

		wait 3000

		trigger nazi1a look
	}

	trigger stoptalk
	{
		accum 0 bitset 5
		playsound blank
	}

	trigger look
	{
		accum 0 abort_if_bitset 1

		//cigarette on
		//playanim smoking both forever
	}

	trigger clear
	{
		accum 0 abort_if_bitset 1
		accum 0 bitset 1


		//cigarette off
		clearanim
		attrib fov 240
		attrib alertness 12000
	}

	trigger gun
	{
		accum 0 abort_if_bitset 2
		accum 0 bitset 2


		trigger player musicmoving

		giveweapon weapon_mp40
		selectweapon weapon_mp40
		statetype alert
	}

	trigger spotted
	{
		accum 0 abort_if_bitset 3
		accum 0 bitset 3


		trigger nazi1a stoptalk
		trigger nazi1b stoptalk

		wait 10

		accum 0 bitset 4
		playsound MiscHalt

		trigger nazi1a clear
		wait 15
		trigger nazi1a gun
		wait 5

		wait forever 0
		resetscript
	}

	trigger walk
	{
		accum 0 abort_if_bitset 4
		accum 0 bitset 4


		trigger nazi1a stoptalk
		trigger nazi1b stoptalk
		wait 10

		accum 0 bitset 3
		playsound MiscWhatsThat

		trigger nazi1a clear
		wait 15
		trigger nazi1a gun
		wait 5

		gotomarker nazi1a_spot1
		gotomarker nazi1a_spot2 nostop
		gotomarker nazi1a_spot3 nostop
		wait 5
		resetscript
		attack player
	}

	enemysight
	{
		trigger nazi1a spotted
	}
	statechange alert combat
	{
		trigger nazi1a spotted
	}
	statechange relaxed alert
	{
		trigger nazi1a walk
	}
	statechange relaxed combat
	{
		trigger nazi1a spotted
	}
	statechange query alert
	{
		trigger nazi1a walk
	}
	statechange query combat
	{
		trigger nazi1a spotted
	}
	bulletimpact
	{
		trigger nazi1a walk
	}
	bulletimpactsound
	{
		trigger nazi1a walk
	}
	inspectsoundstart
	{
		trigger nazi1a walk
	}
	inspectsoundend
	{
		trigger nazi1a walk
	}
	inspectfriendlycombatstart
	{
		trigger nazi1a walk
	}
	inspectbodystart
	{

	}
	inspectbodyend
	{

	}

	// This will be called when BJ kills me by stabbing me in the back with a knife!
	stealthkill
	{
		dropitem ammo_9mm_small
		
		trigger player stealth_achievement
	}

	death
	{
		trigger nazi1b walk
		trigger nazi1d walk
		trigger dsound nazi1a_kill
	}
}

// Nazi looking at table on desk

nazi1b
{
	attributes
	{
		fov 110 		// Default: 240 Range 1 ? 360

		aim_skill 0.4 		// Default: 0.5 Range: 0.0 ? 1.0 (specific targets)
		aim_accuracy 0.3 	// Default: 0.5 Range: 0.0 ? 1.0 (accuracy)
		attack_skill 0.5	// Default: 0.75 Range: 0.0 ? 1.0 (weaponry tactics 'grenades VS. machine gun' etc.)

		reaction_time 0.5	// Default: 0.5 Range: 0.0 ? 1.0 (seconds)

		attack_crouch 0.2	// Default: 0.4 Range: 0.0 ? 1.0 (frequency)
		idle_crouch 0.0		// Default: 0.0 Range: 0.0 ? 1.0 (frequency)

		aggression 0.7		// Default: 0.5 Range: 0.0 ? 1.0 (charging)
		tactical 0.3		// Default: 0.8 Range: 0.0 ? 1.0 (using enviroment for protection)
		camper 0.2		// Default: 0.0 Range: 0.0 ? 1.0 (camping abilities)

		alertness 1200		// Default: 16000 Range: 0 ? 999999 (sight distance in pixel units)
		starting_health 30	// Default: 100 Range: 0 ? 99999 (spawn health)

		hearing_scale 0.5	// Default: 1.0 Range: 0.0 ? 10 (hearing)

		inner_detection_radius 512
	}

	spawn
	{
		accum 0 bitreset 0 // debug
		accum 0 bitreset 1 // cleared
		accum 0 bitreset 2 // gun
		accum 0 bitreset 3 // spotted
		accum 0 bitreset 4 // walking
		accum 0 bitreset 5 // talking

		takeweapon all

		setammo ammo_grenades 0
		setammo ammo_9mm 999

		trigger nazi1b look
