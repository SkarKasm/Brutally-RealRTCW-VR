id_merc1
{
	attributes
	{
		fov 170
		aim_skill 0.2
		aim_accuracy 0.2
		attack_skill 0.2
		reaction_time 0.3
		alertness 2000
		starting_health 20
	}

	spawn
	{
		accum 0 bitreset 0
		giveweapon weapon_mauserrifle
		setammo ammo_792mm 999
		selectweapon weapon_mauserrifle
		
		#if g_ee_skinMercenary <= 0
		trigger self* skin
		#endif
		
		#if g_ee_skinMercenary == 1
		trigger self* start
		#endif
		
		#if g_ee_skinMercenary >= 2
		accum 0 random 2
		accum 0 abort_if_equal 0
		trigger self* skin
		#endif
	}
		
	trigger skin
	{
		changeaihead default
		
		accum 1 random 2
		trigger self* skin1
		trigger self* skin2
	}
		
	trigger skin1
	{
		accum 1 abort_if_not_equal 0
		
		changeaiskin merc/black
		changeaihead black
		
		trigger self* start
	}
		
	trigger skin2
	{
		accum 1 abort_if_not_equal 1
		
		changeaiskin merc/red
		changeaihead red
		
		trigger self* start
	}
		
	trigger start
	{
		walktomarker idm1spot1
		facetargetangles idm1spot1
		wait forever 0
	}

	enemysight
	{
		attack player
	}

	inspectsoundstart
	{
		attack player
	}

	bulletimpact
	{
		attack player
	}

	statechange relaxed query
	{
		attack player
	}

	statechange relaxed alert
	{
		attack player
	}

	statechange relaxed combat
	{
		attack player
	}

	death
	{
	}
}

// Reinforcements

reinforce_leet1
{
	spawn
	{
		#if g_ee_skinEliteGuard <= 0
		trigger self* start
		#endif
		
		#if g_ee_skinEliteGuard == 1
		trigger self* skin
		#endif
		
		#if g_ee_skinEliteGuard >= 2
		accum 0 random 2
		trigger self* skin_yes
		trigger self* skin_no
		#endif
	}
		
	trigger skin
	{
		changeaiskin eliteguard/desert1
		
		trigger self* start
	}
		
	trigger skin_yes
	{
		accum 0 abort_if_not_equal 1
		
		trigger self* skin
	}
		
	trigger skin_no
	{
		accum 0 abort_if_not_equal 0
		
		// spawn
		trigger self* start
	}
		
	trigger start
	{
		takeweapon all
		giveweaponfull weapon_silencer // weapon_mp34 weapon_mp40
		statetype alert
	}

	death
	{
	}
}

