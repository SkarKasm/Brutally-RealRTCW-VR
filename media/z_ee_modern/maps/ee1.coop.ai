//
// AI scripts for ee1
// Last edited by: Scan (2003), William Faure (2026)

player
{
	// COOP: level start, run once from game_manager's spawn (maps/ee1.coop.script). It holds what
	// RealRTCW runs for its single player in "spawn", "playerstart" and "trigger playgame".
	trigger coopstart
	{
		globalaccum 0 set 0 // (for counting dead nazi's?) comment?????
		globalaccum 1 set 0 // found secret 1
		globalaccum 2 set 0 // Music
		globalaccum 3 set 0 // Fake end map
		globalaccum 4 set 0 // family speaker
		globalaccum 5 bitset 0 // left room child talker flag
		globalaccum 5 bitset 1 // can check off child talker
		globalaccum 6 set 0 // objectives

		cvar g_episode 1
		objectivesneeded 2
		
		numsecrets 3
		
		//

		abort_if_loadgame
		// COOP: no briefing screen, the level music starts at once
		// (SP: l_briefing_1 / l_theme in spawn, then "mu_fade 0 1200" + "mu_queue sound/music/m_stealth" in playerstart)
		mu_start sound/music/m_stealth
		
		#if cg_drawSubtitles <= 0 cin_play ee1.webm #endif
		#if cg_drawSubtitles >= 1 cin_play ee1_sub.webm #endif
		
		// trigger counter1 cine1
		// trigger player start_location
		
		trigger player action1_civ
	}

	// COOP: every player, on each (re)spawn: RealRTCW's "applyloadout ee1"
	// (loadouts/loadouts_campaign.loadout) written with co-op actions ("setclip ... full" -> max clip)
	spawn
	{
		giveweapon weapon_knife
		
		giveweapon weapon_colt
		setclip weapon_colt 8
		#if g_vanilla_guns <= 0 setammo ammo_45cal 23 #endif
		#if g_vanilla_guns >= 1 setammo ammo_45cal 24 #endif
		
		selectweapon weapon_colt
	}

	// COOP: in co-op this runs on every client spawn; the level start is "trigger coopstart"
	playerstart
	{
	}

	// This trigger will be called when the player actually hits the changelevel trigger,
	// AND he has found all the secrets.  Give him a cookie!
	trigger endmap_bonus
	{
		// COOP-OFF (endmap_bonus is never called in co-op): printbonus ee1
		// COOP-OFF (endmap_bonus is never called in co-op): givearmor Armored Helmet // givearmor item_armor_head   // == "Armored Helmet"
	}
	
	trigger checkpoint // House
	{
		// COOP-OFF (SP save/bonus): savecheckpoint
	}

///////////////////////////////////////////////////
// Achievements
	
	trigger achievement1
	{
		// COOP-OFF (SP achievement): achievement_eeAhmed // Be seen by Ahmed in Ras el-Hadid
	}
	
	trigger stealth_achievement
	{
		// COOP-OFF (SP achievement): globalaccum 3 abort_if_greater_than 5
		// COOP-OFF (SP achievement): globalaccum 3 inc 1
		// COOP-OFF (SP achievement): globalaccum 3 abort_if_not_equal 5
		// COOP-OFF (SP achievement): achievement_eeStealth // Perform 5 rewarded stealth kills in a single playthrough
	}

///////////////////////////////////////////////////
// Secrets

	trigger secret1 // In shed
	{
		foundsecret
		
		// COOP-OFF (SP achievement): globalaccum 0 inc 1
	}

	trigger secret2 // bars in storage room
	{
		foundsecret
		
		// COOP-OFF (SP achievement): globalaccum 0 inc 1
	}

	trigger secret3 // create on roof
	{
		foundsecret
		
		// COOP-OFF (SP achievement): globalaccum 0 inc 1
	}

///////////////////////////////////////////////////
// Ojectives

	trigger obj_1
	{
		objectivemet 1
		
		#if fs_ee_wolf2_sound >= 1 mu_play sound/ui/objective_new4.wav #endif
		
		globalaccum 6 inc 1
		
		trigger game_manager objective1
	}

	trigger obj_2
	{
		objectivemet 2
		
		#if fs_ee_wolf2_sound >= 1 mu_play sound/ui/objective_new4.wav #endif
		
		globalaccum 6 inc 1
		
		trigger game_manager objective2
	}

// End the map

	trigger endmap
	{
		trigger game_manager checkexit // COOP: game_manager (ee1.coop.script) checks objectives 1 and 2
	}

	trigger exitlevel
	{
		// COOP-OFF (SP achievement): globalaccum 1 inc 1
		
		#if g_gameskill >= 3
		// COOP-OFF (SP achievement): globalaccum 2 inc 1
		#endif
		
		#if g_ee_progress == 0 cvar g_ee_progress 1 #endif
		
		cvar g_level_was_selected 0
		
		changelevel ee2 persistent
	}

///////////////////////////
// Music

	// Upbeat - Moving (rolling)
	trigger musicmoving
	{
		globalaccum 2 abort_if_equal 7
		globalaccum 2 set 7
		mu_stop 3000
		mu_fade 0 500
		mu_queue sound/music/m_moving
	}
	// Calm - Sneaky (lower  slower pace)
	trigger musicstealth
	{
		globalaccum 2 abort_if_equal 5
		globalaccum 2 set 5
		mu_stop 3000
		wait 1500
		mu_fade 0 500
		mu_queue sound/music/m_stealth
	}
	// Calm - After Battle (after action is over sorta)
	trigger musicgrave
	{
		globalaccum 2 abort_if_equal 4
		globalaccum 2 set 4
		mu_stop 3000
		wait 1500
		mu_fade 0 500
		mu_queue sound/music/m_grave
	}
	// Moderate - Anticipation (flat with no action)
	trigger musicmission
	{
		globalaccum 2 abort_if_equal 1
		globalaccum 2 set 1
		mu_stop 3000
		wait 1500
		mu_fade 0 500
		mu_queue sound/music/m_mission
	}
	// Moderate -  Uneasyness (throbbing and bumpy)
	trigger musictension
	{
		globalaccum 2 abort_if_equal 2
		globalaccum 2 set 2
		mu_stop 3000
		mu_fade 0 500
		mu_queue sound/music/m_tension
	}
	// Moderate - Drum Rolls
	trigger musicdrums
	{
		globalaccum 2 abort_if_equal 3
		globalaccum 2 set 3
		mu_stop 3000
		wait 1500
		mu_fade 0 500
		mu_queue sound/music/m_drums
	}
	// Upbeat - Action (duh duh duh duh)
	trigger musicaction
	{
		globalaccum 2 abort_if_equal 6
		globalaccum 2 set 6
		mu_stop 3000
		mu_fade 0 500
		mu_queue sound/music/m_action
	}
	// Upbeat - Military (drums, tromping around)
	trigger musicsituation
	{
		globalaccum 2 abort_if_equal 8
		globalaccum 2 set 8
		mu_stop 3000
		mu_fade 0 500
		mu_queue sound/music/m_situation
	}

///////////////////////////////////////////////////
// Village Pathway

// Sets up first ai after cinematic

	trigger action1_civ
	{
		alertentity civ0
		alertentity nazi1a
		alertentity nazi1b
	}

// Enters range of visibility for nazi1a

	trigger action1_sight
	{
		trigger nazi1a unblind
	}

// First Stretch

	trigger action1a
	{
		alertentity nazi1c
	}

	// entrance passage lets family talk
	trigger talkflag1
	{
		// set exit hall
		globalaccum 5 bitreset 0
	}

	// hall passage DOESN't lets family talk
	trigger talkflag2
	{
		// set enter hall
		globalaccum 5 bitset 0
	}

	trigger talkflag3
	{
		trigger player family
	}


// Mummy I'm telling you

	trigger family
	{
		globalaccum 4 abort_if_not_equal 0
		globalaccum 5 abort_if_bitset 0

		wait 2500

		alertentity misc_chatter01a
		trigger ast chatter01a
		wait 3000

		alertentity misc_chatter01b
		trigger ast chatter01b
		wait 3700

		alertentity misc_chatter01c
		trigger ast chatter01c
		wait 3500

		alertentity misc_chatter01d
		trigger ast chatter01d

		globalaccum 4 set 1
	}

// See Agent one as you enter hallway underpass

	trigger agent1_runby
	{
		// alertentity agent1_run
		// wait 25
		// trigger agent1_run run
		trigger nazi1b set_spotted_in
	}

// Chats with nazi, but really its you.

	trigger action1_chat
	{
		trigger nazi1b speak
	}

// alert old market ai

	trigger action1b
	{
		alertentity kill1_run
		alertentity nazi1d
		alertentity civ1
		wait 10
	}

// alert two nazi's on lofted ground

	trigger action1c
	{
		alertentity nazi1e
		alertentity nazi1g // inside house
		trigger civ1 runback // MBJ
	}

	trigger action1d
	{
		
		alertentity nazi2
		trigger nazi2 face_90
		alertentity bike_on
		wait 4300 // see below
		alertentity bike_on_delay // 'target_delay' changed to 'target_relay' by William Faure
	}

///////////////////////////////////////////////////
// Inside House

	trigger action2a
	{
		// Make your way through the village
		trigger player obj_1

		alertentity nazi2a
		alertentity nazi2b
	}

	trigger action2aa
	{
		trigger nazi2a cover
	}

	trigger action2barrel
	{
		trigger bar1 fall
		trigger nazi2b go
	}

	trigger action2b
	{
		alertentity nazi2c
		trigger nazi2b retreat
		
		#if g_reinforce >= 2 alertentity reinforce_leet1 #endif
	}

	trigger action2c
	{
		trigger nazi2c go
	}

	trigger action2d
	{
		#if g_reinforce >= 2 alertentity reinforce_leet2 #endif
	}


///////////////////////////////////////////////////
// Outside Courtyard

	trigger action3a
	{
		// not being used right now
		// fallback if players skip room
		// trigger nazi2d start
	}

	// Calls nazi to come out of building across the way

	trigger action3b
	{
		// guy on balcony
		
		#if g_reinforce >= 1
		alertentity nazi3a			//CGC- sniper removed
		#endif

		// two guys patrolling courtyard

		alertentity nazi3c
		alertentity nazi3cc
		alertentity nazi3g

		// guy on second balcony
		
		#if g_reinforce >= 1
		alertentity nazi3e			//CGC- sniper removed
		#endif
		
		#if g_reinforce >= 1
		alertentity id_merc1
		#endif

		trigger player musicmoving
	}

// passage into radio room

	trigger action3c
	{
		alertentity nazi3b // radio guy
		trigger nazi3g go // shooter
	}

	trigger action3c2
	{
		trigger nazi3g go2 // pass by
	}

// passage into crate room

	trigger action3d
	{
		alertentity nazi3d
	}

// go down

	trigger action3e
	{
		alertentity nazi3f
	}

// stairs to balcony

	trigger action3f
	{
		#if g_reinforce >= 1
		trigger nazi3e stairs		//CGC- sniper removed
		#endif
	}

// radio room action shooter

	trigger action3g
	{
		trigger nazi3g go // shooter
	}

// crate room hallway
	trigger action3h
	{
		trigger nazi3d speak // 'playsound nazi_ee1_1a' restored, William Faure
	}

// Agent1 passes by gated off hall

	trigger agent1_runby2
	{
		// alertentity agent1_action
	}

///////////////////////////////////////////////////
// Ending Hall

	trigger action4a
	{
		#if g_reinforce >= 2 alertentity reinforce_leet3 #endif
		#if g_reinforce >= 2 alertentity reinforce_dog1 #endif
	
		alertentity nazi4a
		mu_fade 0 1500
		trigger player musicmoving

		trigger nazi3cc go
	}

/////////////////////////////////////////////
// Cinematic Stuff
/////////////////////////////////////////////

	trigger start_location
	{
		teleport playerstart_2
	}

	trigger camerainterrupt
	{
		stopcam
		trigger counter1 cine_cleanup
	}

// -= Cine stuff end here =-
}
/////////////////////////////////////////////
// CINEMATIC AI
/////////////////////////////////////////////

// Cine pawns

// End of cine pawns

/////////////////////////////////////////////
// SECTION 1 - Town Entrance Path
/////////////////////////////////////////////

// Civilian runs up hill into opposing house at spawn.

civ0
{
	attributes
	{
		running_speed 340
		fov 1
		starting_health 20
		hearing_scale 0.0
		alertness 0
		inner_detection_radius 1
	}

	spawn
	{
		knockback off
		takeweapon all
		nosight 10000

		trigger civ0 run
	}

	trigger run
	{
		nosight 99999
	//	playsound v2_inge_please_dont
		playsound civ0a
		runtomarker civ0_spot1 nostop
		runtomarker civ0_spot2
		trigger civdoor0 close
		wait 50
		alertentity kill_civ0
	}
	death
	{
		missionfailed 2 1
	}
}

// Agent one runs down road by gate

agent1_run
{
	attributes
	{
		fov 1   		// Default: 240 Range 1 ? 360

		aim_skill 0.5 		// Default: 0.5 Range: 0.0 ? 1.0 (specific targets)
		aim_accuracy 0.1 	// Default: 0.5 Range: 0.0 ? 1.0 (accuracy)
		attack_skill 0.5	// Default: 0.75 Range: 0.0 ? 1.0 (weaponry tactics 'grenades VS. machine gun' etc.)

		reaction_time 0.7	// Default: 0.5 Range: 0.0 ? 1.0 (seconds)

		attack_crouch 0.4	// Default: 0.4 Range: 0.0 ? 1.0 (frequency)
		idle_crouch 0.0		// Default: 0.0 Range: 0.0 ? 1.0 (frequency)

		aggression 0.5		// Default: 0.5 Range: 0.0 ? 1.0 (charging)
		tactical 0.5		// Default: 0.8 Range: 0.0 ? 1.0 (using enviroment for protection)
		camper 0.3		// Default: 0.0 Range: 0.0 ? 1.0 (camping abilities)

		alertness 1		// Default: 16000 Range: 0 ? 999999 (sight distance in pixel units)
		starting_health 25	// Default: 100 Range: 0 ? 99999 (spawn health)

		hearing_scale 0.0	// Default: 1.0 Range: 0.0 ? 10 (hearing)

		inner_detection_radius 1 // (detection of things like bullet impacts within the range will affect the AI, in pixel units)

	}

	spawn
	{
		accum 0 set 0 // 1 = Is alert
		notarget on

		setammo ammo_grenades 0
		takeweapon all
		//giveweapon weapon_mp40
		//selectweapon weapon_mp40
		giveweapon weapon_thompson // MBJ
		selectweapon weapon_thompson // MBJ

	//	giveweapon weapon_colt
	//	selectweapon weapon_colt
		nosight 10000
		wait 50
	}

	trigger run
	{
		nosight 99999

		explicit_routing on
		runtomarker agent1_run_spot0 nostop
		//wait 250
		runtomarker agent1_run_spot1
		explicit_routing off
	}
	death
	{
		missionfailed 2 10
	}
}

// first guy

nazi1a
{
	attributes
	{
		fov 1	 		// Default: 240 Range 1 ? 360

		aim_skill 0.5 		// Default: 0.5 Range: 0.0 ? 1.0 (specific targets)
		aim_accuracy 0.2 	// Default: 0.5 Range: 0.0 ? 1.0 (accuracy)
		attack_skill 0.5	// Default: 0.75 Range: 0.0 ? 1.0 (weaponry tactics 'grenades VS. machine gun' etc.)

		reaction_time 0.7	// Default: 0.5 Range: 0.0 ? 1.0 (seconds)

		attack_crouch 0.4	// Default: 0.4 Range: 0.0 ? 1.0 (frequency)
		idle_crouch 0.0		// Default: 0.0 Range: 0.0 ? 1.0 (frequency)

		aggression 0.6		// Default: 0.5 Range: 0.0 ? 1.0 (charging)
		tactical 0.2		// Default: 0.8 Range: 0.0 ? 1.0 (using enviroment for protection)
		camper 0.3		// Default: 0.0 Range: 0.0 ? 1.0 (camping abilities)

		alertness 6000		// Default: 16000 Range: 0 ? 999999 (sight distance in pixel units)
		starting_health 25	// Default: 100 Range: 0 ? 99999 (spawn health)

		hearing_scale 1.0	// Default: 1.0 Range: 0.0 ? 10 (hearing)

		inner_detection_radius 512 // (detection of things like bullet impacts within the range will affect the AI, in pixel units)

	}

	spawn
	{
		accum 0 set 0 // spotted

		setammo ammo_grenades 0
		takeweapon all
		giveweapon weapon_luger

		nosight 99999
		trigger nazi1a speak
	}

	trigger speak
	{
		facetargetangles nazi1a_civ
		wait 1000
		playsound v2_g1lc_haha
		trigger nazi1a walk
	}
	trigger walk
	{
		facetargetangles  nazi1a_spot0
		wait 1500
		sight
		wait 200
		accum 0 abort_if_not_equal 0
		clearanim
		attrib fov 55

		walktomarker nazi1a_spot0a nostop
		walktomarker nazi1a_spot0b nostop
		walktomarker nazi1a_spot0c nostop
		walktomarker nazi1a_spot0
		resetscript
	}

	trigger spotted
	{
		accum 0 abort_if_not_equal 0
		accum 0 set 1

		sight
		attrib fov 240
		wait 200 player
		clearanim
		selectweapon weapon_luger
		
		resetscript
	}

	enemysight
	{
		playsound MiscHalt
		trigger nazi1a spotted
	}

	attacksound
	{
		trigger nazi1b spottedout
	}

	statechange relaxed alert
	{
		attrib fov 70
		sight
		clearanim
	}
	statechange query alert
	{
		attrib fov 70
		sight
		clearanim
	}

	statechange relaxed combat
	{
		trigger nazi1a spotted
	}

	// leave
	statechange query combat
	{
		trigger nazi1a spotted
	}

	inspectfriendlycombatstart
	{

	}

	bulletimpact
	{
		trigger nazi1a spotted
		resetscript
	}

	bulletimpactsound
	{
		trigger nazi1a spotted
		resetscript
	}

	inspectsoundstart
	{
		sight
		attrib fov 240
		resetscript
	}

	// This will be called when BJ kills me by stabbing me in the back with a knife!
	stealthkill
	{
		dropitem item_armor_head
		
		trigger player stealth_achievement
	}

	death
	{
		trigger dsound nazi1a_kill
	}
}

// guy in the first house

nazi1b
{
	attributes
	{
		fov 90 		// Default: 240 Range 1 ? 360

		aim_skill 0.5 		// Default: 0.5 Range: 0.0 ? 1.0 (specific targets)
		aim_accuracy 0.2 	// Default: 0.5 Range: 0.0 ? 1.0 (accuracy)
		attack_skill 0.5	// Default: 0.75 Range: 0.0 ? 1.0 (weaponry tactics 'grenades VS. machine gun' etc.)

		reaction_time 0.7	// Default: 0.5 Range: 0.0 ? 1.0 (seconds)

		attack_crouch 0.3	// Default: 0.4 Range: 0.0 ? 1.0 (frequency)
		idle_crouch 0.0		// Default: 0.0 Range: 0.0 ? 1.0 (frequency)

		aggression 0.5		// Default: 0.5 Range: 0.0 ? 1.0 (charging)
		tactical 0.2		// Default: 0.8 Range: 0.0 ? 1.0 (using enviroment for protection)
		camper 0.5		// Default: 0.0 Range: 0.0 ? 1.0 (camping abilities)

		alertness 12000		// Default: 16000 Range: 0 ? 999999 (sight distance in pixel units)
		starting_health 25	// Default: 100 Range: 0 ? 99999 (spawn health)

		hearing_scale 1.0	// Default: 1.0 Range: 0.0 ? 10 (hearing)

		inner_detection_radius 384 // (detection of things like bullet impacts within the range will affect the AI, in pixel units)

	}

	spawn
	{
		accum 0 set 0 // alerted
		accum 1 set 0 // has spoken
		accum 2 set 0 // spotted in

		takeweapon all

		setammo ammo_grenades 0
		setammo ammo_9mm 999
		giveweapon weapon_luger
	}

	trigger speak
	{
		accum 1 abort_if_not_equal 0
		accum 1 set 1

		trigger nazi1b stoptalk
		playsound rocket_nazi4_the_front
		wait 3500
		sight
		facetargetangles look_here
		trigger nazi1b spotted
	}

	trigger spotted
	{
		trigger player musicmoving

		trigger nazi1b spottedin
		trigger nazi1b spottedout
	}

	trigger set_spotted_in
	{
		accum 2 set 1
	}

	trigger stoptalk
	{
		playsound blank
	}

	trigger spottedin
	{
		accum 2 abort_if_not_equal 1

		accum 0 abort_if_not_equal 0
		accum 0 set 1


		accum 1 set 1

		trigger nazi1b stoptalk
		clearanim
		attrib fov 200
		wait 500
		playsound MiscHalt
		wait 100
		statetype alert
		selectweapon weapon_luger
		
		resetscript
	}

	trigger spottedout
	{
		accum 2 abort_if_not_equal 0

		accum 0 abort_if_not_equal 0
		accum 0 set 1

		accum 1 set 1
		trigger nazi1b stoptalk

		clearanim
		wait 500
		statetype alert
		giveweapon weapon_luger
		selectweapon weapon_luger
		
		attrib fov 200

		resetscript
		attack player
		runtomarker nazi1a_spot2
		runtomarker nazi1a_spot1
		playsound MiscKillHim
	}

	enemysight
	{
		trigger nazi1b spotted
	}

	statechange relaxed alert
	{
		trigger nazi1b spotted
	}

	statechange relaxed combat
	{
		trigger nazi1b spotted
	}

	statechange query alert
	{
		trigger nazi1b spotted

	}
	statechange query combat
	{
		trigger nazi1b spotted
	}

	inspectfriendlycombatstart
	{
		trigger nazi1b spotted
	}

	bulletimpact
	{
		trigger nazi1b spotted
	}

	bulletimpactsound
	{
		trigger nazi1b spotted
	}

	inspectsoundstart
	{
		trigger nazi1b spotted
	}

	inspectsoundend
	{
		trigger nazi1b spotted
	}

	// This will be called when BJ kills me by stabbing me in the back with a knife!
	stealthkill
	{
		dropitem ammo_9mm_small
		
		trigger player stealth_achievement
	}

	death
	{
		trigger dsound nazi1b_kill
	}
}

// Guy on patrol

nazi1c
{
	attributes
	{
		fov 110 		// Default: 240 Range 1 ? 360

		aim_skill 0.5 		// Default: 0.5 Range: 0.0 ? 1.0 (specific targets)
		aim_accuracy 0.1 	// Default: 0.5 Range: 0.0 ? 1.0 (accuracy)
		attack_skill 0.5	// Default: 0.75 Range: 0.0 ? 1.0 (weaponry tactics 'grenades VS. machine gun' etc.)

		reaction_time 0.2	// Default: 0.5 Range: 0.0 ? 1.0 (seconds)

		attack_crouch 0.4	// Default: 0.4 Range: 0.0 ? 1.0 (frequency)
		idle_crouch 0.0		// Default: 0.0 Range: 0.0 ? 1.0 (frequency)

		aggression 0.8		// Default: 0.5 Range: 0.0 ? 1.0 (charging)
		tactical 0.6		// Default: 0.8 Range: 0.0 ? 1.0 (using enviroment for protection)
		camper 0.3		// Default: 0.0 Range: 0.0 ? 1.0 (camping abilities)

		alertness 12000		// Default: 16000 Range: 0 ? 999999 (sight distance in pixel units)
		starting_health 20	// Default: 100 Range: 0 ? 99999 (spawn health)

		hearing_scale 1.0	// Default: 1.0 Range: 0.0 ? 10 (hearing)

		inner_detection_radius 384 // (detection of things like bullet impacts within the range will affect the AI, in pixel units)

	}

	spawn
	{
		accum 0 set 0 // 1 = Is alert

		takeweapon all
		setammo ammo_grenades 0
		setammo ammo_9mm 999
		giveweapon weapon_luger
		selectweapon weapon_luger

		statetype alert

		trigger nazi1c patrol
	}

	trigger spotted
	{
		accum 0 abort_if_not_equal 0
		accum 0 set 1

		trigger player musicmoving
		trigger dsound nazi1c_live

		playsound MiscHalt
		wait 250 player
		clearanim
		attrib fov 240
		resetscript
	}

	trigger patrol
	{
		walktomarker nazi1c_spot0 nostop
		accum 0 abort_if_not_equal 0
