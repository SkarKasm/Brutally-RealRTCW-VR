// Guy who shoots behind pottery stand

nazi1d
{
	attributes
	{
		aim_accuracy 0.7
		aim_skill 0.8
		reaction_time 0.2
		starting_health 50
		camper 0.2
		fov 240
	}

	spawn
	{
		// spotted
		accum 0 set 0

		takeweapon all
		
		#if g_ee_earlyWeapons <= 0
		giveweaponfull weapon_luger
		selectweapon weapon_luger
		#endif
		
		#if g_ee_earlyWeapons >= 1
		giveweaponfull weapon_mp40
		selectweapon weapon_mp40
		#endif
		
		statetype alert

		wait forever 0 nazi1d_fire
	}

	enemysight
	{
		accum 0 abort_if_not_equal 0
		playsound MiscHuh2
		trigger nazi1d spotted
	}

	bulletimpactsound
	{
		// check if already spotted
		accum 0 abort_if_not_equal 0

		playsound MiscHuh2
		trigger nazi1d spotted
	}

	trigger spotted
	{
		accum 0 abort_if_not_equal 0
		accum 0 set 1
		
		trigger player musicmoving
		trigger civ1 runback

		playsound MiscHalt
		wait 5

		fireattarget nazi1d_fire 2400
		wait 10
		attrib aim_accuracy 0.3
		trigger nazi1d cover
	}

	trigger cover
	{
		runtomarker nazi1d_spot1 nostop
		runtomarker nazi1d_spot2 nostop
		resetscript
		attack player
		runtomarker nazi1d_spot3 nostop
	}

	// This will be called when BJ kills me by stabbing me in the back with a knife!
	stealthkill
	{
		dropitem ammo_9mm_small
		
		trigger player stealth_achievement
	}

	death
	{
		trigger dsound nazi1d_kill
	}
}


// Civilian steps that steps outside only to run back when nazi1d shoots

civ1
{
	attributes
	{
		fov 10
		running_speed 370
		starting_health 1
		hearing_scale 0.0
		alertness 0
		inner_detection_radius 1
	}

	spawn
	{
		accum 0 set 0 // has run
		knockback off
		takeweapon all
		nosight 99999
	}

	trigger runback
	{
		accum 0 abort_if_not_equal 0
		accum 0 set 1
		nosight 99999
		playsound civ1_talk
		runtomarker civ1_spot1 nostop
		trigger civdoor1a close
		alertentity kill_civ1
	}
	death
	{
		missionfailed 2 1
	}

}

