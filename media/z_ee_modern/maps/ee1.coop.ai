// PS2

nazi2
{
	attributes
	{
		fov 90
		aim_skill 0.2
		aim_accuracy 0.2
		attack_skill 0.2
		reaction_time 0.4
		camper 1
		alertness 10000
		starting_health 15
		hearing_scale 0.4
		inner_detection_radius 384
	}

	spawn
	{
		accum 0 set 0
		takeweapon all
		setammo ammo_grenades 0
		setammo ammo_9mm 999
		giveweapon weapon_luger
		selectweapon weapon_luger
	}

	trigger face_90
	{
		facetargetangles n2spot1
		trigger nazi2 idle
	}

	trigger idle
	{
		playanim working_with_tools both
		trigger nazi2 idle
	}

	enemysight
	{
		resetscript
		playsound blank
		attack player
		wait forever 0
	}

	bulletimpact
	{
		resetscript
		playsound blank
		attack player
		wait forever 0
	}

	inspectsoundstart
	{
		resetscript
		playsound blank
		attack player
		wait forever 0
	}

	death
	{
		trigger dsound nazi1f_kill
		trigger nazi1g go
	}
}
