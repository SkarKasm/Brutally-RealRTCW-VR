		trigger nazi3a go
	}

	trigger go
	{
		runtomarker nazi3a_spot1 nostop
		runtomarker nazi3a_spot2 nazi3a_fire
		facetargetangles nazi3a_spot3
		runtomarker nazi3a_spot3
		playsound MiscStopHim
		wait 200
		trigger nazi3a shoot
	}

	trigger shoot
	{
		wait forever 0
		resetscript
	}

	// This will be called when BJ kills me by stabbing me in the back with a knife!
	stealthkill
	{
		dropitem ammo_9mm_small
		
		trigger player stealth_achievement
	}

	death
	{
		// alertentity nazi3a_deathcheck
		trigger dsound nazi3a_kill
		trigger nazi3cc go
	}
}

// Radio nazi

nazi3b
{
	attributes
	{
		fov 160 		// Default: 240 Range 1 ? 360

		aim_skill 0.5 		// Default: 0.5 Range: 0.0 ? 1.0 (specific targets)
		aim_accuracy 0.2 	// Default: 0.5 Range: 0.0 ? 1.0 (accuracy)
		attack_skill 0.5	// Default: 0.75 Range: 0.0 ? 1.0 (weaponry tactics 'grenades VS. machine gun' etc.)

		reaction_time 0.7	// Default: 0.5 Range: 0.0 ? 1.0 (seconds)

		attack_crouch 0.4	// Default: 0.4 Range: 0.0 ? 1.0 (frequency)
		idle_crouch 0.0		// Default: 0.0 Range: 0.0 ? 1.0 (frequency)

		aggression 0.5		// Default: 0.5 Range: 0.0 ? 1.0 (charging)
		tactical 0.5		// Default: 0.8 Range: 0.0 ? 1.0 (using enviroment for protection)
		camper 0.3		// Default: 0.0 Range: 0.0 ? 1.0 (camping abilities)

		alertness 10000		// Default: 16000 Range: 0 ? 999999 (sight distance in pixel units)
		starting_health 20	// Default: 100 Range: 0 ? 99999 (spawn health)

		hearing_scale 1.0	// Default: 1.0 Range: 0.0 ? 10 (hearing)

		inner_detection_radius 384 // (detection of things like bullet impacts within the range will affect the AI, in pixel units)

	}

	spawn
	{
		accum 0 set 0 // alerted
		accum 1 set 0 // sound

		setammo ammo_grenades 0
		takeweapon all

		wait 50

		trigger nazi3b sound1
	}

	trigger relaxed
	{
		accum 0 abort_if_not_equal 0
		playanim tunning_radio both
		clearanim
		facetargetangles nazi3b_spot1
		resetscript

	}

	trigger sound1
	{
		accum 1 abort_if_not_equal 0
		accum 1 set 1

		clearanim
		playsound nazi_ee1_2a

		trigger nazi3b relaxed
	}

	trigger stoptalk
	{
		accum 1 set 1
		playsound blank
	}

	trigger alert
	{
		accum 0 abort_if_not_equal 0
		accum 0 set 1

		trigger nazi3b stoptalk

		trigger dsound nazi3b_live
		trigger player musicmoving

		clearanim
		giveweapon weapon_luger
		setammo ammo_9mm 999
		selectweapon weapon_luger
		wait 250 player
		resetscript
	}

	enemysight
	{
		trigger nazi3b alert
	}

	bulletimpact
	{
		trigger nazi3b alert
	}

	inspectsoundstart
	{
		deny
	}

	death
	{
		trigger dsound nazi3b_kill
	}
}

