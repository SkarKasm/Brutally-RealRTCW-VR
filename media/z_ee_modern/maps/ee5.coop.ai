peon
{
	attributes
	{
		fov 1
		starting_health 1337
		alertness 3
		hearing_scale 0.1
		aim_skill 0.1
		aim_accuracy 0.1
		attack_skill 0.1
		camper 0.1
		aggression 0.1
	}

	spawn
	{
		statetype relaxed
		explicit_routing on
		takeweapon all
		headlook off
		//wait forever 0 c_target1
	}

	trigger start
	{
		statetype relaxed
		walktomarker peon_start
		wait 10
		facetargetangles peon_start
		// Do stuff, look busy
	}

	trigger face_helga
	{
		facetargetangles peon_look
	}

	trigger talk1
	{
		playsound peon_talk1	// “I’m just finishing translating the symbols that we found yesterday”
	}

	trigger talk2
	{
		playsound peon_talk2	// “Mien Director, we are archeologists not a demolition team. If you want us to find your ‘object’ you’ll have to trust our methods”
	}

	trigger talk3
	{
		playsound peon_talk3	// “I think I have located the ‘object’”
	}

	trigger talk4
	{
		playsound peon_talk4	// “We must be careful not to disturb the tombs!”
	}

	trigger talk5
	{
		playsound peon_talk5	// “It is written that they are protected by a terrible curse. Only.. (Interrupted)”
	}

	trigger talk6
	{
		playsound peon_talk6	// “Please mien director, if we are not careful…”
	}

	trigger talk7
	{
		playsound peon_talk7	// “As you wish.”
	}
}

