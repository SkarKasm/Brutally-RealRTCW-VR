//AI Scripting
//Map: ee5
//Last edited by: Scan, Nov 6'th (2003), William Faure (2026)
// Note:
// [DONE] - Don't add/change without notice (except cinematics)

player
{
	// COOP: level start, run once from game_manager's spawn (maps/ee5.coop.script). It holds what
	// RealRTCW runs for its single player in "spawn", "playerstart" and "trigger playgame".
	trigger coopstart
	{
		globalaccum 0 set 0 // Elevator Passage Flag
		globalaccum 1 set 0 // Cinematic Interrupt
		globalaccum 2 set 0 // Music
		globalaccum 3 set 0 // button work
		globalaccum 4 set 0 // objective 2
		globalaccum 5 set 0 // bound
		globalaccum 6 set 0 // objectives done
		globalaccum 7 set 0 // last nazi killed for objective

		cvar g_episode 1
		objectivesneeded 2
		
		numsecrets 3
		
		//

		abort_if_loadgame
		// COOP: no briefing screen, the level music starts at once
		// (SP: l_briefing_1 / l_theme in spawn, then "mu_fade 0 1500" + "mu_queue sound/music/m_stealth" in playerstart)
		mu_start sound/music/m_stealth
		
		#if cg_drawSubtitles <= 0 cin_play ee5.webm #endif
		#if cg_drawSubtitles >= 1 cin_play ee5_sub.webm #endif
		
		#if g_reinforce >= 2 alertentity reinforce_leet1 #endif
		#if g_reinforce >= 2 alertentity reinforce_bg1 #endif
		#if g_reinforce >= 2 alertentity reinforce_bg2 #endif
		#if g_reinforce >= 2 alertentity reinforce_v1 #endif
		
		//trigger player crypt_cine1		//CGC- no old cine
		trigger counter1 cleanup


		//trigger elevator liftdown		//CGC- get that elevator down there!
		//trigger counter1 cleanup2		//CGC- cleanup after cine
	}

	// COOP: every player, on each (re)spawn: RealRTCW's "applyloadout ee5"
	// (loadouts/loadouts_campaign.loadout) written with co-op actions ("setclip ... full" -> max clip)
	spawn
	{
		giveweapon weapon_knife
		
		giveweapon weapon_colt
		setclip weapon_colt 8
		#if g_vanilla_guns <= 0 setammo ammo_45cal 31 #endif
		#if g_vanilla_guns >= 1 setammo ammo_45cal 32 #endif
		
		#if g_newInventory <= 0
		giveweapon weapon_luger
		setclip weapon_luger 8
		giveweapon weapon_mauserrifle
		setclip weapon_mauserrifle 10
		setammo ammo_792mm 8
		#endif
		
		giveweapon weapon_mp40
		setclip weapon_mp40 32
		setammo ammo_9mm 128
		
		setammo ammo_grenades 2
		
		selectweapon weapon_mp40
		
		giveinventory key_binocs
	}

	// COOP: in co-op this runs on every client spawn; the level start is "trigger coopstart"
	playerstart
	{
	}

	// This trigger will be called when the player actually hits the changelevel trigger,
	// AND he has found all the secrets.  Give him a cookie!
	trigger endmap_bonus
	{
		// COOP-OFF (endmap_bonus is never called in co-op): printbonus ee5
		// COOP-OFF (endmap_bonus is never called in co-op): giveammo ammo_grenades_american // giveinventory ammo_grenades_american
	}
	
	trigger checkpoint // Antechamber
	{
		// COOP-OFF (SP save/bonus): savecheckpoint
	}

///////////////////////////////////////////////////
// Achievements
	
	trigger achievement1
	{
		// COOP-OFF (SP achievement): achievement_eeChallenge // Clear the antechamber’s great room within 15 seconds or less in the Ritual Chamber
	}
	
	trigger stealth_achievement
	{
		// COOP-OFF (SP achievement): globalaccum 3 abort_if_greater_than 5
		// COOP-OFF (SP achievement): globalaccum 3 inc 1
		// COOP-OFF (SP achievement): globalaccum 3 abort_if_not_equal 5
		// COOP-OFF (SP achievement): achievement_eeStealth // Perform 5 rewarded stealth kills in a single playthrough
	}

///////////////////////////////////////////////////
// Secrets

	trigger secret1
	{
		foundsecret
		
		// COOP-OFF (SP achievement): globalaccum 0 inc 1
	}

	trigger secret2
	{
		foundsecret
		
		// COOP-OFF (SP achievement): globalaccum 0 inc 1
	}

	trigger secret3
	{
		foundsecret
		
		// COOP-OFF (SP achievement): globalaccum 0 inc 1
	}

///////////////////////////////////////////////////
// Ojectives

	// Find an entrance to the Tombs
	trigger obj_1
	{
		objectivemet 1
		globalaccum 6 inc 1
		
		#if fs_ee_wolf2_sound >= 1 mu_play sound/ui/objective_new4.wav #endif
		
		#if g_reinforce >= 2 alertentity reinforce_leet5 #endif
		
		trigger game_manager objective1
	}

	// Gain access to the lower Tombs
	trigger obj_2
	{
		globalaccum 4 abort_if_not_equal 0

		globalaccum 4 set 1

		// alert objective check brush
		objectivemet 2
		globalaccum 6 inc 1
		
		#if fs_ee_wolf2_sound >= 1 mu_play sound/ui/objective_new4.wav #endif
		
		trigger game_manager objective2
		
		#if g_reinforce >= 1
		alertentity nazi4
		alertentity removehurt // elevator_hurt
		#endif
		
		trigger elevator liftup
	}

	// triggered by objective check brush
//	trigger obj_endfake
//	{
//		cvar g_level_was_selected 0
//		
//		changelevel ee6 persistent
//	}


///////////////////////////////////////////////////
// Misc

	trigger enable_elevator // PS2, added by William Faure
	{
//		globalaccum 0 abort_if_not_equal 8	// useless, quoted out by William Faure
		wait 2000
		alertentity obj_enable
	}

	trigger endmap
	{
		trigger game_manager checkexit // COOP: game_manager (ee5.coop.script) checks objectives 1 and 2
	}

	trigger exitlevel
	{
		// COOP: objectives are checked by game_manager (ee5.coop.script); SP: "globalaccum 6 abort_if_not_equal 2"
		globalaccum 6 set 0
		
		// COOP-OFF (SP achievement): globalaccum 1 inc 1
		
		// COOP-OFF (SP achievement): if g_gameskill >= 3 globalaccum 2 inc 1 endif
		
		#if g_ee_progress == 4 cvar g_ee_progress 5 #endif
		
		cvar g_level_was_selected 0
		
		changelevel ee6 persistent
		//wait 200
		//trigger elevator liftdown
	}

	// obsolete
	trigger b_enable
	{
		globalaccum 3 abort_if_not_equal 0

			globalaccum 3 set 1
	}

	// obsolete
	trigger b_disable
	{
		globalaccum 3 abort_if_not_equal 1

			globalaccum 3 set 0
	}

///////////////////////////
// Music

	// Upbeat - Moving (rolling)
	trigger musicmoving
	{
		globalaccum 2 abort_if_equal 7
		globalaccum 2 set 7
		//mu_stop 3000
		mu_fade 0 500
		mu_queue sound/music/m_moving
	}
	// Calm - Sneaky (lower  slower pace)
	trigger musicstealth
	{
		globalaccum 2 abort_if_equal 5
		globalaccum 2 set 5
		//mu_stop 3000
		wait 1500
		mu_fade 0 500
		mu_queue sound/music/m_stealth
	}
	// Calm - After Battle (after action is over sorta)
	trigger musicgrave
	{
		globalaccum 2 abort_if_equal 4
		globalaccum 2 set 4
		//mu_stop 3000
//		wait 1500
		mu_fade 0 500
		mu_queue sound/music/m_grave
	}
	// Moderate - Anticipation (flat with no action)
	trigger musicmission
	{
		globalaccum 2 abort_if_equal 1
		globalaccum 2 set 1
		//mu_stop 3000
		wait 1500
		mu_fade 0 500
		mu_queue sound/music/m_mission
	}
	// Moderate -  Uneasyness (throbbing and bumpy)
	trigger musictension
	{
		globalaccum 2 abort_if_equal 2
		globalaccum 2 set 2
		//mu_stop 3000
		mu_fade 0 500
		mu_queue sound/music/m_tension
	}
	// Moderate - Drum Rolls
	trigger musicdrums
	{
		globalaccum 2 abort_if_equal 3
		globalaccum 2 set 3
		//mu_stop 3000
		wait 1500
		mu_fade 0 500
		mu_queue sound/music/m_drums
	}
	// Upbeat - Action (duh duh duh duh)
	trigger musicaction
	{
		globalaccum 2 abort_if_equal 6
		globalaccum 2 set 6
		//mu_stop 3000
		mu_fade 0 1000
		mu_queue sound/music/m_action
		
		trigger game_manager achievement1_count // Clear the antechamber’s great room within 30 seconds or less in the Ritual Chamber
	}
	// Upbeat - Military (drums, tromping around)
	trigger musicsituation
	{
		globalaccum 2 abort_if_equal 8
		globalaccum 2 set 8
		//mu_stop 3000
		mu_fade 0 500
		mu_queue sound/music/m_situation
	}

/////////////////////////////////////////////
// SECTION 1 - Ruins Entrance Passage
/////////////////////////////////////////////

// Opening startup

	trigger start
	{
		// activate the guards

		alertentity nazi1a
		alertentity nazi1b
		wait 5
		alertentity merc1
		wait 5
		trigger nazi1a pace
	}


// Emergency rush handlers

	trigger nazi1a_trig
	{
		trigger nazi1b kill
		trigger merc1 go
	}

	trigger nazi1b_trig
	{
		trigger nazi1b kill
		trigger merc1 go
	}


// Back Passage

	trigger passage
	{
		// activate the guards

		alertentity nazi1bb
		alertentity nazi1bc
		wait 5
	}


// Start nazi fire routine coming out of passage

	trigger passage_out
	{
		trigger nazi1bb spotted
		
		#if g_reinforce >= 2 alertentity reinforce_leet2 #endif
	}

	// Emergency Rush Handler (cuts off shooting routine)

	trigger passage_nazi1bbrun
	{
		trigger nazi1bb cover
	}

	// Make rocks fall for atmosphere

	trigger passage_rock1
	{
		alertentity p_rock1
		
		#if g_reinforce >= 2 alertentity reinforce_leet3 #endif
		#if g_reinforce >= 2 alertentity reinforce_leet4 #endif
		#if g_reinforce >= 2 alertentity reinforce_bg3 #endif
	}

	// Test which way the player takes around back of tomb block
	// act accordingly (only one can be triggered)

	trigger passage_alertbc1
	{
		trigger nazi1bc alert1
	}

	trigger passage_alertbc2
	{
		trigger nazi1bc alert2
	}


// Fall down hole

	// Dust rises from fall

	trigger dust_effect
	{
		alertentity effect_upon_landing // restored by William Faure
		alertentity effect_rumble1
		
		#if g_reinforce >= 2 alertentity reinforce_bg4 #endif
	}


// Path to Big Room events

	trigger action1a
	{
		#if g_reinforce >= 1
		alertentity nazi1c
		alertentity nazi1cc
		#endif
	}

	trigger action1b
	{
		#if g_reinforce >= 1 trigger nazi1c noise #endif
	}

/////////////////////////////////////////////
// SECTION 2 - Great Room / Challenge Scenario
/////////////////////////////////////////////

	trigger event_roomsetup
	{
		#if g_reinforce >= 2 alertentity reinforce_leet6 #endif
		#if g_reinforce >= 2 alertentity reinforce_bg7 #endif
		#if g_reinforce >= 2 alertentity reinforce_bg8 #endif
		#if g_reinforce >= 2 alertentity reinforce_v2 #endif
		
		alertentity nazi2			//CGC
		alertentity n1
		alertentity n2
		alertentity n3
		alertentity n4
		alertentity n5
		alertentity n6
		alertentity n7

		trigger nazi2 givesight
		wait 5
		trigger nazi2 go
	}


// Triggers to handle player rushing into offshoots.

	trigger event_enterbackroom
	{
		trigger n1 go
		trigger n3 go
		trigger n6 ready
		
		#if g_reinforce >= 2 alertentity reinforce_bg5 #endif
	}

	trigger event_entercheatpath
	{
		trigger n2 go
		trigger n5 go
	}

	trigger event_entersniperpath
	{
		trigger n7 ready
	}

	trigger event_enterdeadend
	{
		trigger n4 go
	}

// Challenge Events (does nothing now)

	trigger challenge_check
	{
		// increase dead count

		globalaccum 0 inc 1

		trigger player challenge_pass
	}

	trigger challenge_pass
	{
		// check if 7 have been killed

		globalaccum 0 abort_if_not_equal 5
		globalaccum 0 abort_if_not_equal 7
		globalaccum 0 set 0

		// trigger player obj_2
	}

// Cheat Passage Nazi Above Ladder

	trigger action2a
	{
		alertentity nazi3a
		
		#if g_reinforce >= 2 alertentity reinforce_bg6 #endif
	}

/////////////////////////////////////////////
// CINEMATIC SCRIPT
/////////////////////////////////////////////

	trigger crypt_cine1
	{
		trigger counter1 cine1
	}

	trigger lockoff
	{
		lockplayer off
	}

	// main scene
	trigger alert_actors
	{
		alertentity nazi2
		alertentity cine_helga1
		alertentity cine_leet1
		alertentity cine_leet2
		alertentity peon
	}

	// down elevator
	trigger alert_actors2
	{
		alertentity cine_helga1a
		alertentity peon1a
		alertentity cine_leet2a
		wait 250
		alertentity cine_leet1a


	}

	trigger pancam
	{
		globalaccum 1 abort_if_not_equal 0
		startcam ee4_pancam
	}

	trigger pancam2a
	{
		globalaccum 1 abort_if_not_equal 0
		startcam ee4_pancam2a
	}

	trigger pancam2
	{
		globalaccum 1 abort_if_not_equal 0
		startcam ee4_pancam2
	}

	trigger peon_cam1
	{
		globalaccum 1 abort_if_not_equal 0
		startcam ee4_peon1
	}

	trigger peon_cam2
	{
		globalaccum 1 abort_if_not_equal 0
		startcam ee4_peon3
	}

	trigger helga_cam
	{
		globalaccum 1 abort_if_not_equal 0
		startcam ee4_cam_helga
	}

	trigger  helga_cam2
	{
		globalaccum 1 abort_if_not_equal 0
		startcam ee4_cam_helga2
	}

	trigger camera4
	{
		globalaccum 1 abort_if_not_equal 0
		startcam ee4_fincam
	}

	trigger camera5
	{
		globalaccum 1 abort_if_not_equal 0
		startcam ee4_fincam_fade
	}

	trigger camera6
	{
		globalaccum 1 abort_if_not_equal 0
		startcam ee4_cam6
	}

	trigger camera7
	{
		globalaccum 1 abort_if_not_equal 0
		startcam ee4_cam7
		wait 5000
	}

	trigger camerainterrupt
	{
		globalaccum 1 set 1
		stopcam
		trigger player lockoff
		trigger counter1 cleanup
	}

	trigger stop
	{
		stopcam
	}
}

/////////////////////////////////////////////
// CINEMATIC Support
/////////////////////////////////////////////

cine_helga1
{
	attributes
	{
		fov 1
		starting_health 1337
		alertness 3
		hearing_scale 0.1
		aim_skill 0.1
		aim_accuracy 0.1
		attack_skill 0.1
		camper 0.1
		aggression 0.1
	}

	spawn
	{
		statetype relaxed
		explicit_routing on
		takeweapon all
		headlook off
		//wait forever 0 c_target1
	}

	trigger getgoing
	{
		statetype relaxed
		walktomarker helga_start
		wait 900
		facetargetangles helga_start
	}

	trigger moveforward
	{
		walktomarker helga_start2
		facetargetangles peon_look
	}

	trigger talk1
	{
		playsound helga_talk1	// What do you have to report?"
	}

	trigger talk2
	{
		playsound helga_talk2	// Save your excuses!  You’ve had more than enough time to tear this place apart, and still you’re wasting time looking at symbols?!?”
	}

	trigger talk3
	{
		playsound helga_talk3	// “I only believe in results. And what results do you and your methods have for me?”
	}

	trigger talk4
	{
		playsound helga_talk4	// “Idiot!! Then what are you waiting for?!?”
	}

	trigger talk5
	{
		playsound helga_talk5	// “More feeble excuses? I don’t care about da tombs!”
	}

	trigger talk6
	{
		playsound helga_talk6	// “Silly superstitions don’t interest me professor, we shall retrieve it at once. I have a plane waiting to take me back to Castle Wolfenstein. Heir Himmler will be very pleased.”
	}

	trigger talk7
	{
		playsound helga_talk7	// “Enough! If you don’t wish to be sealed in one of your beloved tombs, you will take me to it at once.”
	}
}

