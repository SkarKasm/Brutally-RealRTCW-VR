		attack_crouch 0.4	// Default: 0.4 Range: 0.0 ? 1.0 (frequency)
		idle_crouch 0.0		// Default: 0.0 Range: 0.0 ? 1.0 (frequency)
		aggression 0.5		// Default: 0.5 Range: 0.0 ? 1.0 (charging)
		tactical 0.0		// Default: 0.8 Range: 0.0 ? 1.0 (protection)
		camper 0.2		// Default: 0.0 Range: 0.0 ? 1.0 (camping abilities)

		alertness 6000		// Default: 16000 Range: 0 ? 999999
		starting_health 25	// Default: 100 Range: 0 ? 99999 (spawn health)
