	{
		trigger nazi2 alert
	}

	bulletimpactsound
	{
		trigger nazi2 alert
	}

	trigger go
	{
		statetype alert
	}

	trigger alert
	{
		accum 0 abort_if_not_equal 0
		accum 0 set 1

		trigger player musicaction
