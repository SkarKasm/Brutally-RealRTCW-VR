/////////////////////////////////////////////
// SECTION 1 - Ruins Entrance Passage
/////////////////////////////////////////////

merc1
{
	attributes
	{
		aim_accuracy 0.3
		starting_health 25
		aggression 0.8
		reaction_time 0.3
		tactical 0.3
		fov 220
	}

	spawn
	{
		accum 0 set 0 // spotted
		accum 1 set 0 // go

		setammo ammo_9mm 999
		selectweapon weapon_mp40
		
		#if g_ee_skinMercenary == 0
		wait 10
		#endif
		
		#if g_ee_skinMercenary == 1
		trigger self* skin
		#endif
		
		#if g_ee_skinMercenary >= 2
		accum 2 random 2
		accum 2 abort_if_equal 0
		trigger self* skin
		#endif
	}
		
	trigger skin
	{
		changeaihead default
		changeaiskin merc2/merc2
		changeaihead merc2
	}

	trigger go
	{
		accum 1 abort_if_not_equal 0
		accum 1 set 1

		statetype alert
		runtomarker merc1_spot1 nostop
		runtomarker merc1_spot2	nostop
		playsound merc_die
		clearanim
		resetscript
		runtomarker merc1_spot3
	}

	inspectfriendlycombatstart
	{
		deny
	}

	enemysight
	{
		clearanim
		trigger merc1 spotted
	}

	trigger spotted
	{
		accum 0 abort_if_not_equal 0
		accum 0 set 1

		trigger player musicmoving
		attack player
		trigger merc1 go
	}
	bulletimpact
	{
		trigger merc1 spotted
	}
	bulletimpactsound
	{
		trigger merc1 spotted
	}

	// This will be called when BJ kills me by stabbing me in the back with a knife!
	stealthkill
	{
		dropitem ammo_grenades
		
		trigger player stealth_achievement
	}

	death
	{
		trigger dsound merc1_kill
	}
}

nazi1a
{
	attributes
	{
		aim_accuracy 0.3
		starting_health 40
		aggression 0.6
		reaction_time 0.3
		camper 0.2
		tactical 0.8
		fov 110
	}

	spawn
	{
		// spotted check
		accum 0 set 0
		accum 1 set 0

		setammo ammo_9mm 999
		setammo ammo_grenades 0
		
		#if g_ee_skinMercenary <= 0
		wait 10
		trigger self* pace
		#endif
		
		#if g_ee_skinMercenary == 1
		trigger self* skin
		#endif
		
		#if g_ee_skinMercenary >= 2
		accum 2 random 2
		trigger self* skin_yes
		trigger self* skin_no
		#endif
	}
		
	trigger skin
	{
		changeaihead default
		changeaiskin merc2/merc1
		changeaihead merc1
		
		// spawn
		wait 10
		trigger self* pace
	}
		
	trigger skin_yes
	{
		accum 2 abort_if_not_equal 1
		
		trigger self* skin
	}
		
	trigger skin_no
	{
		accum 2 abort_if_not_equal 0
		
		// spawn
		wait 500
		trigger self* pace
	}

	trigger pace
	{
		accum 1 abort_if_not_equal 0
		accum 1 set 1

		explicit_routing on
		walktomarker nazi1a_spot1 nostop
		playsound Whistle1

		// make this guy move out from position
		trigger nazi1b awaken

		wait 600 nazi1b

		walktomarker		nazi1a_spot2 nostop
		walktomarker		nazi1a_spot2b nostop
		walktomarker		nazi1a_spot3 nostop
		facetargetangles	nazi1a_spot3b
		walktomarker		nazi1a_spot3b nostop
		walktomarker		nazi1a_spot4 nostop
		facetargetangles	nazi1a_spot1
		wait 300
		trigger			nazi1a pace

	}

	inspectfriendlycombatstart
	{
		deny
	}

	enemysight
	{
		trigger nazi1a spotted
	}

	trigger spotted
	{
		// check if called from nazi1b
		accum 0 abort_if_not_equal 0
		accum 0 set 1

		trigger player musicmoving

		explicit_routing off
		clearanim
		statetype alert
		trigger nazi1b spotted
		trigger nazi1a cover
	}

	trigger clear
	{
		clearanim
		attrib fov 240
		resetscript
	}
	trigger cover
	{
		resetscript
	}
	bulletimpact
	{
		trigger nazi1a clear
	}
	bulletimpactsound
	{
		trigger nazi1a clear
	}

	// This will be called when BJ kills me by stabbing me in the back with a knife!
	stealthkill
	{
		dropitem ammo_9mm_small
		
		trigger player stealth_achievement
	}

	death
	{
		trigger dsound nazi1a_kill
	}
}

nazi1b
{
	attributes
	{
		aim_accuracy 0.2
		starting_health 45
		camper 0.2
		fov 70
		inner_detection_radius 256
		aggression 0.7
		alertness 15000
	}

	spawn
	{
		// spot check
		accum 0 set 0

	//	takeweapon all

	//	giveweapon weapon_mp40
		setammo ammo_9mm 999
		setammo ammo_grenades 0

