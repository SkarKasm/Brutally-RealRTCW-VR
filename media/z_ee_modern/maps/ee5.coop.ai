//

nazi1cc
{
	attributes
	{
	}

	spawn
	{		
		takeweapon all
		giveweapon weapon_luger
		selectweapon weapon_luger
		setammo ammo_grenades 0
		setammo ammo_9mm 60
		
		#if g_ee_skinMercenary <= 0
		trigger self* skin
		#endif
		
		#if g_ee_skinMercenary == 1
		trigger self* start
		#endif
		
		#if g_ee_skinMercenary >= 2
		accum 0 random 2
		trigger self* skin_yes
		trigger self* skin_no
		#endif
	}
	
	trigger skin
	{		
		changeaihead default
		
		accum 1 random 2
		trigger self* skin1
		trigger self* skin2
	}
	
	trigger skin_yes
	{
		accum 0 abort_if_not_equal 1
		
		trigger self* skin
	}
	
	trigger skin_no
	{
		accum 0 abort_if_not_equal 0
		
		// spawn
		trigger self* start
	}
	
	trigger skin1
	{
		accum 1 abort_if_not_equal 0
		
		changeaiskin merc/black
		changeaihead black
		
		trigger self* start
	}
	
	trigger skin2
	{
		accum 1 abort_if_not_equal 1
		
		changeaiskin merc/red
		changeaihead red
		
		trigger self* start
	}
	
	trigger start
	{
		wait 200
		trigger nazi1c pace
	}

	trigger go
	{
		statetype alert
		runtomarker nazi1cc_spot1
	}

	enemysight
	{
		clearanim
		wait 100 player
		resetscript
	}

	death
	{
	}
}

