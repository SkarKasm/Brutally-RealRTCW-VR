		trigger nazi1b pace
	}

	trigger pace
	{
		wait 200
		resetscript
	}

	inspectfriendlycombatstart
	{
		deny
	}

	// nazi strolls up toward you
	trigger awaken
	{
		explicit_routing on
		walktomarker nazi1a_spot2b nostop
		walktomarker nazi1a_spot3 nostop
		facetargetangles nazi1a_spot3b
		walktomarker nazi1a_spot3b nostop
		walktomarker nazi1a_spot4 nostop
		facetargetangles nazi1a_spot1
		walktomarker nazi1a_spot1 nostop
		walktomarker nazi1a_spot2 nostop
		resetscript
	}

	enemysight
	{
		trigger nazi1b spotted
	}

	trigger spotted
	{
		// check if called from nazi1a
		accum 0 abort_if_not_equal 0
		accum 0 set 1

		trigger player musicmoving

		explicit_routing off
		trigger nazi1a spotted
		clearanim
		playsound MiscKillHim
		selectweapon weapon_mp40
		wait 250
		trigger nazi1b kill
	}
	trigger clear
	{
		clearanim
		attrib fov 240
	}
	bulletimpact
	{
		trigger nazi1b clear
	}
	bulletimpactsound
	{
		trigger nazi1b clear
	}

	trigger kill
	{
		attack player
		resetscript
	}

