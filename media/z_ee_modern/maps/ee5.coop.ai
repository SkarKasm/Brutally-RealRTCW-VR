		fov 70
		inner_detection_radius 512
		aggression 0.7
		alertness 10000
	}

	spawn
	{
		accum 0 set 0 // spotted enemy
		accum 1 set 0 // called backup
	//	takeweapon all

		statetype relaxed
	//	giveweapon weapon_mp40
		setammo ammo_grenades 0
		setammo ammo_9mm 999
	//	selectweapon weapon_mp40
		nosight 99999
		trigger nazi2 pace
	}

	trigger givesight
	{
		sight
	}

