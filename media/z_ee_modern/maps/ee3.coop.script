burned_tailgate // PS2
{
	spawn
	{
		gotomarker tg1 1000
	}

	trigger go
	{
		gotomarker tg2 1500 accel
		gotomarker tg3 1700 accel wait
		gotomarker tg4 1900 accel wait
		alertentity go_shack
		gotomarker tg5 2000 deccel wait
		trigger burned_tailgate land
	}

	trigger land
	{
		faceangles 90 180 -355 1
		gotomarker tg6 2000
	}
}

///////////////////////////////
// The first truck in courtyard
///////////////////////////////

t1body
{
	spawn
	{
		accum 0 set 0

		wait 150
		gotomarker t1_spot1 100
		faceangles 0 45 0 gototime
	}

	trigger begin2
	{
		playsound sound/world/shift_01.wav looping

		// mid bracket
		trigger t1bwheels begin2
		trigger t1lwheel begin2
		trigger t1rwheel begin2
	//	trigger t1tail begin2
	//	trigger t1rwheel strait
	//	trigger t1lwheel strait

		gotomarker t1_spot2 120

		gotomarker t1_spot3 120 wait
		gotomarker t1_spot4 120 wait
		gotomarker t1_spot5 80 wait
		gotomarker t1_spot6 80 wait
		alertentity nazi3b
		stopsound

		trigger t1bwheels stop2
		trigger t1lwheel stop2
		trigger t1rwheel stop2

		gotomarker t1_spot7 60 deccel wait
		stopsound
	}
}

