		gotomarker t2_spot4 500 wait // 250 wait
		gotomarker t2_spot5 800 wait // 400 wait
		gotomarker t2_spot6 800 wait // 400 wait
		gotomarker t2_spot7 800 deccel wait // 400 deccel wait
//	//	trigger player take_away // simply unsupported, removed by William Faure // already called by 't2body/begin2'
		gotomarker t2_spot8 9999 // workaround, added by William Faure
	}
}

t2bwheels
{
	spawn
	{
		wait 100
		attachtotag t2body tbwheels
	}

	trigger begin2
	{
		playsound sound/world/shift_01.wav looping
		wait 5
		playanim 0 10 looping forever
		stopsound
	}

	trigger stop2
	{
		playsound sound/world/idle_01.wav
		playanim 0 5 500
	}
}

