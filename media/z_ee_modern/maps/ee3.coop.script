/////////////////////////////////////////////
// Secret3Door
/////////////////////////////////////////////

secret3door
{
	spawn
	{
		wait 1000
		faceangles 0 0 0 100
	}

	trigger open
	{
		wait 100
		playsound sound/world/creak_01.wav
		faceangles 95 0 0 1500
	}

	trigger close
	{
		wait 100
		faceangles 0 0 0 1500
	}
}

/////////////////////////////////////////////
// doorfall
/////////////////////////////////////////////

doorfall
{
	spawn
	{
		accum 0 set 0 // can open

		// wait 1000
		// faceangles 0 90 0 100
	}

	trigger cantopen
	{
		accum 0 set 1
	}

	trigger fall
	{
		accum 0 abort_if_not_equal 0
		accum 0 set 1

		wait 150
		playsound sound/movers/doors/door8_open.wav
		faceangles 0 -90 0 450 wait
		playsound sound/movers/doors/door8_endc.wav

		// old fall
		// playsound sound/movers/doors/door5_kicked.wav
		// faceangles 90 0 0 800
		// // playsound sound/movers/elevators/elev2_crash.wav
		// alertentity playdoorfall
	}
}

/////////////////////////////////////////////
// radio button
/////////////////////////////////////////////
rbutton
{
	spawn
	{
		accum 0 set 0
	}

	trigger down
	{
		accum 0 abort_if_not_equal 0
		accum 0 set 1

			gotomarker rbutton_spot1 100
	}
}

