/////////////////////////////////////////////
// Cinematic
/////////////////////////////////////////////

cine_counter
{
	spawn
	{
		accum 0 set 0 // interrupt check (not used anymore)
		accum 1 set 0 // clean1 called
		accum 2 set 0 // clean2 called
	}

	trigger cine_setup
	{
		// scene has two elite guards waiting down by the exit port cullis
		// helga and the scientist are by the carsaphogus
		alertentity cine_leet1
		alertentity cine_leet2
		alertentity cine_helga1
		alertentity peon

		trigger fake_port reset

		wait 100

		// zoom in on nazi
		trigger player cam1

		trigger cine_counter cine_dialogue
	}

	trigger cine_dialogue
	{
		accum 1 abort_if_not_equal 0

		wait 6000

		// this is the cophasgus :O
		trigger peon talk1
		wait 2250

		// focus on helga as she talks,
		trigger player cam2
		trigger cine_helga1 talk1
		wait 2000

		// focus back on scientist
		trigger player cam2a
		wait 500

		// show him again, but..
		trigger peon talk2
		wait 1000

		// helga again
		trigger player cam2b
		trigger cine_helga1 talk2
		wait 1500

		// helga looks towards sophagus
		trigger cine_helga1 face_death
		wait 400

		// scientist looks towards sophagus
		wait 800

		trigger cine_helga1 walk_to_death

		trigger player cam3
		wait 1000
		trigger lid open
		wait 3000

		// heir himler will be very pleased
		trigger cine_helga1 talk3
		wait 1000

		wait 2000

		// new camera, no you musn't
		trigger player cam3a
		wait 500
		trigger peon talk3
	//	wait 1000
		wait 2000

		trigger cine_counter cine_dialogue2
	}

	trigger cine_dialogue2
	{
		accum 1 abort_if_not_equal 0

		trigger peon face_helga

		trigger player cam4
		wait 100
		trigger cine_helga1 face_death
		wait 500
		trigger cine_helga1 anim8
		wait 500
		trigger peon face_death

		wait 1000

		alertentity cine_rumble
		wait 1300

		trigger peon face_away
		trigger peon run_away
		trigger cine_leet1 alert

		// added new offset here
		wait 2000

		trigger cine_leet2 alert
		wait 700
		trigger cine_leet1 alert2
		wait 120
		trigger cine_leet2 alert2

		// wait 6400 total
		// rem'd 220

		// wait 2600
		wait 1800
		trigger player cam5

		wait 2000
		alertentity nazi_scream3
		wait 2450
		trigger fake_port down

		wait 2000 // new no disappear

		trigger player lift_crash
		trigger cine_counter clean1


		// add if end added again
		//	trigger cine_counter cine_end
	}

	trigger cine_end
	{
		accum 2 abort_if_not_equal 0
		wait 100

		alertentity cine_helga1a
		alertentity cine_leet1a
		alertentity cine_leet2a

		wait 100
		trigger player cam6
		wait 1500
		alertentity nazi_scream3

		trigger cine_helga1a turn
		wait 500

		trigger cine_leet1a turn
		wait 250

		trigger cine_leet2a turn
		trigger fake_port down //gate crashes down
		wait 750

		trigger player cam7
		wait 1000

		trigger cine_helga1a anim8
		wait 3000

		trigger player lift_crash

		wait 2500

		// cleanup second section
		trigger cine_counter clean2
	}

	trigger clean1
	{
		accum 1 abort_if_not_equal 0
		accum 1 set 1

		wait 1500
		alertentity cine_cleanup
		alertentity object_dissapear
		wait 2000
	}

	trigger clean2
	{
		accum 2 abort_if_not_equal 0
		accum 2 set 1

	// add if end added again
	//	alertentity cine_cleanup2
	//	alertentity object_dissapear
	//	wait 2000
	}

	trigger cine_cleanup_interrupted
	{

		trigger fake_port down
		trigger player lift_crash
		wait 2000
		trigger cine_counter clean1


	// add if end added again

	//	trigger cine_counter clean2
		trigger lid open

		accum 1 set 1
		accum 2 set 1

	}
}

lid
{
	spawn
	{
		accum 0 set 0 // has opened
	}

	trigger reset
	{
		gotomarker lid_spot1 300 wait
	}

	trigger open
	{
		accum 0 abort_if_not_equal 0
		accum 0 set 1

		gotomarker lid_spot1 10 wait
		playsound sound\scenaric\ee\ee6_lid_mover.wav
		wait 10
		gotomarker lid_spot2 10 wait
		wait 800
		gotomarker lid_spot3 40 accel wait
		gotomarker lid_spot4 200 accel wait
		gotomarker lid_spot5 350 accel wait

//		gotomarker lid_spot4 60 accel wait
//		gotomarker lid_spot5 120 accel wait
	}
}

fake_port
{
	spawn
	{
		gotomarker fake_port_3 3000 wait
	}

	trigger reset
	{
		gotomarker fake_port_3 3000 wait
	}

	trigger down
	{
		stopsound
		playsound sound\movers\doors\door6_loopc.wav looping
		gotomarker fake_port_1 200 accel wait
		playsound sound\movers\doors\door6_endc.wav
		gotomarker fake_port_2 160 deccel wait
		gotomarker fake_port_1 80 accel wait
		stopsound
	}
}

stoned
{
	spawn
	{

	}

	trigger reset
	{
		gotomarker stoned_open 300
	}


	trigger nrv_shake1
	{
		playsound ee6_rumble1
	}

	trigger nrv_shake2
	{
		playsound ee6_rumble2
	}

	trigger nrv_shake3
	{
		playsound ee6_rumble3
	}

	trigger close
	{
		playsound sound\scenaric\ee\lockdown.wav //looping
		gotomarker stoned_close 400 wait
		stopsound
		alertentity stonedoor_relay
		playsound sound\movers\doors\door3_locked.wav
	}

	trigger open
	{
		playsound sound\scenaric\ee\lockdown.wav //looping
		gotomarker stoned_open 50 wait
		stopsound
	}
}