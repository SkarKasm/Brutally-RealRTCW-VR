game_manager
{
	// COOP: added by the co-op authors (script_multiplayer "game_manager" in maps/ee6.ents).
	// Starts the level once for everyone and checks the objectives before the exit (objectives are shared).
	spawn
	{
		accum 0 bitreset 1 // objective 1
		accum 0 bitreset 2 // objective 2

		// COOP: RealRTCW's achievement flag moved from accum 0 to accum 1 (accum 0 holds the objective bits)
		accum 1 set 0 // achievement1

		trigger player coopstart // prevents late players affecting the game
	}

	trigger checkexit
	{
		accum 0 abort_if_not_bitset 1 // objective 1
		accum 0 abort_if_not_bitset 2 // objective 2

		trigger player exitlevel
	}
	
	trigger objective1
	{
		accum 0 bitset 1
	}
	
	trigger objective2
	{
		accum 0 bitset 2
	}

	// RealRTCW (SP achievements; harmless in co-op)

	trigger achievement1
	{
		accum 1 abort_if_equal 1
		
		trigger player achievement1 // Reach the last room without having triggered any of the traps across the level in the Tombs
	}

		trigger achievement1_fail
		{
			accum 1 set 1
		}
}

/////////////////////////////////////////////
// SECTION 1 - Drop Zone
/////////////////////////////////////////////

lift
{
	spawn
	{
	}

	trigger down
	{
		playsound sound/scenaric/ee/elevator_fall.wav
		gotomarker lift_start 5000 wait
		gotomarker lift_start2 110 accel wait
		gotomarker lift_speedup 100 accel wait
		alertentity effect_rumble
		trigger player dropdown_reset
		gotomarker lift_end 500 accel wait
		alertentity dust_on_crash
		alertentity rope
	}
}

// SPIKES

spike_trap
{
	spawn
	{
	}

	trigger reset
	{
		trigger spike_1s reset
		trigger spike_1n reset
		
	}

	trigger on
	{
//		#if fs_ee_ps2_maps >= 1 alertentity spikekill #endif
		
		trigger spike_1s out
		trigger spike_1n out
		
		
		wait 1500
		trigger spike_trap stop
	}

	trigger off
	{
		trigger spike_1s reset
		trigger spike_1n reset
		
	}

	trigger stop
	{
//		#if fs_ee_ps2_maps >= 1 alertentity spikekill #endif

		trigger spike_1s reset2
		trigger spike_1n reset2
		
	}
}

spike_1s
{
	spawn
	{
	}

	trigger reset
	{
		gotomarker 1s_in 400 wait
	}

	trigger reset2
	{
		
		playsound sound\movers\doors\door6_loopo.wav looping
		gotomarker 1s_in 5 wait
		stopsound
		playsound sound\movers\doors\door5_endc.wav
	}

	trigger out
	{
		playsound sound/scenaric/crypt2/spikes.wav
		gotomarker 1s_out 1000 wait
	}
}

