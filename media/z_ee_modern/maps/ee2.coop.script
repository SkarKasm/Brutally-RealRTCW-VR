/////////////////////////////////////////////
// Civilian Door Shutting
/////////////////////////////////////////////

civdoor1a
{
	spawn
	{
		wait 1000
		faceangles 0 90 0 100
	}

	trigger close
	{
		trigger civdoor1b close
		faceangles 0 0 0 300
		playsound sound/movers/doors/door4_endc.wav

	}

}

civdoor1b
{
	spawn
	{
		wait 1000
		faceangles 0 270 0 100
	}

	trigger close
	{
		faceangles 0 0 0 300
		wait 20
		playsound sound/movers/doors/door4_endc.wav

	}

}
/////////////////////////////////////////////
// Wagon Flipping Over
/////////////////////////////////////////////
wagon
{
	spawn
	{
	}

	trigger killcounter
	{
		accum 0 inc 1
		trigger wagon all_dead
	}

	trigger all_dead
	{
		// abort if less than 4 dead officers

		accum 0 abort_if_less_than 3


		trigger player action_roof
	}

	trigger reset
	{
		faceangles 0 45 0 100
	}

	trigger flip
	{
		// playsound sound/movers/doors/door6_open.wav
		gotomarker wagon_spot1 160
		faceangles 0 0 -90 gototime
	}

}

/////////////////////////////////////////////
// radio button
/////////////////////////////////////////////
rbutton
{
	spawn
	{
		accum 0 set 0
	}

	trigger down
	{
		accum 0 abort_if_not_equal 0
		accum 0 set 1

			gotomarker rbutton_spot1 100
	}
}