		inner_detection_radius 512 // (detection of things like bullet impacts within the range will affect the AI, in pixel units)
	}

	spawn
	{
		accum 0 set 0 // alerted
		accum 1 set 0 // speak

		takeweapon all

		setammo ammo_9mm 999
		setammo ammo_grenades 0
		#if g_ee_earlyWeapons <= 0 giveweaponfull weapon_luger #endif
		#if g_ee_earlyWeapons >= 1 giveweaponfull weapon_mp40 #endif

		// trigger nazi4a relaxed
	}

	trigger relaxed
	{
		playanim looking_over_table both forever
	}

	trigger sound1
	{
		accum 1 abort_if_not_equal 0

		clearanim
		playsound nazi_ee2_4a

		trigger nazi4a relaxed
	}


	trigger sound2
	{
		accum 1 abort_if_not_equal 0

		clearanim
		playsound nazi_ee2_4c

		trigger nazi4a relaxed
	}

	trigger stoptalk
	{
		accum 1 set 1
		playsound blank
	}

	trigger spotted
	{
		accum 0 abort_if_not_equal 0
		accum 0 set 1

		trigger nazi4a stoptalk
		trigger player musicaction

		clearanim
		attrib fov 240
		#if g_ee_earlyWeapons <= 0 selectweapon weapon_luger #endif
		#if g_ee_earlyWeapons >= 1 selectweapon weapon_mp40 #endif
		trigger player action4_preboom
		resetscript
	}

	trigger go
	{
		trigger nazi4a stoptalk

		#if g_ee_earlyWeapons <= 0 selectweapon weapon_luger #endif
		#if g_ee_earlyWeapons >= 1 selectweapon weapon_mp40 #endif
		clearanim
		attrib fov 240
		facetargetangles nazi4a_fire
		wait 800
		runtomarker nazi4a_spot1 nostop
		facetargetangles nazi4a_fire
		clearanim
		fireattarget nazi4a_fire 600
		resetscript
	}

	enemysight
	{
		trigger nazi4a spotted
	}

	statechange relaxed alert
	{
		deny
	}

	statechange query alert
	{
		deny
	}

	statechange relaxed combat
	{
		trigger nazi4a spotted
	}

	statechange query combat
	{
		trigger nazi4a spotted
	}

	inspectfriendlycombatstart
	{
		deny
	}

	bulletimpact
	{
		trigger nazi4a spotted
	}

	bulletimpactsound
	{
		trigger nazi4a spotted
	}

	// This will be called when BJ kills me by stabbing me in the back with a knife!
	stealthkill
	{
		dropitem ammo_9mm_small
		
		trigger player stealth_achievement
	}

	death
	{
		trigger dsound nazi4a_kill
	}

}

