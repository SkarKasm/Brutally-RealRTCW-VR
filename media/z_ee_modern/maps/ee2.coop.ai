		#endif
		
		#if g_ee_skinMercenary == 1
		trigger self* skin
		#endif
		
		#if g_ee_skinMercenary >= 2
		accum 0 random 2
		trigger self* skin_yes
		trigger self* skin_no
		#endif
	}
		
	trigger skin
	{
		changeaihead default
		changeaiskin merc2/merc1
		changeaihead merc1
		
		trigger self* start
	}
		
	trigger skin_yes
	{
		accum 0 abort_if_not_equal 1
		
		trigger self* skin
	}
		
	trigger skin_no
	{
		accum 0 abort_if_not_equal 0
		
		trigger self* start
	}
		
	trigger start
	{
		wait 500
		trigger self* go
	}
	
	trigger go
	{
		facetargetangles nazi5a_spot1
