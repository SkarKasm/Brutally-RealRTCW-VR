nazi3a_ps2
{
	attributes
	{
		fov 200  		// Default: 240 Range 1 ? 360

		aim_skill 0.5 		// Default: 0.5 Range: 0.0 ? 1.0 (specific targets)
		aim_accuracy 0.5 	// Default: 0.5 Range: 0.0 ? 1.0 (accuracy)
		attack_skill 0.5	// Default: 0.75 Range: 0.0 ? 1.0 (weaponry tactics 'grenades VS. machine gun' etc.)

		reaction_time 0.5	// Default: 0.5 Range: 0.0 ? 1.0 (seconds)

		attack_crouch 0.8	// Default: 0.4 Range: 0.0 ? 1.0 (frequency)
		idle_crouch 0.0		// Default: 0.0 Range: 0.0 ? 1.0 (frequency)

		aggression 0.6		// Default: 0.5 Range: 0.0 ? 1.0 (charging)
		tactical 0.5		// Default: 0.8 Range: 0.0 ? 1.0 (using enviroment for protection)
		camper 0.3		// Default: 0.0 Range: 0.0 ? 1.0 (camping abilities)

		alertness 16000		// Default: 16000 Range: 0 ? 999999 (sight distance in pixel units)
		starting_health 15	// Default: 100 Range: 0 ? 99999 (spawn health)

		hearing_scale 0.7	// Default: 1.0 Range: 0.0 ? 10 (hearing)

		inner_detection_radius 256 // (detection of things like bullet impacts within the range will affect the AI, in pixel units)
	}

	spawn
	{
		accum 0 set 0

		takeweapon all

		setammo ammo_grenades 0
		setammo ammo_792mm 100
		giveweapon weapon_mauserrifle
		selectweapon weapon_mauserrifle

		statetype alert
	//	nosight 99999
	}
	
	trigger merc
	{
		#if g_ee_skinMercenary <= 0
		trigger self* skin
		#endif
		
		#if g_ee_skinMercenary >= 2
		accum 1 random 2
		accum 1 abort_if_equal 0
		trigger self* skin
		#endif
	}
		
	trigger skin
	{
		changeaihead default
		
		accum 2 random 2
		trigger self* skin1
		trigger self* skin2
	}
		
	trigger skin1
	{
		accum 2 abort_if_not_equal 0
		
		changeaiskin merc/black
		changeaihead black
	}
		
	trigger skin2
	{
		accum 2 abort_if_not_equal 1
		
		changeaiskin merc/red
		changeaihead red
	}

	trigger go
	{
		accum 0 abort_if_not_equal 0
		accum 0 set 1

		sight
		facetargetangles nazi3a_spot1
		playsound Miscschnell
		wait forever 0
		
		trigger self* shoot
	}

	trigger go_merc
	{
		accum 0 abort_if_not_equal 0
		accum 0 set 1
		
		sight
		facetargetangles nazi3a_spot1
		playsound local_ee2_1
		wait forever 0
		
		trigger self* shoot
	}
	
	trigger shoot
	{
		wait forever 0
		resetscript
	}
	enemysight
	{
		attack player
	}

	// This will be called when BJ kills me by stabbing me in the back with a knife!
	stealthkill
	{
		dropitem ammo_9mm_small
		
		trigger player stealth_achievement
	}

	death
	{
		trigger dsound nazi3a_kill
	}

}

