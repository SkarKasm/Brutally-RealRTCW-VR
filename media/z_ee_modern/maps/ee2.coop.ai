		tactical 0.5		// Default: 0.8 Range: 0.0 ? 1.0 (using enviroment for protection)
		camper 0.3		// Default: 0.0 Range: 0.0 ? 1.0 (camping abilities)

		alertness 800		// Default: 16000 Range: 0 ? 999999 (sight distance in pixel units)
		starting_health 25	// Default: 100 Range: 0 ? 99999 (spawn health)

