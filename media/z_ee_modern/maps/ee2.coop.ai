		camper 0.6		// Default: 0.0 Range: 0.0 ? 1.0 (camping abilities)

		alertness 16000		// Default: 16000 Range: 0 ? 999999 (sight distance in pixel units)
		starting_health 10	// Default: 100 Range: 0 ? 99999 (spawn health)

		hearing_scale 0.7	// Default: 1.0 Range: 0.0 ? 10 (hearing)

		inner_detection_radius 256 // (detection of things like bullet impacts within the range will affect the AI, in pixel units)
	}

	spawn
	{
		accum 0 set 0

		takeweapon all
		setammo ammo_792mm 100
		giveweapon weapon_mauserrifle
		selectweapon weapon_mauserrifle
	//	nosight 99999 // COOP: commented out by the co-op authors (agent1b, who shoots him, is removed)
		
		#if g_ee_skinMercenary <= 0
		trigger self* go
		#endif
		
		#if g_ee_skinMercenary == 1
		trigger self* skin
		#endif
		
		#if g_ee_skinMercenary >= 2
		accum 1 random 2
		trigger self* skin_yes
		trigger self* skin_no
		#endif
	}
		
	trigger skin
	{
		changeaihead default
		changeaiskin merc2/merc1
		changeaihead merc1
		
		trigger self* go
	}
		
	trigger skin_yes
	{
		accum 1 abort_if_not_equal 1
		
		trigger self* skin
	}
		
	trigger skin_no
	{
		accum 1 abort_if_not_equal 0
		
		trigger self* go
	}

	trigger go
	{
		accum 0 abort_if_not_equal 0
		accum 0 set 1

		wait 50
		clearanim
		runtomarker nazi5c_spot1
		wait forever 0
	}

	enemysight
	{
		attack player
	}

	// This will be called when BJ kills me by stabbing me in the back with a knife!
	stealthkill
	{
		dropitem ammo_9mm_small
		
		trigger player stealth_achievement
	}

