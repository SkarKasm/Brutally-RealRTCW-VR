		attack_crouch 0.4	// Default: 0.4 Range: 0.0 ? 1.0 (frequency)
		idle_crouch 0.0		// Default: 0.0 Range: 0.0 ? 1.0 (frequency)

		aggression 1.0		// Default: 0.5 Range: 0.0 ? 1.0 (charging)
		tactical 0.0		// Default: 0.8 Range: 0.0 ? 1.0 (using enviroment for protection)
		camper 0.3		// Default: 0.0 Range: 0.0 ? 1.0 (camping abilities)

		alertness 14000		// Default: 16000 Range: 0 ? 999999 (sight distance in pixel units)
		starting_health 35	// Default: 100 Range: 0 ? 99999 (spawn health)

		hearing_scale 1.0	// Default: 1.0 Range: 0.0 ? 10 (hearing)

		inner_detection_radius 512 // (detection of things like bullet impacts within the range will affect the AI, in pixel units)
	}

	spawn
	{
		setammo ammo_9mm 999
		selectweapon weapon_mp40

		statetype alert
		wait 500
		
		#if g_ee_skinMercenary <= 0
		trigger self* go
		#endif
		
		#if g_ee_skinMercenary == 1
		trigger self* skin
		#endif
		
		#if g_ee_skinMercenary >= 2
		accum 0 random 2
		trigger self* skin_yes
		trigger self* skin_no
		#endif
	}
		
	trigger skin
	{
		changeaihead default
		
		accum 1 random 2
		trigger self* skin1
		trigger self* skin2
	}
		
	trigger skin1
	{
		accum 1 abort_if_not_equal 0
		
		changeaiskin merc2/merc1
		changeaihead merc1
		
		trigger self* go
	}
		
	trigger skin2
	{
		accum 1 abort_if_not_equal 1
		
		changeaiskin merc2/merc2
		changeaihead merc2
		
		trigger self* go
	}
		
	trigger skin_yes
	{
		accum 0 abort_if_not_equal 1
		
		trigger self* skin
	}
		
	trigger skin_no
	{
		accum 0 abort_if_not_equal 0
		
		trigger self* go
	}

	trigger go
	{
		wait 2000
		explicit_routing on
		runtomarker nrv_spot1
		explicit_routing off
//		attack player
	}

	// This will be called when BJ kills me by stabbing me in the back with a knife!
	stealthkill
	{
		dropitem ammo_9mm_small
		
		trigger player stealth_achievement
	}

	death
	{
		trigger dsound nrv_nazi5a_kill // 'nrv_' restored by William Faure
		trigger wagon killcounter
	}

}

ast
{
	spawn
	{
		notarget on
	}

	trigger radiovoice1
	{
		playsound sound/scenaric/ee/ast/ee2_2a.wav
	}

	trigger radio2_talk1
	{
		playsound sound/scenaric/ee/ast/ee2_osa_talk1.wav
	}

	trigger radio2_talk2
	{
		playsound sound/scenaric/ee/ast/ee2_bj_talk1.wav
	}

	trigger radio2_talk3
	{
		playsound sound/scenaric/ee/ast/ee2_osa_talk2.wav
	}

	trigger radio2_talk4
	{
		playsound sound/scenaric/ee/ast/ee2_bj_talk2.wav
	}

	trigger radio2_talk5
	{
		playsound sound/scenaric/ee/ast/ee2_radio_huh.wav
	}

	death
	{
	}
}

// Reinforcements

reinforce_leet1
reinforce_leet2
reinforce_leet3
reinforce_leet4
reinforce_leet5
{
	spawn
	{
		#if g_ee_skinEliteGuard <= 0
		trigger self* start
		#endif
		
		#if g_ee_skinEliteGuard == 1
		trigger self* skin
		#endif
		
		#if g_ee_skinEliteGuard >= 2
		accum 0 random 2
		trigger self* skin_yes
		trigger self* skin_no
		#endif
	}
		
	trigger skin
	{
		changeaiskin eliteguard/desert1
		
		trigger self* start
	}
		
	trigger skin_yes
	{
		accum 0 abort_if_not_equal 1
		
		trigger self* skin
	}
		
	trigger skin_no
	{
		accum 0 abort_if_not_equal 0
		
		// spawn
		trigger self* start
	}
		
	trigger start
	{
		takeweapon all
		giveweaponfull weapon_silencer weapon_mp34 weapon_mp40
		statetype alert
	}

	death
	{
	}
}

reinforce_dog1
reinforce_dog2
{
	spawn
	{
		statetype alert
	}

	death
	{
	}
}