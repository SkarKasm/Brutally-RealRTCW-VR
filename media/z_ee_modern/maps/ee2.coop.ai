		attack_crouch 0.0	// Default: 0.4 Range: 0.0 ? 1.0 (frequency)
		idle_crouch 0.0		// Default: 0.0 Range: 0.0 ? 1.0 (frequency)
		aggression 1.0		// Default: 0.5 Range: 0.0 ? 1.0 (charging)
		tactical 0.0		// Default: 0.8 Range: 0.0 ? 1.0 (protection)
		camper 0.0		// Default: 0.0 Range: 0.0 ? 1.0 (camping abilities)

		alertness 24000		// Default: 16000 Range: 0 ? 999999
		starting_health 25	// Default: 100 Range: 0 ? 99999 (spawn health)
		hearing_scale 1.0	// Default: 1.0 Range: 0.0 ? 10 (hearing)

		inner_detection_radius 512 // Default: 512 (detection of things units)
	}

	spawn
	{
//		giveweapon weapon_mauserRifle
//		selectweapon weapon_mauserRifle
		setammo ammo_grenades 0
		takeweapon all
		//setammo ammo_9mm 999			// removed by William Faure
		//giveweapon weapon_mp40		// removed by William Faure
		//selectweapon weapon_mp40		// removed by William Faure
		setammo ammo_45cal 999			// added by William Faure
		giveweapon weapon_thompson		// added by William Faure
		selectweapon weapon_thompson	// added by William Faure
		statetype alert
		trigger agent1b go
	}

	trigger go
	{
		nosight 99999
		explicit_routing on
		runtomarker agent1b_spot1
		wait 500
		playsound osa_ee2_lo
		wait 500
		trigger agent1b attack
		wait 150
		trigger agent1b attack
		clearanim
		runtomarker agent1b_spot3
		wait 1000
		
	//	#if g_reinforce <= 0
	//	trigger agent1b back
	//	#endif
	}

	trigger attack
	{
		attack nazi5c
	}

	trigger back
	{
		wait 6200
		explicit_routing on
		clearanim
		runtomarker agent1b_spot2 nostop
		alertentity kill_1b
	}

	trigger shoot
	{
		resetscript
		wait forever 0
	}

	trigger done
	{
		wait 2500
		playsound osa_ee3_done
	}

	death player
	{
		missionfailed 2 10
	}

	death
	{
		missionfailed 2 10
	}
}

