lift
{
	spawn
	{
		accum 0 set 1 // up
	}

	trigger toggle
	{
		trigger lift up
		trigger lift down
	}

	trigger reset
	{
		gotomarker liftdown 250 accel wait
		accum 0 set 0
	}


	trigger up
	{
		accum 0 abort_if_not_equal 0

		playsound sound\movers\doors\door2_open.wav
		wait 500
		gotomarker liftup 250 accel wait
		playsound sound\movers\doors\door2_loop.wav looping
		stopsound
		playsound sound\movers\doors\door2_locked.wav

		accum 0 set 1
	}

	trigger down
	{
		accum 0 abort_if_not_equal 1

		playsound sound\movers\doors\door2_open.wav
		wait 500
		gotomarker liftdown 250 accel wait
		playsound sound\movers\doors\door2_loop.wav looping
		stopsound
		playsound sound\movers\doors\door2_locked.wav

		accum 0 set 0
	}
}