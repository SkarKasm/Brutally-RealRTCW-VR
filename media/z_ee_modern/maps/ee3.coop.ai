// Agent one sniper AI

agent1
{
	attributes
	{
		fov 350 		// Default: 240 Range 1 ? 360
		aim_skill 0.35 		// Default: 0.5 Range: 0.0 ? 1.0 (specific targets)
		aim_accuracy 0.7	// Default: 0.5 Range: 0.0 ? 1.0 (accuracy)
		attack_skill 0.6	// Default: 0.75 Range: 0.0 ? 1.0 (weaponry tactics)
		reaction_time 0.2	// Default: 0.5 Range: 0.0 ? 1.0 (seconds)
		attack_crouch 0.2	// Default: 0.4 Range: 0.0 ? 1.0 (frequency)
		idle_crouch 0.0		// Default: 0.0 Range: 0.0 ? 1.0 (frequency)
		aggression 1.0		// Default: 0.5 Range: 0.0 ? 1.0 (charging)
		tactical 0.0		// Default: 0.8 Range: 0.0 ? 1.0 (protection)
		camper 0.4		// Default: 0.0 Range: 0.0 ? 1.0 (camping abilities)

		alertness 24000		// Default: 16000 Range: 0 ? 999999
		starting_health 100	// Default: 100 Range: 0 ? 99999 (spawn health)
		hearing_scale 1.0	// Default: 1.0 Range: 0.0 ? 10 (hearing)

		inner_detection_radius 512 // Default: 512 (detection of things units)
	}

	spawn
	{
		knockback off
		giveweaponfull weapon_m1garand
		selectweapon weapon_m1garand
		statetype alert
		wait 5
		trigger agent1 go
	}

	trigger go
	{
		nosight 3500
		explicit_routing on
		facetargetangles agent1_spot1
		runtomarker agent1_spot1 nostop
		explicit_routing off
		notarget off
		resetscript
		playsound osa_ee3_done
		wait 1000
		trigger agent1 shoot
	}

	trigger back
	{
		nosight 99999
		wait 10
		explicit_routing on
		runtomarker agent1_spot1 nostop
		runtomarker agent1_back nostop
		wait 3000
		explicit_routing off
		// alertentity kill_1 // moved to 'player/obj_2' - prevents doubled Agent One, fix by William Faure
	}

	trigger shoot
	{
		resetscript
		wait forever 0
	}

	trigger done
	{
		wait 2500
		trigger agent1 back
	}

	death player
	{
		missionfailed 2 10
	}

	death
	{
		missionfailed 2 10
	}
}

