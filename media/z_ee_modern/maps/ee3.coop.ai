// Agent one end fight ai

agent1b
{
	attributes
	{
		fov 350 		// Default: 240 Range 1 ? 360
		aim_skill 1.0 		// Default: 0.5 Range: 0.0 ? 1.0 (specific targets)
		aim_accuracy 0.9	// Default: 0.5 Range: 0.0 ? 1.0 (accuracy)
		attack_skill 0.8	// Default: 0.75 Range: 0.0 ? 1.0 (weaponry tactics)
		reaction_time 0.2	// Default: 0.5 Range: 0.0 ? 1.0 (seconds)
		attack_crouch 0.2	// Default: 0.4 Range: 0.0 ? 1.0 (frequency)
		idle_crouch 0.0		// Default: 0.0 Range: 0.0 ? 1.0 (frequency)
		aggression 7.0		// Default: 0.5 Range: 0.0 ? 1.0 (charging)
		tactical 0.0		// Default: 0.8 Range: 0.0 ? 1.0 (protection)
		camper 0.0		// Default: 0.0 Range: 0.0 ? 1.0 (camping abilities)

		alertness 24000		// Default: 16000 Range: 0 ? 999999
		starting_health 75	// Default: 100 Range: 0 ? 99999 (spawn health)
		hearing_scale 1.0	// Default: 1.0 Range: 0.0 ? 10 (hearing)

		inner_detection_radius 512 // Default: 512 (detection of things units)
	}

	spawn
	{
		accum 0 set 0 // fire at dude
		accum 1 set 0 // dead?
		accum 2 set 0 // gone 1

		knockback off
		//setammo ammo_9mm 999			// removed by William Faure
		//selectweapon weapon_mp40		// removed by William Faure
		setammo ammo_45cal 999			// added by William Faure
		giveweapon weapon_thompson		// added by William Faure
		selectweapon weapon_thompson	// added by William Faure
		statetype alert
		wait 5
		trigger agent1b go
	}

	trigger go
	{
		explicit_routing on
		runtomarker agent1b_spot1
		alertentity lookout
		trigger ast agent1b_lookout
		facetargetangles agent1b_spot2
		wait 50
		// playsound ee3_4
		// playsound osa_ee3_bj
		wait 250
		attack nazi5c
	}

	trigger next
	{
		accum 1 abort_if_not_equal 0
		attack nazi5d
	}

	trigger nomore
	{
		wait 25
		accum 1 inc 1

		accum 1 abort_if_not_equal 2
			trigger agent1b go2
	}

	trigger go2
	{
		wait 200
		playsound osa_ee3_way
		wait 350

		explicit_routing on
		runtomarker agent1b_spot4 nostop
		runtomarker agent1b_spot5 nostop
		runtomarker agent1b_spot6 nostop
		runtomarker agent1b_spot7
		facetargetangles agent1b_spot8
		explicit_routing off
		wait 500
	}

	trigger speak
	{
		playsound ee3_4
		wait 500
	}

	death player
	{
		missionfailed 2 10
	}

	death
	{
		missionfailed 2 10
	}
}

agent2 // PS2
{
	attributes
	{
		fov 350
		aim_skill 1
		aim_accuracy 1
		attack_skill 0.6
		reaction_time 0.2
		attack_crouch 0.2
		idle_crouch 0.0
		aggression 1
		tactical 0.0
		camper 0.4
		alertness 24000
		starting_health 25
		hearing_scale 1.0
		inner_detection_radius 512
	}

	spawn
	{
		knockback off
		takeweapon all
		giveweaponfull weapon_m1garand
		selectweapon weapon_m1garand
		statetype alert
		
		#if g_reinforce >= 1 trigger agent2 go #endif
		#if g_reinforce <= 0 trigger agent2 go2 #endif
	}

	trigger go
	{
		attack nazi5b
	}

	trigger go2
	{
		attack nazi5d
	}

	trigger yell
	{
		statetype relaxed
		runtomarker agent2_spot1
		facetargetangles agent2_spot1
		playsound osa_ee3_bj
		trigger ast agent1b_lookout
		alertentity end_run_on
		wait forever 0
	}

	trigger way
	{
		playsound osa_ee3_way
		runtomarker agent2_spot2
		facetargetangles agent2_spot2
	}

	death player
	{
		missionfailed 2 10	// '0 10', smoothed by William Faure
	}

	death
	{
		missionfailed 2 10	// '0 10', smoothed by William Faure
	}
	
	// addition fixes by William Faure
	
	attacksound
	{
		deny
	}
	statechange relaxed alert
	{
		deny
	}
	statechange query alert
	{
		deny
	}
	statechange relaxed combat
	{
		deny
	}
	statechange query combat
	{
		deny
	}
	inspectfriendlycombatstart
	{
		deny
	}
	bulletimpact
	{
		deny
	}
	bulletimpactsound
	{
		deny
	}
	inspectsoundstart
	{
		deny
	}
}
