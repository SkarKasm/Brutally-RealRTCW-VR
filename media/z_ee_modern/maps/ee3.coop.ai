// Booth guy

nazi5c
{
	attributes
	{
		fov 1 			// Default: 240 Range 1 ? 360
		aim_skill 0.4 		// Default: 0.5 Range: 0.0 ? 1.0 (specific targets)
		aim_accuracy 0.2	// Default: 0.5 Range: 0.0 ? 1.0 (accuracy)
		attack_skill 0.4	// Default: 0.75 Range: 0.0 ? 1.0 (weaponry tactics)
		reaction_time 0.6	// Default: 0.5 Range: 0.0 ? 1.0 (seconds)
		attack_crouch 0.2	// Default: 0.4 Range: 0.0 ? 1.0 (frequency)
		idle_crouch 0.0		// Default: 0.0 Range: 0.0 ? 1.0 (frequency)
		aggression 0.7		// Default: 0.5 Range: 0.0 ? 1.0 (charging)
		tactical 0.1		// Default: 0.8 Range: 0.0 ? 1.0 (protection)
		camper 0.5		// Default: 0.0 Range: 0.0 ? 1.0 (camping abilities)

		alertness 100		// Default: 16000 Range: 0 ? 999999
	//	starting_health 35	// Default: 100 Range: 0 ? 99999 (spawn health)
		starting_health 20
		hearing_scale 1.0	// Default: 1.0 Range: 0.0 ? 10 (hearing)

		inner_detection_radius 512 // Default: 512 (detection of things units)
	}

	spawn
	{
		takeweapon all

		setammo ammo_9mm 999
	//	giveweapon weapon_mp40
		selectweapon weapon_mp40
		statetype alert
		nosight 5000
	}

	enemysight
	{
		trigger player musicsituation
		attack player
	}

	trigger wakeup
	{
		attrib fov 140
		attrib alertness 14000
	}

	statechange relaxed alert
	{
		attrib fov 140
		attrib alertness 14000
	}

	statechange relaxed combat
	{
		attrib fov 140
		attrib alertness 14000
	}

	bulletimpact
	{
		attrib fov 140
		attrib alertness 14000
	}

	bulletimpactsound
	{
		attrib fov 140
		attrib alertness 14000
	}

	inspectsoundstart
	{
		attrib fov 140
		attrib alertness 14000
	}

	inspectfriendlycombatstart
	{
		attrib fov 140
		attrib alertness 14000
	}

	// This will be called when BJ kills me by stabbing me in the back with a knife!
	stealthkill
	{
		dropitem item_health_small
		
		trigger player stealth_achievement
	}

	death
	{
		trigger dsound nazi5c_kill
		// trigger agent1b next
		// trigger agent1b nomore
	}

}

