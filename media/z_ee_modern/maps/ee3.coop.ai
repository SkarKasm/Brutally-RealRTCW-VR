		aim_accuracy 0.4 	// Default: 0.5 Range: 0.0 ? 1.0 (accuracy)
		attack_skill 0.3	// Default: 0.75 Range: 0.0 ? 1.0 (weaponry tactics 'grenades VS. machine gun' etc.)

		reaction_time 0.5	// Default: 0.5 Range: 0.0 ? 1.0 (seconds)

		attack_crouch 0.2	// Default: 0.4 Range: 0.0 ? 1.0 (frequency)
		idle_crouch 0.0		// Default: 0.0 Range: 0.0 ? 1.0 (frequency)

		aggression 0.4		// Default: 0.5 Range: 0.0 ? 1.0 (charging)
		tactical 0.3		// Default: 0.8 Range: 0.0 ? 1.0 (using enviroment for protection)
		camper 0.5		// Default: 0.0 Range: 0.0 ? 1.0 (camping abilities)

		alertness 4200		// Default: 16000 Range: 0 ? 999999 (sight distance in pixel units)
		starting_health 35	// Default: 100 Range: 0 ? 99999 (spawn health)

		hearing_scale 0.6	// Default: 1.0 Range: 0.0 ? 10 (hearing)

		inner_detection_radius 512
	}

	spawn
	{
		accum 0 set 0 // spotted

		setammo ammo_grenades 0
		takeweapon all
		trigger nazi2a eat
	}

	trigger eat
	{
		playanim eating both forever
	}

	trigger spotted
	{
		accum 0 abort_if_not_equal 0
		accum 0 set 1

		trigger player musicmoving

		statetype alert
		clearanim
		giveweapon weapon_mp40
		setammo ammo_9mm 999
		selectweapon weapon_mp40
		statetype alert
		resetscript
		wait 500 0 player
	}

	trigger fire
	{
		accum 0 abort_if_not_equal 0
		accum 0 set 1

		trigger player musicmoving

		statetype alert
		clearanim
		giveweapon weapon_mp40
		setammo ammo_9mm 999
		selectweapon weapon_mp40
		resetscript
		wait 500 0 player
		fireattarget fire_spot1 500
		// trigger nazi2b go // call buddy in
	}

	attacksound
	{
		trigger nazi2b go
	}

	trigger sound
	{
		statetype alert
		clearanim
		playsound MiscWhatsThat
		wait 800
		resetscript
	}

	enemysight
	{
		playsound MiscHuh2
		resetscript
		trigger nazi2a spotted
		// trigger nazi2b go // call buddy in
	}

	statechange relaxed alert
	{
		trigger nazi2a spotted
	}

	statechange relaxed query
	{
		trigger nazi2a spotted
	}

	statechange query alert
	{
		trigger nazi2a spotted
	}

	// This will be called when BJ kills me by stabbing me in the back with a knife!
	stealthkill
	{
		dropitem ammo_9mm_small
		
		trigger player stealth_achievement
	}

