//
// AI scripts for village part 3, ee3
// Last edited by: Scan (2003), William Faure (2026)
//
// DONT TOUCH, FIXING UP

player
{
	// COOP: level start, run once from game_manager's spawn (maps/ee3.coop.script). It holds what
	// RealRTCW runs for its single player in "spawn", "playerstart" and "trigger playgame".
	trigger coopstart
	{
		globalaccum 0 set 0 // Used for secret 3
		globalaccum 1 set 0 // Access to Courtyard; objectives (RealRTCW)
		globalaccum 2 set 0 // Music
		globalaccum 3 set 0 // Courtyard count
		globalaccum 4 set 0 // Check if player is dead, for radio conversation
		globalaccum 5 set 0 // blow up stuff
		globalaccum 6 set 0 // Activate Blowdown Sequence
		globalaccum 7 set 0 // radio guy dead

		cvar g_episode 1
		objectivesneeded 3
		
		numsecrets 3
		
		//

		abort_if_loadgame
		// COOP: no briefing screen, the level music starts at once
		// (SP: l_briefing_1 / l_theme in spawn, then "mu_fade 0 1500" + "mu_queue sound/music/m_drums" in playerstart)
		mu_start sound/music/m_drums
	}

	// COOP: every player, on each (re)spawn: RealRTCW's "applyloadout ee3"
	// (loadouts/loadouts_campaign.loadout) written with co-op actions ("setclip ... full" -> max clip)
	spawn
	{
		giveweapon weapon_knife
		
		giveweapon weapon_colt
		setclip weapon_colt 8
		#if g_vanilla_guns <= 0 setammo ammo_45cal 31 #endif
		#if g_vanilla_guns >= 1 setammo ammo_45cal 32 #endif
		
		#if g_newInventory <= 0
		giveweapon weapon_luger
		setclip weapon_luger 8
		giveweapon weapon_mauserrifle
		setclip weapon_mauserrifle 10
		setammo ammo_792mm 8
		#endif
		
		giveweapon weapon_mp40
		setclip weapon_mp40 32
		setammo ammo_9mm 64
		
		setammo ammo_grenades 2
		
		selectweapon weapon_mp40
		
		giveinventory key_binocs
	}

	// COOP: in co-op this runs on every client spawn; the level start is "trigger coopstart"
	playerstart
	{
	}

	// This trigger will be called when the player actually hits the changelevel trigger,
	// AND he has found all the secrets.  Give him a cookie!
	trigger endmap_bonus
	{
		// COOP-OFF (endmap_bonus is never called in co-op): printbonus ee3
		// COOP-OFF (endmap_bonus is never called in co-op): giveweapon weapon_thompson
		// COOP-OFF (endmap_bonus is never called in co-op): giveammo ammo_45cal // giveinventory ammo_45cal
		// COOP-OFF (endmap_bonus is never called in co-op): giveammo ammo_45cal // giveinventory ammo_45cal
	}
	
	trigger checkpoint // Back Alley
	{
		// COOP-OFF (SP save/bonus): savecheckpoint
	}

///////////////////////////////////////////////////
// Achievements
	
	trigger achievement1
	{
		// COOP-OFF (SP achievement): achievement_eeCorps // Clear the courtyard with Agent One before recovering the CORPS Book in the Headquarters
	}
	
	trigger stealth_achievement
	{
		// COOP-OFF (SP achievement): globalaccum 3 abort_if_greater_than 5
		// COOP-OFF (SP achievement): globalaccum 3 inc 1
		// COOP-OFF (SP achievement): globalaccum 3 abort_if_not_equal 5
		// COOP-OFF (SP achievement): achievement_eeStealth // Perform 5 rewarded stealth kills in a single playthrough
	}

///////////////////////////
// Objectives

	// Contact Agent One by radio
	trigger obj_1
	{
		// Open Courtyard
		globalaccum 1 set 1

		// Gate Fall Enabled
		globalaccum 6 set 1

		objectivemet 1
		
		#if fs_ee_wolf2_sound >= 1 mu_play sound/ui/objective_new4.wav #endif
		
		trigger game_manager objective1 // COOP
	}

	// Infiltrate the Nazi Headquarters
	trigger obj_2
	{
		objectivemet 2
		
		#if fs_ee_wolf2_sound >= 1 mu_play sound/ui/objective_new4.wav #endif
		
		alertentity kill_1 // prevents doubled Agent One, fix by William Faure
		
		trigger game_manager objective2
	}

	// Obtain Nazi Documents
	trigger obj_3
	{
		objectivemet 3
		
		#if fs_ee_wolf2_sound >= 1 mu_play sound/ui/objective_new4.wav #endif
		
		globalaccum 1 set 3
		
		trigger game_manager objective3
	}

///////////////////////////
// Secrets

	trigger secret1
	{
		foundsecret
		
		// COOP-OFF (SP achievement): globalaccum 0 inc 1
	}

	trigger secret2
	{
		foundsecret
		
		// COOP-OFF (SP achievement): globalaccum 0 inc 1
	}

	trigger secret3_open
	{
		alertentity nrv_showsecret1
		trigger secret3door open
	}

	trigger secret3
	{
		globalaccum 0 abort_if_not_equal 0

			globalaccum 0 set 1
			foundsecret
		
		// COOP-OFF (SP achievement): globalaccum 0 inc 1
	}

	// Not sure if this is crashing it (removed temp)

///////////////////////////
// Misc

// dont know what its for, it's not used
//
//	trigger failed
//	{
//		missionfailed
//	}

	trigger take_away // PS2
	{
//		killentity t2cargo
//		killentity t2bwheels
//		killentity t2door
//		killentity t2lwheel
//		killentity t2rwheel
//		killentity t2body
		
		alertentity t2_kill_relay // 'killentity' not supported, fix by William Faure
	}

	trigger exit_run // PS2
	{
		trigger agent2 way
	}

	trigger endmap
	{
		// COOP: game_manager (ee3.coop.script) checks objectives 2 and 3 (SP checks "globalaccum 1 == 3", set by obj_3)
		trigger game_manager checkexit
	}

	trigger exitlevel
	{
		globalaccum 1 set 0
		
		// COOP-OFF (SP achievement): globalaccum 1 inc 1
		
		// COOP-OFF (SP achievement): if g_gameskill >= 3 globalaccum 2 inc 1 endif
		
		#if g_ee_progress == 2 cvar g_ee_progress 3 #endif
		
		cvar g_level_was_selected 0
		
		changelevel ee4 persistent
	}


///////////////////////////
// Music

	// Upbeat - Moving (rolling)
	trigger musicmoving
	{
		globalaccum 2 abort_if_equal 7
		globalaccum 2 set 7
		//mu_stop 3000
		mu_fade 0 500
		mu_queue sound/music/m_moving
	}
	// Calm - Sneaky (lower  slower pace)
	trigger musicstealth
	{
		globalaccum 2 abort_if_equal 5
		globalaccum 2 set 5
		//mu_stop 3000
		wait 1500
		mu_fade 0 500
		mu_queue sound/music/m_stealth
	}
	// Calm - After Battle (after action is over sorta)
	trigger musicgrave
	{
		globalaccum 2 abort_if_equal 4
		globalaccum 2 set 4
		//mu_stop 3000
		wait 1500
		mu_fade 0 500
		mu_queue sound/music/m_grave
	}
	// Moderate - Anticipation (flat with no action)
	trigger musicmission
	{
		globalaccum 2 abort_if_equal 1
		globalaccum 2 set 1
		//mu_stop 3000
		wait 1500
		mu_fade 0 500
		mu_queue sound/music/m_mission
	}
	// Moderate -  Uneasyness (throbbing and bumpy)
	trigger musictension
	{
		globalaccum 2 abort_if_equal 2
		globalaccum 2 set 2
		//mu_stop 3000
		mu_fade 0 500
		mu_queue sound/music/m_tension
	}
	// Moderate - Drum Rolls
	trigger musicdrums
	{
		globalaccum 2 abort_if_equal 3
		globalaccum 2 set 3
		//mu_stop 3000
		wait 1500
		mu_fade 0 500
		mu_queue sound/music/m_drums
	}
	// Upbeat - Action (duh duh duh duh)
	trigger musicaction
	{
		globalaccum 2 abort_if_equal 6
		globalaccum 2 set 6
		//mu_stop 3000
		mu_fade 0 1000
		mu_queue sound/music/m_action
	}
	// Upbeat - Military (drums, tromping around)
	trigger musicsituation
	{
		globalaccum 2 abort_if_equal 8
		globalaccum 2 set 8
		//mu_stop 3000
		mu_fade 0 500
		mu_queue sound/music/m_situation
	}

//////////////////////////
// Section 1 - Entrance Passage

// guy heading to wine cellar

	trigger action1a
	{
		alertentity nazi1a
		
		#if g_reinforce >= 2 alertentity reinforce_leet1 #endif
	}

// outside passage in (que guys coming out of door)

	trigger action1b
	{
		#if g_reinforce >= 2 alertentity reinforce_leet2 #endif

		alertentity nazi1b
		alertentity nazi1bb

		wait 500

		trigger nazi1b sound1

		wait 6500

		trigger nazi1bb sound1

		wait 5500

		trigger nazi1b sound2

		// wait 1000


		trigger nazi1b go
		trigger nazi1bb go
	}

	trigger action1c
	{
		alertentity nazi2a

		trigger nazi1b go
		wait 1500
		trigger nazi1bb go
	}

//////////////////////////
// Section 2 - Residence Area

	trigger action2a
	{
		alertentity nazi2b
		
		#if g_reinforce >= 2 alertentity reinforce_leet3 #endif
	}

// players in visibility from counter alcove

	trigger action2b
	{
		trigger nazi2a fire
	}

// leaving, call backup if hasn't been called

	trigger action2c
	{
	//	trigger nazi2b go
	}

// if you get beyond door before nazi, make him do a fast attack

	trigger action2cc
	{
		trigger nazi2b fast
		
		#if g_reinforce >= 2 alertentity reinforce_dog1 #endif
	}

	trigger action2d
	{
		alertentity nazi2c
	}

// radio room

	trigger nazi2c_radio
	{
		trigger nazi2c sound1
	}

	trigger radioguydead
	{
		globalaccum 7 set 1
	}

	trigger radio_conversation
	{
		globalaccum 7 abort_if_not_equal 1
		globalaccum 4 abort_if_equal 1
		
		alertentity rbutton_fiu_kill_relay

		trigger rbutton down

		//teleport radio_away
		//startcam ee3_radio_cam

		//lockplayer on
		//wait 1000

		//alertentity radio2_talk1
		//trigger ast radio2_talk1
		//wait 2000

		//globalaccum 4 abort_if_equal 1
		//alertentity radio2_talk2
		//trigger ast radio2_talk2
		//wait 2000

		//alertentity radio2_talk3
		//trigger ast radio2_talk3
		//wait 6500

		//globalaccum 4 abort_if_equal 1
		//alertentity radio2_talk4
		//trigger ast radio2_talk4
		//wait 1500

		//teleport radio_back
		//wait 5
		//stopcam
		//wait 500
		//lockplayer off
		
		trigger player playbink_ps2
	}

	trigger playbink
	{
		#if cg_drawSubtitles <= 0 cin_play ee3.webm #endif
		#if cg_drawSubtitles >= 1 cin_play ee3_sub.webm #endif
		
		trigger player radio_conversation_end
	}

	trigger playbink_ps2
	{
		#if cg_drawSubtitles <= 0 cin_play ee3_ps2.webm #endif
		#if cg_drawSubtitles >= 1 cin_play ee3_ps2_sub.webm #endif
		
		trigger player radio_conversation_end
	}

	trigger radio_conversation_end
	{
		globalaccum 4 set 1
		globalaccum 7 set 1

		alertentity nazi2d
		trigger player action2f
	}

// Only triggered if radio guy has been killed for surprise attack heading back out

	trigger action2e
	{
		globalaccum 6 abort_if_not_equal 1
		globalaccum 6 set 0

		trigger player musicaction	// copied in 'nazi2d' enemysight, 'musicaction' fix by William Faure
	//	trigger doorfall fall		// moved to 'nazi2d' enemysight, 'doorfall' fix by William Faure
	//	trigger nazi2d go			// became enemysight, 'doorfall' fix by William Faure
	}

	trigger pressbutton
	{
		trigger player radio_conversation
	}

// Opens Gate to courtyard

	trigger action2f
	{
		trigger player obj_1

		wait 600

	// enable courtyard entry trigger
		alertentity action3a_enable

	// nazi by water well
		alertentity nazi2f

	// nazi by truck entrance
		alertentity nazi2g

	// open the gate
		alertentity unlock_gate // MBJ
		wait 5
		alertentity open_sesami
	}

//////////////////////////
// Section 3 - Courtyard Rumble

	// triggers before passing gate
	trigger action3a
	{

	// abort if radio guy is not dead

		globalaccum 1 abort_if_not_equal 1
		globalaccum 1 set 0

	// alert welcome party
		
		#if g_reinforce >= 2 alertentity reinforce_leet4 #endif
		#if g_reinforce >= 2 alertentity reinforce_bg1 #endif
		#if g_reinforce >= 2 alertentity reinforce_bg2 #endif

		alertentity nazi3a
		alertentity nazi3b
		alertentity nazi3c

		alertentity nazi3e
		alertentity nazi3f

		wait 100

	// queue agent one on roof

		// alertentity agent1

		wait 10

		trigger t1body begin2
	}

	trigger courtcount
	{
		globalaccum 3 inc 1
		globalaccum 3 abort_if_less_than 3

			trigger nazi3f go

		globalaccum 3 abort_if_less_than 4

			trigger nazi3e go
	}
//////////////////////////
// Section 4 - Inside Main Building

// Enterering Door

	trigger action4a
	{
		alertentity nazi4a // comes down stairs
		alertentity nazi4b // tells nazi4a to go downstairs

		alertentity nazi4c // around hall bend
		alertentity nazi4d // officers chamber
		alertentity nazi4e // last room
	}

	trigger action4a_voice
	{
		#if g_reinforce >= 2 alertentity reinforce_leet5 #endif
		
		trigger nazi4b sound1

		wait 7000

		trigger nazi4a sound1

		wait 1000

		trigger nazi4b sound2

		wait 2500

		trigger nazi4a wakeup
		wait 5
		trigger nazi4a go

	}

// Make talking nazi's alertive at end of hall

	trigger action4aa
	{
//		trigger nazi4a wakeup
//		trigger nazi4b wakeup
	}

// Upstairs

	trigger action4b
	{

	// agent one runs back into hiding
		trigger nazi4c go
	}

// Officers Room

	trigger action4bb
	{
		trigger nazi4d go
	}

// Exit room door

	trigger action4_door
	{
		trigger nazi4e speak
		
		#if g_reinforce >= 2 alertentity reinforce_bg3 #endif
	}

// Exiting building

	trigger action4c
	{
		alertentity nazi5a
		
		#if g_reinforce >= 2 alertentity reinforce_dog2 #endif
		#if g_reinforce >= 2 alertentity reinforce_bg4 #endif
	}

//////////////////////////
// Section 5 - Outside Path to Ruins

// (path back to courtyard)

	trigger action5a
	{
		// goes automaticlaly now
		trigger nazi5a run
	}

// (path through gate at far end)

	trigger action5b
	{
		// start truck

		trigger t2body begin2

		// guards down below

		#if g_reinforce >= 1 alertentity nazi5b #endif
		alertentity nazi5c
		// alertentity agent1b
	}

	trigger action5_agent1
	{

	// 	trigger agent1b go2
	}


	trigger action5c
	{
		trigger nazi5c wakeup
		
		alertentity agent2
	}

	trigger passmg
	{
//		#if fs_ee_ps2_maps <= 0 trigger nazi5b getoff #endif
	}
}

/////////////////////////////////////////////
// SECTION 1 - Entrance Hall
/////////////////////////////////////////////

nazi1a
{
	attributes
	{
		fov 70	 		// Default: 240 Range 1 ? 360

		aim_skill 0.4 		// Default: 0.5 Range: 0.0 ? 1.0 (specific targets)
		aim_accuracy 0.3 	// Default: 0.5 Range: 0.0 ? 1.0 (accuracy)
		attack_skill 0.5	// Default: 0.75 Range: 0.0 ? 1.0 (weaponry tactics 'grenades VS. machine gun' etc.)

		reaction_time 0.5	// Default: 0.5 Range: 0.0 ? 1.0 (seconds)

		attack_crouch 0.2	// Default: 0.4 Range: 0.0 ? 1.0 (frequency)
		idle_crouch 0.0		// Default: 0.0 Range: 0.0 ? 1.0 (frequency)

		aggression 0.7		// Default: 0.5 Range: 0.0 ? 1.0 (charging)
		tactical 0.3		// Default: 0.8 Range: 0.0 ? 1.0 (using enviroment for protection)
		camper 0.5		// Default: 0.0 Range: 0.0 ? 1.0 (camping abilities)

		alertness 3000		// Default: 16000 Range: 0 ? 999999 (sight distance in pixel units)
		starting_health 35	// Default: 100 Range: 0 ? 99999 (spawn health)

		hearing_scale 0.5	// Default: 1.0 Range: 0.0 ? 10 (hearing)

		inner_detection_radius 256
	}

	spawn
	{
		accum 0 set 0 // alerted
		accum 1 set 0 // entered room
		accum 2 set 0 // speak

		takeweapon all

		setammo ammo_grenades 0
		setammo ammo_9mm 999

		wait 100
		trigger nazi1a go
	}

	trigger go
	{
		// playsound Mumble2
		walktomarker nazi1a_spot1 nostop

		accum 0 abort_if_not_equal 0
		walktomarker nazi1a_spot2 nostop
		walktomarker nazi1a_spot3 nostop

		accum 1 set 1

		walktomarker nazi1a_spot4
		wait 250
		playsound MiscYawn
		playanim butt_scratch_1h both
		wait 150 0 player
		trigger nazi1a relaxed
	}

	trigger relaxed
	{
		// cigarette on
		// playanim smoking both
		resetscript
	}

	trigger spotted
	{
		accum 0 abort_if_not_equal 0

		trigger nazi1a spotted1
		trigger nazi1a spotted2
	}

	trigger spotted1
	{
		accum 1 abort_if_not_equal 1

		accum 0 abort_if_not_equal 0
		accum 0 set 1

		clearanim
	//	trigger nazi1a speak
		attrib fov 240
		attrib alertness 12000
		clearanim
		giveweapon weapon_luger
		selectweapon weapon_luger
		statetype alert
		resetscript
	}

	trigger spotted2
	{
		accum 1 abort_if_not_equal 0

		accum 0 abort_if_not_equal 0
		accum 0 set 1

		clearanim
		giveweapon weapon_luger
		selectweapon weapon_luger
		statetype alert
		attrib fov 240
		attrib alertness 12000

		resetscript
	}

	enemysight
	{
		trigger nazi1a spotted
	}

	statechange relaxed alert
	{
		trigger nazi1a spotted
	}

	statechange relaxed combat
	{
		trigger nazi1a spotted
	}

	statechange query alert
	{
		trigger nazi1a spotted
	}

	statechange query combat
	{
		trigger nazi1a spotted
	}

	bulletimpact
	{
		trigger nazi1a spotted
	}

	inspectsoundstart
	{
		trigger nazi1a spotted
	}

	// This will be called when BJ kills me by stabbing me in the back with a knife!
	stealthkill
	{
		dropitem ammo_9mm_small
		
		trigger player stealth_achievement
	}

	death
	{
		trigger dsound nazi1a_kill
	}
}

// coming out of residence

nazi1b
{
	attributes
	{
		fov 240 // MBJ

		//fov 80	 		// Default: 240 Range 1 ? 360

		aim_skill 0.4 		// Default: 0.5 Range: 0.0 ? 1.0 (specific targets)
		aim_accuracy 0.3 	// Default: 0.5 Range: 0.0 ? 1.0 (accuracy)
		attack_skill 0.5	// Default: 0.75 Range: 0.0 ? 1.0 (weaponry tactics 'grenades VS. machine gun' etc.)

		reaction_time 0.5	// Default: 0.5 Range: 0.0 ? 1.0 (seconds)

		attack_crouch 0.2	// Default: 0.4 Range: 0.0 ? 1.0 (frequency)
		idle_crouch 0.0		// Default: 0.0 Range: 0.0 ? 1.0 (frequency)

		aggression 0.8		// Default: 0.5 Range: 0.0 ? 1.0 (charging)
		tactical 0.3		// Default: 0.8 Range: 0.0 ? 1.0 (using enviroment for protection)
		camper 0.5		// Default: 0.0 Range: 0.0 ? 1.0 (camping abilities)

		alertness 4200		// Default: 16000 Range: 0 ? 999999 (sight distance in pixel units)
		starting_health 35	// Default: 100 Range: 0 ? 99999 (spawn health)

		hearing_scale 0.2	// Default: 1.0 Range: 0.0 ? 10 (hearing)

		inner_detection_radius 512
	}

	spawn
	{
		accum 0 set 0 // alerted
		accum 1 set 0 // speak
		accum 2 set 0 // go
		accum 3 set 0 // speak

		takeweapon all

		setammo ammo_grenades 0
		setammo ammo_9mm 999
		giveweapon weapon_luger
	}

	trigger sound1
	{
		accum 1 abort_if_not_equal 0
		// alertentity d1_voice1
		playsound nazi_ee3_1a
	}

	trigger sound2
	{
		accum 1 abort_if_not_equal 0
		// alertentity d1_voice3
		playsound nazi_ee3_1c
	}

	trigger stoptalk
	{
		accum 1 set 1
		playsound blank
	}

	trigger go
	{
		accum 2 abort_if_not_equal 0
		accum 2 set 1

		noavoid
		explicit_routing on
	//	walktomarker nazi1b_spot1 nostop
		walktomarker nazi1b_spot2 nostop
		explicit_routing off
		walktomarker nazi1b_spot3 nostop
		walktomarker nazi1b_spot4 nostop
		walktomarker nazi1b_spot5 nostop
		walktomarker nazi1b_spot6 nostop
		resetscript
	}

	trigger speakspot
	{
		accum 2 abort_if_not_equal 0
		accum 2 set 1

		playsound nazi_whosthat
		wait 300
	}

	trigger spotted
	{
		accum 0 abort_if_not_equal 0
		accum 0 set 1

		trigger nazi1b stoptalk
		trigger nazi1bb stoptalk

		trigger player musicmoving
		trigger dsound nazi1b_live

		clearanim
		attrib fov 240
		selectweapon weapon_luger
		statetype alert
		trigger nazi1bb spotted
		trigger nazi1b speakspot
		resetscript
		attack player
	}

	enemysight
	{
		trigger nazi1b spotted
	}

	statechange relaxed alert
	{
		statetype alert
		attrib fov 240
	}

	statechange relaxed combat
	{
		trigger nazi1b spotted
	}

	statechange query alert
	{
		statetype alert
		attrib fov 240
	}

	statechange query combat
	{
		trigger nazi1b spotted
	}

	bulletimpact
	{
		trigger nazi1b spotted
	}

	inspectsoundstart
	{
		deny
	}

	// This will be called when BJ kills me by stabbing me in the back with a knife!
	stealthkill
	{
		dropitem ammo_9mm_small
		
		trigger player stealth_achievement
	}

	death
	{
		trigger dsound nazi1b_kill
	}
}

