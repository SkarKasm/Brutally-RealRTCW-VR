nazi2a
nazi2a_ps2
{
	attributes
	{
		fov 110 		// Default: 240 Range 1 ? 360
		aim_skill 0.3 		// Default: 0.5 Range: 0.0 ? 1.0 (specific targets)
		aim_accuracy 0.2	// Default: 0.5 Range: 0.0 ? 1.0 (accuracy)
		attack_skill 0.5	// Default: 0.75 Range: 0.0 ? 1.0 (weaponry tactics)
		reaction_time 0.3	// Default: 0.5 Range: 0.0 ? 1.0 (seconds)
		attack_crouch 0.2	// Default: 0.4 Range: 0.0 ? 1.0 (frequency)
		idle_crouch 0.0		// Default: 0.0 Range: 0.0 ? 1.0 (frequency)
		aggression 0.4		// Default: 0.5 Range: 0.0 ? 1.0 (charging)
		tactical 0.2		// Default: 0.8 Range: 0.0 ? 1.0 (protection)
		camper 0.4		// Default: 0.0 Range: 0.0 ? 1.0 (camping abilities)

		alertness 12000		// Default: 16000 Range: 0 ? 999999
		starting_health 25	// Default: 100 Range: 0 ? 99999 (spawn health)
		hearing_scale 0.2	// Default: 1.0 Range: 0.0 ? 10 (hearing)

		inner_detection_radius 256 // Default: 512 (detection of things units)
	}

	spawn
	{
		takeweapon all

		giveweapon weapon_mp40
		setammo ammo_9mm 999
		setammo ammo_grenades 0
		selectweapon weapon_mp40

		statetype alert
	}
		
	trigger merc
	{
		#if g_ee_skinMercenary == 1
		trigger self* skin
		#endif
		
		#if g_ee_skinMercenary >= 2
		accum 0 random 2
		accum 0 abort_if_equal 0
		trigger self* skin
		#endif
	}
		
	trigger skin
	{
		changeaihead default
		
		accum 1 random 2
		trigger self* skin1
		trigger self* skin2
	}
		
	trigger skin1
	{
		accum 1 abort_if_not_equal 0
		
		changeaiskin merc2/merc1
		changeaihead merc1
	}
		
	trigger skin2
	{
		accum 1 abort_if_not_equal 1
		
		changeaiskin merc2/merc2
		changeaihead merc2
	}

	trigger go
	{
		nosight 2000
		runtomarker nazi2a_spot1 nostop
		sight
		runtomarker nazi2a_spot2 nostop
		runtomarker nazi2a_spot3

		resetscript
	}

	enemysight
	{
		resetscript
	}

	inspectfriendlycombatstart
	{
		deny
	}

	bulletimpact
	{
		deny
	}

	inspectsoundstart
	{
		deny
	}

	inspectsoundend
	{
		deny
	}

	inspectbodystart
	{
		deny
	}

	inspectbodyend
	{
		deny
	}

	// This will be called when BJ kills me by stabbing me in the back with a knife!
	stealthkill
	{
		dropitem ammo_9mm_small
		
		trigger player stealth_achievement
	}

	death
	{
	}
}

