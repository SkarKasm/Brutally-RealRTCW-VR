elite1
{
	attributes
	{
		fov 240			// Default: 240 Range 1 ? 360
		aim_skill 0.6 		// Default: 0.5 Range: 0.0 ? 1.0 (specific targets)
		aim_accuracy 0.6	// Default: 0.5 Range: 0.0 ? 1.0 (accuracy)
		attack_skill 0.9	// Default: 0.75 Range: 0.0 ? 1.0 (weaponry tactics)
		reaction_time 0.3	// Default: 0.5 Range: 0.0 ? 1.0 (seconds)
		attack_crouch 0.2	// Default: 0.4 Range: 0.0 ? 1.0 (frequency)
		idle_crouch 0.0		// Default: 0.0 Range: 0.0 ? 1.0 (frequency)
		aggression 0.6		// Default: 0.5 Range: 0.0 ? 1.0 (charging)
		tactical 0.8		// Default: 0.8 Range: 0.0 ? 1.0 (protection)
		camper 0.3		// Default: 0.0 Range: 0.0 ? 1.0 (camping abilities)

		inner_detection_radius 512 // Default: 512 (detection of things units)
	}

	spawn
	{
		takeweapon all
		setammo ammo_9mm 999
		setammo ammo_grenades 0
		giveweapon weapon_mp40
		selectweapon weapon_mp40
		statetype alert
		
		#if g_ee_skinMercenary == 1
		trigger self* skin
		#endif
		
		#if g_ee_skinMercenary >= 2
		accum 0 random 2
		accum 0 abort_if_equal 0
		trigger self* skin
		#endif
	}
		
	trigger skin
	{
		changeaihead default
		
		accum 1 random 2
		accum 1 abort_if_equal 0
		trigger self* skin1
		trigger self* skin2
	}
		
	trigger skin1
	{
		changeaiskin merc2/merc1
		changeaihead merc1
	}
		
	trigger skin2
	{
		changeaiskin merc2/merc2
		changeaihead merc2
	}

	trigger go
	{
		wait 8500
		runtomarker zombie6f_spot1 nostop
		playsound merc_inf2
		trigger elite1 cover
	}

	trigger cover
	{
		resetscript
		attack player
	}

	enemysight
	{
		trigger elite1 cover
	}

	// This will be called when BJ kills me by stabbing me in the back with a knife!
	stealthkill
	{
		dropitem ammo_9mm_small
		
		trigger player stealth_achievement
	}

	death
	{
	}
}

