/////////////////////////////////////////////
// SECTION 1 - Drop Zone
/////////////////////////////////////////////

nazi1a
{
	attributes
	{
		fov 110 		// Default: 240 Range 1 ? 360
		aim_skill 0.2 		// Default: 0.5 Range: 0.0 ? 1.0 (specific targets)
		aim_accuracy 0.5	// Default: 0.5 Range: 0.0 ? 1.0 (accuracy)
		attack_skill 0.5	// Default: 0.75 Range: 0.0 ? 1.0 (weaponry tactics)
		reaction_time 0.4	// Default: 0.5 Range: 0.0 ? 1.0 (seconds)
		attack_crouch 0.2	// Default: 0.4 Range: 0.0 ? 1.0 (frequency)
		idle_crouch 0.0		// Default: 0.0 Range: 0.0 ? 1.0 (frequency)
		aggression 0.2		// Default: 0.5 Range: 0.0 ? 1.0 (charging)
		tactical 0.4		// Default: 0.8 Range: 0.0 ? 1.0 (protection)
		camper 0.4		// Default: 0.0 Range: 0.0 ? 1.0 (camping abilities)

		alertness 12000		// Default: 16000 Range: 0 ? 999999
		starting_health 25	// Default: 100 Range: 0 ? 99999 (spawn health)
		hearing_scale 1.0	// Default: 1.0 Range: 0.0 ? 10 (hearing)

		inner_detection_radius 512 // Default: 512 (detection of things units)
	}

	spawn
	{
		accum 0 set 0 // done talking

		takeweapon all

		setammo ammo_9mm 999
		setammo ammo_grenades 0
		giveweapon weapon_luger
		selectweapon weapon_luger
	}

	trigger talk
	{
		nosight 5000
	//	playsound rocket_nazi2a_elevator
		playsound nazi_ee6_1b
		wait 1200
		sight
		accum 0 set 1
		statetype alert
		trigger nazi1b go
	}

	trigger go
	{
		accum 0 abort_if_not_equal 1
		attack player
	}

	enemysight
	{
		resetscript
	}

	inspectfriendlycombatstart
	{
		deny
	}

	bulletimpact
	{
		trigger nazi1b talk
	}

	bulletimpactsound
	{
		trigger nazi1b talk
	}

	inspectsoundstart
	{
		deny
	}

	inspectsoundend
	{
		deny
	}

	inspectbodystart
	{
		deny
	}

	inspectbodyend
	{
		deny
	}

	// This will be called when BJ kills me by stabbing me in the back with a knife!
	stealthkill
	{
		dropitem item_health_small
		
		trigger player stealth_achievement
	}

	death
	{
		accum 0 set 1
		resetscript
	}
}

