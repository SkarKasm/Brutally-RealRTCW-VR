//AI Scripting
//Map: ee6
//Last edited by: Scan (2003), William Faure (2026)

player
{
	// COOP: level start, run once from game_manager's spawn (maps/ee6.coop.script). It holds what
	// RealRTCW runs for its single player in "spawn", "playerstart" and "trigger playgame".
	trigger coopstart
	{
		globalaccum 0 set 0 // popout
		globalaccum 1 set 1 // last guys
		globalaccum 2 set 0 // objectives
		globalaccum 3 set 0 // secret1
		globalaccum 4 set 0 // zombie kill count for area 6
		globalaccum 5 set 0 // cinematic interrupt
		globalaccum 6 set 0 // allow first nazi's to spawn
		globalaccum 7 set 0 // door press state

		cvar g_episode 1
		objectivesneeded 2
		
		numsecrets 3
		
		//

		abort_if_loadgame
		// COOP: no briefing screen, the level music starts at once
		// (SP: l_briefing_1 / l_theme in spawn, then "mu_fade 0 1500" + "mu_queue sound/music/c_chant" in playerstart)
		mu_start sound/music/c_chant
		
		#if cg_drawSubtitles <= 0 cin_play ee6.webm #endif
		#if cg_drawSubtitles >= 1 cin_play ee6_sub.webm #endif
		
		//
		
		trigger stoned reset
		//trigger cine_counter cine_setup	//CGC
		trigger player lift_crash			//CGC
		trigger cine_counter clean1			//CGC
	}

	// COOP: every player, on each (re)spawn: RealRTCW's "applyloadout ee6"
	// (loadouts/loadouts_campaign.loadout) written with co-op actions ("setclip ... full" -> max clip)
	spawn
	{
		giveweapon weapon_knife
		
		giveweapon weapon_colt
		setclip weapon_colt 8
		#if g_vanilla_guns <= 0 setammo ammo_45cal 31 #endif
		#if g_vanilla_guns >= 1 setammo ammo_45cal 32 #endif
		
		#if g_newInventory <= 0
		giveweapon weapon_luger
		setclip weapon_luger 8
		giveweapon weapon_mauserrifle
		setclip weapon_mauserrifle 10
		setammo ammo_792mm 8
		#endif
		
		giveweapon weapon_mp40
		setclip weapon_mp40 32
		setammo ammo_9mm 128
		
		setammo ammo_grenades 2
		
		selectweapon weapon_mp40
		
		giveinventory key_binocs
	}

	// COOP: in co-op this runs on every client spawn; the level start is "trigger coopstart"
	playerstart
	{
	}

	// This trigger will be called when the player actually hits the changelevel trigger,
	// AND he has found all the secrets.  Give him a cookie!
	trigger endmap_bonus
	{
		// COOP-OFF (endmap_bonus is never called in co-op): printbonus ee6
		// COOP-OFF (endmap_bonus is never called in co-op): givehealth item_health // giveinventory item_health
		// COOP-OFF (endmap_bonus is never called in co-op): giveammo ammo_45cal // giveinventory ammo_45cal
	}
	
	trigger checkpoint // Upper Tombs
	{
		// COOP-OFF (SP save/bonus): savecheckpoint
	}

///////////////////////////////////////////////////
// Achievements
	
	trigger achievement1
	{
		// COOP-OFF (SP achievement): achievement_eeTraps // Reach the last room without having triggered any of the traps across the level in the Tombs
	}
	
	trigger stealth_achievement
	{
		// COOP-OFF (SP achievement): globalaccum 3 abort_if_greater_than 5
		// COOP-OFF (SP achievement): globalaccum 3 inc 1
		// COOP-OFF (SP achievement): globalaccum 3 abort_if_not_equal 5
		// COOP-OFF (SP achievement): achievement_eeStealth // Perform 5 rewarded stealth kills in a single playthrough
	}

///////////////////////////////////////////////////
// Misc

	trigger lift_crash
	{
		alertentity rope // trigger lift down
		trigger spike_trap reset
		trigger lid open

		wait 5

		trigger spike2_1s reset2
		trigger spike2_1n reset2
		
		#if g_reinforce >= 2 alertentity reinforce_bg1 #endif
		#if g_reinforce >= 2 alertentity reinforce_leet1 #endif
	}

//	trigger endmap
//	{
//		cvar g_level_was_selected 0
//		
//		changelevel ee7 persistent
//	}

///////////////////////////////////////////////////
// Ojectives

	trigger obj1 // open 1st port
	{
		globalaccum 2 abort_if_not_equal 0
		globalaccum 2 set 1
		alertentity global_effect5
		objectivemet 1
		
		#if fs_ee_wolf2_sound >= 1 mu_play sound/ui/objective_new4.wav #endif
		
		#if g_reinforce >= 2 alertentity reinforce_v2 #endif
		
		trigger game_manager objective1
	}

	trigger obj2 // entering exit path
	{
		objectivemet 2
		
		#if fs_ee_wolf2_sound >= 1 mu_play sound/ui/objective_new4.wav #endif
		
		globalaccum 2 set 2
		
		#if g_reinforce >= 2 alertentity reinforce_leet5 #endif
		
		trigger game_manager objective2
	}

///////////////////////////////////////////////////
// Secrets

	// door
	trigger secret1
	{
		globalaccum 3 abort_if_not_equal 0
		globalaccum 3 set 1
		trigger secretdoor open
	}

	trigger nrv_secret1
	{
		foundsecret
		
		// COOP-OFF (SP achievement): globalaccum 0 inc 1
	}

	// wall
	trigger secret2
	{
		foundsecret
		
		// COOP-OFF (SP achievement): globalaccum 0 inc 1
	}


	trigger sdoor1open
	{
		globalaccum 7 abort_if_not_equal 0
		trigger secret2door1 open
		globalaccum 7 inc 1
	}
	trigger sdoor2open
	{
		globalaccum 7 abort_if_not_equal 1
		trigger secret2door2 open
	}
	trigger sdoorscript
	{
		trigger player sdoor2open
		wait 300
		trigger player sdoor1open
	}

	trigger action4secret
	{
		foundsecret
	}

/////////////////////////////////////////////
// SECTION 1 - Drop Zone
/////////////////////////////////////////////

	trigger event_dropdownsound
	{
		wait 300
		trigger nazi1b talk
	}

	trigger event_dropdown
	{
		trigger nazi1a go
		trigger nazi1b go
	}

/////////////////////////////////////////////
// SECTION 2 - Dungeon
/////////////////////////////////////////////

	// Zombies come from their cells

	trigger action2a
	{
		#if g_reinforce >= 2 alertentity reinforce_leet2 #endif
		
		globalaccum 5 random 2
		trigger player action2a_xbox
		trigger player action2a_ps2
	}

	trigger action2a_xbox
	{
		globalaccum 5 abort_if_not_equal 0
		
		alertentity nazi2a
		trigger nazi2a merc
		
		trigger player action2a_end
	}

	trigger action2a_ps2
	{
		globalaccum 5 abort_if_not_equal 1
		
		alertentity nazi2a_ps2
		
		trigger player action2a_end
	}

	trigger action2a_end
	{
		// Zombies come out of cells

		alertentity zombie2a
		alertentity zombie2b
		alertentity zombie2c

		alertentity speak1

		trigger zombie2b go
		wait 1000
		trigger zombie2c go
	}

	// Zombie busts out of the wall

	trigger action2b
	{
		trigger zombie2a go
		trigger nazi2a go
	}

	// Cell Door Breaks Open
	trigger action2bustout
	{
 		alertentity speak2
		alertentity kill_door
		alertentity zombie2d
		trigger zombie2d go
	}


/////////////////////////////////////////////
// SECTION 3 & 4 - Pillar Room and Gate Hallway
/////////////////////////////////////////////


// Door Opens.  Spike trap in hallway

	trigger spike_alert
	{
		trigger spike_trap on
		
		trigger game_manager achievement1_fail // Reach the last room without having triggered any of the traps across the level in the Tombs
	}

	trigger spike_off
	{
		trigger spike_trap stop
	}

	// trigger zombie in the room below the fighting
	trigger action3a
	{
		#if g_reinforce >= 2 alertentity reinforce_bg2 #endif
		
		alertentity speak3
		alertentity nazi3a

		alertentity zombie3a
		alertentity zombie3b

		mu_queue sound/music/c_chant
	}

	// no action 3b yet

	// Two nazis run away, and leave behind a present
	trigger action3c
	{
		#if g_reinforce >= 2 alertentity reinforce_v1 #endif
		
		alertentity zombie3d

		// spawn running nazi's
		alertentity nazi3c
		alertentity nazi3cc

		// sounds, + door crash
		alertentity second_fight
		trigger ast second_fight
		alertentity global_effect6

		// general nazi drone, has target_delay to start after nazi run
		alertentity speak4
		wait 300
	}


	// Two zombies bust out of opposite sides of room
	// TODO: Make some sort of commosion wake them up.
	// banging on sides?

	trigger action3d
	{
		#if g_reinforce >= 2 alertentity reinforce_bg3 #endif

		alertentity zombie3c
		alertentity zombie3cc

		// blow out walls
		alertentity z3c_blow
		alertentity z3cc_blow

		// play sound
		alertentity speak5
		wait 300

	}

	// The two nazis that ran away get killed by relay
	// Moved the trigger to the beginning of section 4

	trigger action3e
	{
		alertentity kill_escape
		
		#if g_reinforce >= 2 alertentity reinforce_leet3 #endif
	}


// Upstairs

	trigger action4count
	{
		globalaccum 0 inc 1
		globalaccum 0 abort_if_not_equal 6

			globalaccum 0 set 0
			wait 500
			alertentity zombie4d
	}

	// Setup at bottom of stairs

	trigger action4a
	{
		globalaccum 5 random 2
		
		trigger player action4a_ps2
		trigger player action4a_xbox
	}

	trigger action4a_xbox
	{
		globalaccum 5 abort_if_not_equal 0
		
		alertentity nazi4a
		trigger nazi4a merc
		alertentity nazi4b
		trigger nazi4b merc
		alertentity nazi4c
		trigger nazi4c merc
		
		trigger player action4a_end
	}

	trigger action4a_ps2
	{
		globalaccum 5 abort_if_not_equal 1
	
		alertentity nazi4a_ps2
		trigger nazi4a_ps2 soldier
		alertentity nazi4b_ps2
		trigger nazi4b_ps2 soldier
		alertentity nazi4c_ps2
		trigger nazi4c_ps2 soldier
		
		trigger player action4a_end
	}

	trigger action4a_end
	{
		alertentity zombie4a
		alertentity zombie4b
		alertentity zombie4c

		alertentity effect_rumble2
		alertentity global_effect2
		wait 15
		trigger zombie4a go
		
		trigger player action4a_end_xbox
		trigger player action4a_end_ps2
	}

	trigger action4a_end_xbox
	{
		globalaccum 5 abort_if_not_equal 0
		
		trigger nazi4a go
	}

	trigger action4a_end_ps2
	{
		globalaccum 5 abort_if_not_equal 1
		
		trigger nazi4a_ps2 go
	}

	// Nazis attack the player
	trigger action4b
	{
		#if g_reinforce >= 2 alertentity reinforce_bg4 #endif
		
		trigger zombie4b go
		trigger zombie4c go
		trigger zombie4a can_hurt
		
		trigger player action4b_xbox
		trigger player action4b_ps2
	}
	
	trigger action4b_xbox
	{
		globalaccum 5 abort_if_not_equal 0
		
		trigger nazi4a cover
		trigger nazi4b go
		trigger nazi4c go
	}
	
	trigger action4b_ps2
	{
		globalaccum 5 abort_if_not_equal 1
		
		trigger nazi4a_ps2 cover
		trigger nazi4b_ps2 go
		trigger nazi4c_ps2 go
	}

	trigger action4c
	{
		trigger zombie4b can_hurt
		trigger zombie4c can_hurt

		trigger player action4c_xbox
		trigger player action4c_ps2
	}

	trigger action4c_xbox
	{
		globalaccum 5 abort_if_not_equal 0

		trigger nazi4b can_hurt
		trigger nazi4c can_hurt
	}

	trigger action4c_ps2
	{
		globalaccum 5 abort_if_not_equal 1

		trigger nazi4b_ps2 can_hurt
		trigger nazi4c_ps2 can_hurt
	}

	trigger action4d
	{
	//	alertentity zombie4d
	
		#if g_reinforce >= 2 alertentity reinforce_leet4 #endif
	}

// Start of Next Room

	// Start eating zombie
	trigger action4e_setup
	{
		trigger zombie4eat start
		alertentity z4_eatsound
//		alertentity effect_rumble2
	}

	// Zombie that is feasting wants a peice of YOU
	trigger action4e
	{
		trigger zombie4eat go
	}

/////////////////////////////////////////////
// SECTION 5 - Upper Level Connections
/////////////////////////////////////////////


	trigger spike2_trap2
	{
		trigger spike2_1n go
		
		trigger game_manager achievement1_fail // Reach the last room without having triggered any of the traps across the level in the Tombs
	}

	trigger spike2_trap
	{
		trigger spike2_1s go
		
		trigger game_manager achievement1_fail // Reach the last room without having triggered any of the traps across the level in the Tombs
	}

	trigger action5b
	{
		alertentity zombie5a
		trigger zombie5a go
	}

	trigger action5_setup
	{
		#if g_reinforce >= 2 alertentity reinforce_bg5 #endif
		
		alertentity nazi5a
		trigger nazi5a go

		mu_queue sound/music/c_chant
	}

	trigger action5_secret
	{
		alertentity zombie5b
	}
	trigger action5c
	{
		#if g_reinforce >= 2 alertentity reinforce_bg6 #endif
		
		alertentity nazi6a
		alertentity nazi6b
		wait 5
		trigger nazi6a go
		trigger nazi6b go

		mu_queue sound/music/c_chant
	}

/////////////////////////////////////////////
// SECTION 6 - Big Sqaure Room
/////////////////////////////////////////////

	trigger action6a
	{
		#if g_reinforce >= 2 alertentity reinforce_zombie1 #endif
		
		//playsound ee6_rumble3
		trigger stoned nrv_shake3
		alertentity zombie6a
		alertentity zombie6b
		alertentity zombie6c
		alertentity zombie6d
		alertentity zombie6e

		wait 100
		trigger stoned close
		
		trigger game_manager achievement1 // Reach the last room without having triggered any of the traps across the level in the Tombs
	}

	trigger event_killzombie
	{
		// add one more zombie to kill check
		globalaccum 4 inc 1
		globalaccum 4 abort_if_not_equal 5
		globalaccum 4 set 0

		trigger player zombie6f_go
	}

	trigger action6b
	{
		alertentity speak6

	}

	trigger action6c
	{
		globalaccum 4 set 4
		trigger player event_killzombie
	}
	trigger zombie6f_go
	{
		alertentity zombie6f
		wait 5
		alertentity zombie6g
		wait 5
		alertentity elite1

		alertentity blow_exit

		trigger zombie6f go
		wait 5
		trigger zombie6g go
		wait 5
		trigger elite1 go

		trigger stoned open
	}

/////////////////////////////////////////////
// Doors and Movers
/////////////////////////////////////////////


	// Primary Gate
	trigger port1_toggle
	{
		trigger player obj1
		wait 5
		trigger portcullis1 toggle
	}

	// Dungeon Passage Gate
	trigger port2_toggle
	{
		trigger portcullis2 toggle
	}

// SECTION End Map - Gate Hall

	trigger endmap
	{
		trigger game_manager checkexit // COOP: game_manager (ee6.coop.script) checks objectives 1 and 2 (SP: "globalaccum 2 abort_if_not_equal 2")
	}

	trigger exitlevel
	{
		globalaccum 2 set 0
		
		// COOP-OFF (SP achievement): globalaccum 1 inc 1
		
		// COOP-OFF (SP achievement): if g_gameskill >= 3 globalaccum 2 inc 1 endif
		
		#if g_ee_progress == 5 cvar g_ee_progress 6 #endif
		
		cvar g_level_was_selected 0
		
		changelevel ee7 persistent
	}
}


