		attack_crouch 0.2	// Default: 0.4 Range: 0.0 ? 1.0 (frequency)
		idle_crouch 0.0		// Default: 0.0 Range: 0.0 ? 1.0 (frequency)
		aggression 0.4		// Default: 0.5 Range: 0.0 ? 1.0 (charging)
		tactical 0.8		// Default: 0.8 Range: 0.0 ? 1.0 (protection)
		camper 0.0		// Default: 0.0 Range: 0.0 ? 1.0 (camping abilities)

		alertness 12000		// Default: 16000 Range: 0 ? 999999
		starting_health 25	// Default: 100 Range: 0 ? 99999 (spawn health)
		hearing_scale 0.2	// Default: 1.0 Range: 0.0 ? 10 (hearing)

		inner_detection_radius 256 // Default: 512 (detection of things units)
	}

	spawn
	{
		accum 0 set 0 // gone
		accum 1 set 0 // talked

		takeweapon all

		setammo ammo_9mm 999
		setammo ammo_grenades 0
		giveweapon weapon_luger
		selectweapon weapon_luger

		statetype alert
	}

	trigger talk
	{
		accum 1 abort_if_not_equal 0
		accum 1 set 1

		playsound nazi_ee6_1a
		wait 1500
		trigger nazi1a talk
	}

	trigger go
	{
		accum 0 abort_if_not_equal 0
		accum 0 set 1
		runtomarker nazi1b_spot1 nostop
		runtomarker nazi1b_spot2
		wait 500
		playsound MiscHalt
	}

	enemysight
	{
		resetscript
		attack player
	}

	inspectfriendlycombatstart
	{
		deny
	}

	bulletimpact
	{
		deny
	}

	inspectsoundstart
	{
		deny
	}

	inspectsoundend
	{
		deny
	}

	inspectbodystart
	{
		deny
	}

	inspectbodyend
	{
		deny
	}

	// This will be called when BJ kills me by stabbing me in the back with a knife!
	stealthkill
	{
		dropitem item_health_small
		
		trigger player stealth_achievement
	}

	death
	{
		accum 0 set 1
		resetscript
	}
}

