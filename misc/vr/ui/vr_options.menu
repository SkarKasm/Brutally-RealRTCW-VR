// RealRTCW-VR options, opened from the main menu ("VR OPTIONS").
// Packed into main/z_vr_assets.pk3 by misc/vr/make_vr_assets.py.
//
// Two columns, a row every 20 units; there is room under both columns for more settings.

#include "ui/menudef.h"

{
	menuDef {
		name "vr_options"
		rect 0 0 640 480
		fullScreen MENU_TRUE
		visible MENU_FALSE
		focusColor 1 .75 0 1
		style WINDOW_STYLE_FILLED
		backcolor 0 0 0 .85

		onOpen { setitemcolor vr_options_back forecolor 1 1 1 1 }
		onESC { close vr_options; open main }

		// ------------------------------------------------------------------ titles

		itemDef {
			name vr_title
			text "VR OPTIONS"
			rect 0 28 640 30
			textalign ITEM_ALIGN_CENTER
			textalignx 320
			textaligny 24
			textscale .4
			textfont UI_FONT_BIG
			forecolor 1 .85 .5 1
			visible 1
			decoration
		}

		itemDef {
			name vr_weapons_title
			text "WEAPONS"
			rect 20 78 290 16
			textalign ITEM_ALIGN_LEFT
			textalignx 4
			textaligny 13
			textscale .27
			textfont UI_FONT_BIG
			forecolor 1 .75 0 1
			visible 1
			decoration
		}

		itemDef {
			name vr_comfort_title
			text "MOVEMENT & COMFORT"
			rect 330 78 290 16
			textalign ITEM_ALIGN_LEFT
			textalignx 4
			textaligny 13
			textscale .27
			textfont UI_FONT_BIG
			forecolor 1 .75 0 1
			visible 1
			decoration
		}

		// ------------------------------------------------------------------ weapons

		itemDef {
			name vr_opt
			type ITEM_TYPE_MULTI
			text "Manual reloading:"
			cvar "vr_manualReload"
			cvarFloatList { "No" 0 "Yes" 1 }
			rect 20 104 290 14
			textalign ITEM_ALIGN_RIGHT
			textalignx 150
			textaligny 11
			textscale .22
			textfont UI_FONT_BIG
			style WINDOW_STYLE_FILLED
			backcolor 1 1 1 .07
			forecolor 1 1 1 1
			visible 1
		}

		itemDef {
			name vr_opt
			type ITEM_TYPE_MULTI
			text "Switch weapon when empty:"
			cvar "vr_emptySwitch"
			cvarFloatList { "No" 0 "Yes" 1 }
			rect 20 124 290 14
			textalign ITEM_ALIGN_RIGHT
			textalignx 150
			textaligny 11
			textscale .22
			textfont UI_FONT_BIG
			style WINDOW_STYLE_FILLED
			backcolor 1 1 1 .07
			forecolor 1 1 1 1
			visible 1
		}

		itemDef {
			name vr_opt
			type ITEM_TYPE_MULTI
			text "Shooting accuracy:"
			cvar "vr_aimSpread"
			cvarFloatList { "Precise" 0.125 "Steady" 0.25 "Realistic" 0.5 "Flat game" 1 }
			rect 20 144 290 14
			textalign ITEM_ALIGN_RIGHT
			textalignx 150
			textaligny 11
			textscale .22
			textfont UI_FONT_BIG
			style WINDOW_STYLE_FILLED
			backcolor 1 1 1 .07
			forecolor 1 1 1 1
			visible 1
		}

		itemDef {
			name vr_opt
			type ITEM_TYPE_MULTI
